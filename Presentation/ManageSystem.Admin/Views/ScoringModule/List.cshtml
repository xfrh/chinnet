@section FooterSection{
    <script src="~/Content/Scripts/admin.listpage.js"></script>
    <script src="~/Content/Scripts/layui-v2.5.4/layui.js"></script>

    <script id="DateTimeRangeTemplate" type="text/x-kendo-template">
        <span>起：#=DateTimeRange.Begin#</span>
        <br />
        <span>止：#=DateTimeRange.End#</span>
    </script>

    <script id="OperationTemplate" type="text/x-kendo-template">
        @if (IsEdit)
        {
            <a href="@Url.Action("Edit")/#=Id#">编辑</a>
            <i>&ensp;</i>
        }

        @if (IsView)
        {
            <a href="@Url.Action("Detail")/#=Id#">查看</a>
            <i>&ensp;</i>
        }
        # if (Status === '待开始') { #
        <a href="javascript: void(0);" data-val="#=Id#" onclick="onChangeStatus('#=Id#', @((int)DataQuality_Score_Status.Underway)); return false;">开始</a>
        # } else if (Status === '进行中') { #
        <a href="javascript: void(0);" data-val="#=Id#" onclick="onChangeStatus('#=Id#', @((int)DataQuality_Score_Status.Finish)); return false;">结束</a>
        # } #
        #if(Status === '进行中'||Status === '待开始'){#
        <i>&ensp;</i>
        <a href="javascript: void(0);" data-val="#=Id#" onclick="SetMessage('#=Id#'); return false;">发送通知</a>
        <input id="email_preview_title_#=Id#" type="hidden" hidden="hidden" value="#=Title#" />
        #}#

    </script>


    <script>
        layui.use('layer');

        $(document).ready(function () {

            $("#data-grid").kendoGrid({
                dataSource: {
                    type: "json",
                    transport: {
                        read: {
                            url: "/ScoringModule/List",
                            type: "POST",
                            dataType: "json",
                            data: additionalData
                        }
                    },
                    schema: {
                        data: "Data",
                        total: "Total",
                        errors: "Errors"
                    },
                    error: function (e) {
                        display_kendoui_grid_error(e);
                        // Cancel the changes
                        this.cancelChanges();
                    },
                    pageSize: 10,
                    serverPaging: true,
                    serverFiltering: true,
                    serverSorting: true

                },
                pageable: {
                    refresh: true,
                    pageSizes: [10, 30, 50]
                },
                scrollable: false,
                groupable: true,
                dataBound: onDataBound,
                columns: [
                    {
                        field: "Id",
                        headerTemplate: "  <div class='' style='text-align: center;'>    <label><input type='checkbox' id='mastercheckbox' /><span class='text'></span> </label>   </div>",
                        headerAttributes: { style: "text-align:center" },
                        attributes: { style: "text-align:center" },
                        template: " <div class='' style='text-align: center;'>    <label><input type='checkbox' class='checkboxGroups'  value='#=Id#' /><span class='text'></span> </label>   </div> ",
                        width: 50
                    },
                    {
                        field: "InsertTime",
                        title: "添加时间",
                        width: 120
                    },
                    {
                        field: "Title",
                        title: "评比名称",
                        width: 180
                    },
                    {
                        field: "Status",
                        title: "状态",
                        width: 80
                    },

                    {
                        field: "DateTimeRange",
                        title: "评分时间",
                        width: 150,
                        template: kendo.template(document.getElementById('DateTimeRangeTemplate').innerHTML)
                    },
                    {
                        field: "HospitalTotal",
                        title: "参与医院总数",
                        width: 80
                    },
                    {
                        field: "Intro",
                        title: "说明",
                        width: 180
                    },
                    {
                        field: "Id",
                        title: "操作",
                        width: 150,
                        template: kendo.template(document.getElementById('OperationTemplate').innerHTML)
                    }
                ]
            });

            $('#data-grid').off('click', 'table input[class="checkboxGroups"][type="checkbox"]');
            $('#data-grid').off('click', 'table input[id="mastercheckbox"][type="checkbox"]');

            $('#data-grid').on('click', 'table input[class="checkboxGroups"][type="checkbox"]', function () {
                setTimeout(function () {
                    var checkeds = $('#data-grid').find('input[class="checkboxGroups"][type="checkbox"]:checked'),
                        totalLength = $('#data-grid').find('input[class="checkboxGroups"][type="checkbox"]').length;

                    if (totalLength > 0 && totalLength === checkeds.length) {
                        $('#data-grid').find('input[id="mastercheckbox"][type="checkbox"]').prop('checked', true);
                    }
                    else {
                        $('#data-grid').find('input[id="mastercheckbox"][type="checkbox"]').prop('checked', false);
                    }
                }, 50);
            });

            $('#data-grid').on('click', 'table input[id="mastercheckbox"][type="checkbox"]', function () {
                var $this = $(this);
                setTimeout(function () {
                    if ($this.prop('checked')) {
                        $('#data-grid').find('input[class="checkboxGroups"][type="checkbox"]').prop('checked', true);
                    }
                    else {
                        $('#data-grid').find('input[class="checkboxGroups"][type="checkbox"]').prop('checked', false);
                    }
                }, 50);
            });

            $('#btn-delete').off('click');
            $('#btn-delete').on('click', function (e) {
                var checkedItems = $('#data-grid').find('input[class="checkboxGroups"][type="checkbox"]:checked');
                if (checkedItems === null || checkedItems.length <= 0) {
                    alert("请勾选需要删除的数据！");
                    return false;
                }

                if (confirm("不可恢复操作，确认删除吗？")) {
                    e.preventDefault();
                    selectedIds = [];
                    $('#data-grid').find('input[class="checkboxGroups"][type="checkbox"]:checked').each(function (i, item) {
                        selectedIds.push(item.value);
                    });

                    var ids = selectedIds.join(",");
                    $('#delete-selected-form #selectedIds').val(ids);
                    $('#delete-selected-form').submit();
                    return false;
                }
            });

        });


        //设置查询参数
        function additionalData() {
            var data = {
                title: $("#searchTitle").val(),
                status: $("#DropSatus").val(),
                intro: $("#searchIntro").val()
            };
            if (!data.status || data.status === 'null' || data.status === null, typeof (data.status) === 'undefined') {
                data.status = null;
            }

            addAntiForgeryToken(data);
            return data;
        }

        function onChangeStatus(id, status) {
            if (id && status) {
                var statusText = '';
                switch (status) {
                    case 2:
                        statusText = '开始';
                        break;
                    case 5:
                        statusText = '结束';
                        break;
                    default:
                        return false;
                }
                layui.use('layer', function () {
                    layer.confirm('评比信息状态变更为：【<span style="color: #e2293c; font-weight: 600;">' + statusText + '</span>】？', {
                        btn: ['确定', '取消'] //按钮
                    }, function () {
                        $('#changedataqualityscorestatus-form #ChangeDataQualityScoreStatus_Id').val(id);
                        $('#changedataqualityscorestatus-form #ChangeDataQualityScoreStatus_Status').val(status);
                        $('#changedataqualityscorestatus-form').submit();
                        return false;
                    });
                });
            }
        }

        function SetMessage(id) {
            if (id) {
                var $modal = $('#modal_email_notify');
                if ($('#email_preview_title_' + id).val()) {
                    $modal.find('#email_notify_preview_title').text($('#email_preview_title_' + id).val() + '活动通知');
                }
                else {
                    $modal.find('#email_notify_preview_title').text('活动通知');
                }
                $modal.find('#modal_email_notify_hidden_id').val(id);
                $modal.modal('show');
            }
            return false;
        }

        function onSubmitEmailNotify() {
            var $modal = $('#modal_email_notify');
            $modal.modal('hide');
            var layer_loading;
            $.ajax({
                url: '/ScoringModule/SetMessage',
                data: { Id: $modal.find('#modal_email_notify_hidden_id').val() },
                type: 'post',
                dataType: 'Json',
                beforeSend: function () {
                    layer_loading = layui.layer.msg('发送中', { icon: 16, time: 0, shade: 0.01 });
                },
                complete: function () {
                    layui.layer.close(layer_loading);
                },
                success: function (res) {
                    if (res == "" || res == null) return;
                    if (res.status == "true") {
                        layui.layer.alert(res.message);
                    } else {
                        layui.layer.alert(res.message);
                    };
                },
                error: function (res) {
                    layui.layer.alert('邮件发送失败');
                    console.info(res);
                }
            })
        }
    </script>
}





