
@{
    ViewBag.Title = "重评申请管理";
}

@section HeadSection {
}

@section Breadcrumb{
    @{Html.RenderAction("Breadcrumb", "Shared", new Breadcrumb { MenuName = "评比管理", SecondName = "评比管理", LocationName = this.ViewBag.Title }); }
}

<div class="page-body">

    <div class="row manage-page">
        <div class="col-xs-12 col-md-12">
            <div class="widget">
                <div class="widget-header bordered-bottom bordered-yellow manage-title-box">
                    <span class="widget-caption manage-title"><i class="glyphicon glyphicon-th "></i>@ViewBag.Title </span>
                    <div class="widget-buttons">
                        <a href="#" data-toggle="maximize"><i class="fa fa-expand"></i></a>
                        <a href="#" data-toggle="collapse"><i class="fa fa-minus"></i></a>
                    </div>
                </div>

                <div class="widget-body">
                    <div role="grid" id="searchable_wrapper" class="dataTables_wrapper form-inline">

                        <div id="searchable_filter" class="dataTables_filter manage-but-box">
                            <div style="width: 100%;">
                                @Html.ButtonHtml(HtmlButtonType.Delete, "ReevaluationDelete", "ScoringModule")
                            </div>
                            <div style="width: 100%;">
                                <div class="dataTables_filter manage-but-box">
                                    <label class="lb-left" style="margin-left: 0;">评比名称：</label>
                                    <label class="lb-right">
                                        <input type="text" id="searchTitle" class="form-control input-sm  search" aria-controls="searchable" name="searchTitle" />
                                    </label>
                                    <label class="lb-left">状态：</label>
                                    <div class="form-control ddl lb-right " style="width: 10%;">
                                        @Html.DropDownList("DropSatus", (IEnumerable<SelectListItem>)ViewData["DropSatusEnum"], new { @class = "form-control dropdown" })
                                    </div>
                                    <label class="lb-left">评委姓名：</label>
                                    <label class="lb-right">
                                        <input type="text" id="searchJury" class="form-control input-sm  search" aria-controls="searchable" name="searchJury" />
                                    </label>
                                </div>
                                <div class="dataTables_filter manage-but-box">
                                    <label class="lb-left" style="margin-left: 0;">评价医院：</label>
                                    <label class="lb-right">
                                        <input type="text" id="searchHospital" class="form-control input-sm  search" aria-controls="searchable" name="searchHospital" />
                                    </label>
                                    <label><input type="button" id="btn-search" class="btn btn-blue" value="查 询" /> </label>
                                </div>
                            </div>
                        </div>
                        <div class="table table-striped table-bordered dataTable no-footer table-select" id="ManageTableDiv" aria-describedby="editabledatatable_info">
                            <div id="data-grid"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@*删除数据的表单*@
@using (Html.BeginForm("ReevaluationDelete", "ScoringModule", FormMethod.Post, new { id = "delete-selected-form" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" id="selectedIds" name="selectedIds" value="" />
}

@*删除数据的表单*@
@using (Html.BeginForm("OnChangeReevaluationStatus", "ScoringModule", FormMethod.Post, new { id = "changereevaluationstatus-form" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" id="ChangeDataQualityScoreStatus_Id" name="id" value="" />
    <input type="hidden" id="ChangeDataQualityScoreStatus_Status" name="status" value="" />
    <input type="hidden" id="ChangeDataQualityScoreStatus_Remark" name="remark" value="" />

}

@section FooterSection{
    <script src="~/Content/Scripts/admin.listpage.js"></script>
    <script src="~/Content/Scripts/layui-v2.5.4/layui.js"></script>

    <script id="OperationTemplate" type="text/x-kendo-template">
        <a href="@Url.Action("ReevaluationDetail")/#=Id#">查看</a>
        <i>&ensp;</i>
        # if (More.ShowAgree) { #
        <a href="javascript: void(0);" data-val="#=Id#" onclick="onChangeStatus('#=Id#', 2); return false;">同意</a>
        <i>&ensp;</i>
        # } #

        # if (More.ShowCancel) { #
        <a href="javascript: void(0);" data-val="#=Id#" onclick="onChangeStatus('#=Id#', 3); return false;">取消</a>
        # } #
    </script>

    <script>
        $(document).ready(function () {

            $("#data-grid").kendoGrid({
                dataSource: {
                    type: "json",
                    transport: {
                        read: {
                            url: "/ScoringModule/Reevaluation",
                            type: "POST",
                            dataType: "json",
                            data: function () {
                                var data = {
                                    title: $("#searchTitle").val(),
                                    status: $("#DropSatus").val(),
                                    juryName: $("#searchJury").val(),
                                    hospital: $("#searchHospital").val()
                                };

                                if (!data.status || data.status === 'null' || data.status === null, typeof (data.status) === 'undefined') {
                                    data.status = null;
                                }

                                addAntiForgeryToken(data);
                                return data;
                            }
                        }
                    },
                    schema: {
                        data: "Data",
                        total: "Total",
                        errors: "Errors"
                    },
                    error: function (e) {
                        display_kendoui_grid_error(e);
                        // Cancel the changes
                        this.cancelChanges();
                    },
                    pageSize: 10,
                    serverPaging: true,
                    serverFiltering: true,
                    serverSorting: true

                },
                pageable: {
                    refresh: true,
                    pageSizes: [10, 30, 50]
                },
                scrollable: false,
                groupable: true,
                dataBound: onDataBound,
                columns: [
                    {
                        field: "Id",
                        headerTemplate: "  <div class='' style='text-align: center;'>    <label><input type='checkbox' id='mastercheckbox' /><span class='text'></span> </label>   </div>",
                        headerAttributes: { style: "text-align:center" },
                        attributes: { style: "text-align:center" },
                        template: " <div class='' style='text-align: center;'>    <label><input type='checkbox' class='checkboxGroups'  value='#=Id#' /><span class='text'></span> </label>   </div> ",
                        width: 50
                    },
                    {
                        field: "InsertTime",
                        title: "添加时间",
                        width: 150
                    },
                    {
                        field: "Title",
                        title: "评比名称",
                        width: 180
                    },
                    {
                        field: "Status",
                        title: "状态",
                        width: 80
                    },
                    {
                        field: "JuryName",
                        title: "评委姓名",
                        width: 80,
                    },
                    {
                        field: "HospitalName",
                        title: "评价医院",
                        width: 180
                    },
                    {
                        field: "EvaluateScore",
                        title: "评分",
                        width: 80
                    },
                    {
                        field: "Reason",
                        title: "申请理由",
                        width: 200
                    },
                    {
                        field: "Handler",
                        title: "处理人",
                        width: 80
                    },
                    {
                        field: "More",
                        title: "操作",
                        width: 150,
                        template: kendo.template(document.getElementById('OperationTemplate').innerHTML)
                    }
                ]
            });

            $('#data-grid').off('click', 'table input[class="checkboxGroups"][type="checkbox"]');
            $('#data-grid').off('click', 'table input[id="mastercheckbox"][type="checkbox"]');

            $('#data-grid').on('click', 'table input[class="checkboxGroups"][type="checkbox"]', function () {
                setTimeout(function () {
                    var checkeds = $('#data-grid').find('input[class="checkboxGroups"][type="checkbox"]:checked'),
                        totalLength = $('#data-grid').find('input[class="checkboxGroups"][type="checkbox"]').length;

                    if (totalLength > 0 && totalLength === checkeds.length) {
                        $('#data-grid').find('input[id="mastercheckbox"][type="checkbox"]').prop('checked', true);
                    }
                    else {
                        $('#data-grid').find('input[id="mastercheckbox"][type="checkbox"]').prop('checked', false);
                    }
                }, 50);
            });

            $('#data-grid').on('click', 'table input[id="mastercheckbox"][type="checkbox"]', function () {
                var $this = $(this);
                setTimeout(function () {
                    if ($this.prop('checked')) {
                        $('#data-grid').find('input[class="checkboxGroups"][type="checkbox"]').prop('checked', true);
                    }
                    else {
                        $('#data-grid').find('input[class="checkboxGroups"][type="checkbox"]').prop('checked', false);
                    }
                }, 50);
            });

            $('#btn-delete').off('click');
            $('#btn-delete').on('click', function (e) {
                var checkedItems = $('#data-grid').find('input[class="checkboxGroups"][type="checkbox"]:checked');
                if (checkedItems === null || checkedItems.length <= 0) {
                    alert("请勾选需要删除的数据！");
                    return false;
                }

                if (confirm("不可恢复操作，确认删除吗？")) {
                    e.preventDefault();
                    selectedIds = [];
                    $('#data-grid').find('input[class="checkboxGroups"][type="checkbox"]:checked').each(function (i, item) {
                        selectedIds.push(item.value);
                    });

                    var ids = selectedIds.join(",");
                    $('#delete-selected-form #selectedIds').val(ids);
                    $('#delete-selected-form').submit();
                    return false;
                }
            });
        });


        //设置查询参数
        function additionalData() {
            var data = {
                title: $("#searchTitle").val(),
                status: $("#DropSatus").val(),
                intro: $("#searchIntro").val()
            };
            if (!data.status || data.status === 'null' || data.status === null, typeof (data.status) === 'undefined') {
                data.status = null;
            }

            addAntiForgeryToken(data);
            return data;
        }

        function onChangeStatus(id, status) {
            if (id && status) {
                var statusText = '';
                switch (status) {
                    case 2:
                        statusText = '同意';
                        break;
                    case 3:
                        statusText = '取消';
                        break;
                    default:
                        return false;
                }
                layui.use('layer', function () {
                    layer.confirm('将申请状态变更为：【<span style="color: #e2293c; font-weight: 600;">' + statusText + '</span>】？<hr style="margin: 10px 0 8px;" />请输入审核说明:<br /><textarea id="remark' + id + '" style="width: 100%; resize: none; padding: 4px 6px 5px 6px; min-height: 98px; margin-top: 10px;"></textarea>', {
                        title: '审核',
                        area: '500px',
                        btn: ['确定', '取消'] //按钮
                    }, function () {
                        $('#changereevaluationstatus-form #ChangeDataQualityScoreStatus_Id').val(id);
                        $('#changereevaluationstatus-form #ChangeDataQualityScoreStatus_Status').val(status);
                        $('#changereevaluationstatus-form #ChangeDataQualityScoreStatus_Remark').val($('#remark' + id).val());
                        $('#changereevaluationstatus-form').submit();
                        return false;
                    });
                });
            }
        }
    </script>
}

