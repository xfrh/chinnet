@using ManageSystem.Services.Common;

@{
    ViewBag.Title = "下载记录";
}

@section HeadSection {
}

@section Breadcrumb{
    @{Html.RenderAction("Breadcrumb", "Shared", new Breadcrumb { MenuName = "资料管理", SecondName = "资料列表", LocationName = this.ViewBag.Title }); }
}


@Html.AntiForgeryToken()

@Html.Hidden("HiddenDocumentId", Request["documentId"])

<div class="page-body">

    <div class="row manage-page">
        <div class="col-xs-12 col-md-12">
            <div class="widget">
                <div class="widget-header bordered-bottom bordered-yellow manage-title-box">
                    <span class="widget-caption manage-title"><i class="glyphicon glyphicon-th "></i>@ViewBag.Title </span>
                    <div class="widget-buttons">
                        <a href="#" data-toggle="maximize"><i class="fa fa-expand"></i></a>
                        <a href="#" data-toggle="collapse"><i class="fa fa-minus"></i></a>
                    </div>
                </div>

                <div class="widget-body">
                    <div role="grid" id="searchable_wrapper" class="dataTables_wrapper form-inline">

                        <div id="searchable_filter" class="dataTables_filter manage-but-box">
                            <div style="width: 100%;">
                                @Html.ActionLink("返回", "List", null, new { @class = "btn btn-info" })
                            </div>
                            <div style="width: 100%;">
                                <div class="dataTables_filter manage-but-box">
                                    <label class="lb-left">
                                        <img alt="用户名称" src="/Content/images/ico-help.gif" title="用户名称">
                                        <label for="Title" title="用户名称">用户名称：</label>
                                    </label>
                                    <label class="lb-right">
                                        <input type="text" id="input-search" class="form-control input-sm  search" aria-controls="searchable" name="searchKey" />
                                    </label>
                                    @*<label class="lb-left">
                                        <img alt="下载日期" src="/Content/images/ico-help.gif" title="下载日期">
                                        <label for="Title" title="下载日期">下载日期：</label>
                                    </label>
                                    <label class="lb-right">
                                        <input type="text" id="input-datetime" class="form-control input-sm  search" aria-controls="searchable" name="searchDateTime" />
                                    </label>*@
                                    <label> <input type="button" id="btn-search" class="btn btn-blue" value="查 询" /> </label>
                                </div>
                            </div>
                        </div>
                        <div class="table table-striped table-bordered dataTable no-footer table-select" id="ManageTableDiv" aria-describedby="editabledatatable_info">
                            <div id="data-grid"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



@*删除数据的表单*@
@using (Html.BeginForm("Delete", "Document", FormMethod.Post, new { id = "delete-selected-form" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" id="ids" name="ids" value="" />
}

@Html.Hidden("DataUrl", Html.Raw(Url.Action("DocumentDownloadList")))

<script>
    $(document).ready(function () {
        $("#data-grid").kendoGrid({
            dataSource: {
                type: "json",
                transport: {
                    read: {
                        url: document.getElementById('DataUrl').value,
                        type: "POST",
                        dataType: "json",
                        data: additionalData
                    }
                },
                schema: {
                    data: "Data",
                    total: "Total",
                    errors: "Errors"
                },
                error: function (e) {
                    display_kendoui_grid_error(e);
                    // Cancel the changes
                    this.cancelChanges();
                },
                pageSize: 10,
                serverPaging: true,
                serverFiltering: true,
                serverSorting: true

            },
            pageable: {
                refresh: true,
                pageSizes: [10, 30, 50]
            },
            scrollable: false,
            groupable: true,
            dataBound: onDataBound,
            columns: [
                {
                    field: "Id",
                    headerTemplate: "  <div class='' style='text-align: center;'>    <label><input type='checkbox' id='mastercheckbox' /><span class='text'></span> </label>   </div>",
                    headerAttributes: { style: "text-align:center" },
                    attributes: { style: "text-align:center" },
                    template: " <div class='' style='text-align: center;'>    <label><input type='checkbox' class='checkboxGroups'  value='#=Id#' /><span class='text'></span> </label>   </div> ",
                    width: 50
                },
                {
                    field: "Id",
                    title: "记录编号",
                    width: 180
                },
                {
                    field: "DocumentName",
                    title: "资料标题",
                },
                {
                    field: "Member",
                    title: "下载者",
                    template: '#=Member.Name#',
                    //template: '#=Member.Name#<br />#=Member.Mobile#',
                    width: 150
                },
                {
                    field: "DownloadDateTime",
                    title: "下载时间",
                    headerAttributes: { style: "text-align:center" },
                    attributes: { style: "text-align:center" },
                    template: '#=DownloadDateTime.Date#<br />#=DownloadDateTime.Time#',
                    width: 120
                },
                {
                    field: "Describe",
                    title: "备注",
                    width: 180
                }
            ]
        });
    });


    //设置查询参数
    function additionalData() {
        var data = {
            documentId: document.getElementById('HiddenDocumentId').value,
            name: $("#input-search").val()
        };

        addAntiForgeryToken(data);
        return data;
    }

</script>

<script id="template" type="text/x-kendo-template">
    <a data-id="#=Id#">编辑</a>
</script>

<script src="~/Content/Scripts/admin.listpage.js"></script>

