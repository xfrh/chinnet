@model  ManageSystem.Admin.Models.Document.DocumentModel

@using ManageSystem.Services.Common;

@{
    ViewBag.Title = "资料列表";
    bool IsEdit = UserinfoExtensions.CheckFunction(Url.Action("Edit"));
    bool IsView = UserinfoExtensions.CheckFunction(Url.Action("Detail"));
    //string istop=
    bool IsDownloadList = UserinfoExtensions.CheckFunction(Url.Action("DocumentDownloadList", "Document"));
    string downloadHtml = IsDownloadList ? "&nbsp;&nbsp;<a href='/Document/DocumentDownloadList?documentId=#=Id#'>下载记录</a>" : "";
    string downloadCountHtml = IsDownloadList ? "<a href='/Document/DocumentDownloadList?documentId=#=Count.Id#'>#=Count.Value#</a>" : "#=Count.Value#";
    string weCattop = "#=weCattop#";
}

@section HeadSection {
}

@section Breadcrumb{
    @{Html.RenderAction("Breadcrumb", "Shared", new Breadcrumb { MenuName = "资料管理", SecondName = "资料管理", LocationName = this.ViewBag.Title }); }
}


@Html.AntiForgeryToken()


<div class="page-body">

    <div class="row manage-page">
        <div class="col-xs-12 col-md-12">
            <div class="widget">
                <div class="widget-header bordered-bottom bordered-yellow manage-title-box">
                    <span class="widget-caption manage-title"><i class="glyphicon glyphicon-th "></i>@ViewBag.Title </span>
                    <div class="widget-buttons">
                        <a href="#" data-toggle="maximize"><i class="fa fa-expand"></i></a>
                        <a href="#" data-toggle="collapse"><i class="fa fa-minus"></i></a>
                    </div>
                </div>

                <div class="widget-body">
                    <div role="grid" id="searchable_wrapper" class="dataTables_wrapper form-inline">

                        <div id="searchable_filter" class="dataTables_filter manage-but-box">
                            <div style="width: 100%;">
                                @Html.ButtonHtml(HtmlButtonType.Add, "Create", "Document")
                                @Html.ButtonHtml(HtmlButtonType.Delete, "Delete", "Document")
                            </div>
                            <div style="width: 100%;">
                                <div class="dataTables_filter manage-but-box">
                                    <label class="lb-left">@Html.NopLabelFor(model => model.Title)：</label>
                                    <label class="lb-right"><input type="text" id="input-search" class="form-control input-sm  search" aria-controls="searchable" name="searchKey" /></label>
                                    <label> <input type="button" id="btn-search" class="btn btn-blue" value="查 询" /> </label>
                                </div>
                            </div>
                        </div>
                        <div class="table table-striped table-bordered dataTable no-footer table-select"  id="ManageTableDiv" aria-describedby="editabledatatable_info">
                            <div id="data-grid"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



@*删除数据的表单*@
@using (Html.BeginForm("Delete", "Document", FormMethod.Post, new { id = "delete-selected-form" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" id="selectedIds" name="selectedIds" value="" />
}

@Html.Hidden("DataUrl", Html.Raw(Url.Action("List")))

<script>
    $(document).ready(function () {
        $("#data-grid").kendoGrid({
            dataSource: {
                type: "json",
                transport: {
                    read: {
                        url: document.getElementById('DataUrl').value,
                        type: "POST",
                        dataType: "json",
                        data: additionalData
                    }
                },
                schema: {
                    data: "Data",
                    total: "Total",
                    errors: "Errors"
                },
                error: function (e) {
                    display_kendoui_grid_error(e);
                    // Cancel the changes
                    this.cancelChanges();
                },
                pageSize: 10,
                serverPaging: true,
                serverFiltering: true,
                serverSorting: true

            },
            pageable: {
                refresh: true,
                pageSizes: [10, 30, 50]
            },
            scrollable: false,
            groupable: true,
            dataBound: onDataBound,
            columns: [
                {
                    field: "Id",
                    headerTemplate: "  <div class='' style='text-align: center;'>    <label><input type='checkbox' id='mastercheckbox' /><span class='text'></span> </label>   </div>",
                    headerAttributes: { style: "text-align:center" },
                    attributes: { style: "text-align:center" },
                    template: " <div class='' style='text-align: center;'>    <label><input type='checkbox' class='checkboxGroups'  value='#=Id#' /><span class='text'></span> </label>   </div> ",
                    width: 50
                },
                //{
                //    field: "Id",
                //    title: "资料编号",
                //    width: 180
                //},
                {
                    field: "Name",
                    title: "资料标题",
                },
                {
                    field: "Status",
                    title: "是否启用",
                    headerAttributes: { style: "text-align:center" },
                    attributes: { style: "text-align:center" },
                    width: 80
                },

                {
                    field: "Count",
                    title: "下载量",
                    headerAttributes: { style: "text-align:center" },
                    headerAttributes: { style: "text-align:center" },
                    attributes: { style: "text-align:center" },
                    template: "@Html.Raw(downloadCountHtml)",
                    width: 100
                },
                {
                    field: "Sort",
                    title: "排序",
                    headerAttributes: { style: "text-align:center" },
                    attributes: { style: "text-align:center" },
                    width: 80
                },
                {
                    field: "Owners",
                    title: "显示位置",
                    headerAttributes: { style: "text-align:center" },
                    attributes: { style: "text-align:center" },
                    width: 150
                },
                {
                    field: "DateTime",
                    title: "发布时间",
                    headerAttributes: { style: "text-align:center" },
                    attributes: { style: "text-align:center" },
                    template: '#=DateTime.FullDateTime#',
                    width: 160
                },
                {
                    field: "weCattop",
                    title: "是否置顶",
                    headerAttributes: { style: "text-align:center" },
                    attributes: { style: "text-align:center" },
                    width: 90
                },
                {
                    field: "Id",
                    title: "操作",
                    width: 200,
                    template: "@Html.KendoUIEditAndView(IsView, "Detail", IsEdit, "Edit")@Html.Raw(downloadHtml)&nbsp;&nbsp;"+"#if(weCattop == 1){#"+"<a href='/Document/Cancelceiling?id=#=Id#'>取消置顶</a>#}else{#"+"&nbsp;&nbsp;<a href='/Document/WeChattop?id=#=Id#'>置顶</a>#}#"                   
                }                   
            ]
        });
    });

    //设置查询参数
    function additionalData() {
        var data = {
            Title: $("#input-search").val()
        };

        addAntiForgeryToken(data);
        return data;
    }

</script>

<script id="template" type="text/x-kendo-template">
    <a data-id="#=Id#">编辑</a>
</script>

<script src="~/Content/Scripts/admin.listpage.js"></script>

