    //设置查询参数
    function additionalData() {
        var data = {
            Name: $("#input-search").val(),
            MedicalOrganismTypeId: $("#MedicalOrganismTypeId").val(),
            MedicalOrganismId: $("#MedicalOrganismId").val()
        };

        addAntiForgeryToken(data);
        return data;
    }

    function ChartDelete(id) {
        var r = confirm("你确定要删除吗？");
        if (r) {
            $.ajax({
                url: "@Url.Action("ChartDelete")",
                type: "POST",
                dataType: "json",
                data: { selectedIds: id },
                success: function (json) {
                    if (json.Code == 1) {
                        alert("删除成功！");
                        $("#data-grid").data("kendoGrid").dataSource.read();
                    }
                 }
            });
        }


    }

