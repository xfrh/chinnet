@model  ManageSystem.Admin.Models.Organism.BacteriaModel
@using ManageSystem.Services.Common;

@{
    ViewBag.Title = "细菌信息列表";
    bool IsEdit = UserinfoExtensions.CheckFunction(Url.Action("ChartEdit"));
}

@section HeadSection {
}

@section Breadcrumb{
    @{Html.RenderAction("Breadcrumb", "Shared", new Breadcrumb { MenuName = "细菌分布图表", SecondName = "细菌详细列表", LocationName = this.ViewBag.Title }); }
}

@Html.AntiForgeryToken()


<div class="page-body">

    <div class="row manage-page">
        <div class="col-xs-12 col-md-12">
            <div class="widget">
                <div class="widget-header bordered-bottom bordered-yellow manage-title-box">
                    <span class="widget-caption manage-title"><i class="glyphicon glyphicon-th "></i>@ViewBag.Title </span>
                    <div class="widget-buttons">
                        <a href="#" data-toggle="maximize"><i class="fa fa-expand"></i></a>
                        <a href="#" data-toggle="collapse"><i class="fa fa-minus"></i></a>
                    </div>
                </div>

                <div class="widget-body">
                    <div role="grid" id="searchable_wrapper" class="dataTables_wrapper form-inline">

                        <div id="searchable_filter" class="dataTables_filter manage-but-box">
                            <div style="width: 100%;">
                                @Html.ButtonHtml(HtmlButtonType.Import, "ChartImport", "OrganismChart")

                                @Html.ButtonHtml(HtmlButtonType.Delete, "ChartDelete", "OrganismChart")
                            </div>
                            <div style="width: 100%;">
                                <div class="dataTables_filter manage-but-box">
                                    <label class="lb-left">@Html.NopLabelFor(m => m.Name)：</label>
                                    <label class="lb-right"><input type="text" id="input-search" class="form-control input-sm  search" aria-controls="searchable" name="searchKey" /></label>
                                    <label class="lb-left">@Html.NopLabelFor(m => m.MedicalOrganismTypeId)：</label>
                                    <div class="form-control ddl lb-right " style="width:250px">
                                        @Html.DropDownList("MedicalOrganismTypeId", Model.MedicalOrganismTypeList, new { @class = "form-control dropdown", style = "width:250px;" })
                                    </div>
                                    <label class="lb-left">@Html.NopLabelFor(m => m.MedicalOrganism)：</label>
                                    <div class="form-control ddl lb-right " style="width:350px">
                                        @Html.DropDownList("MedicalOrganismId", Model.MedicalOrganism, new { @class = "form-control dropdown", style = "width:350px;" })
                                    </div>
                                    <label> <input type="button" id="btn-search" class="btn btn-blue" value="查 询" /> </label>
                                </div>
                            </div>
                        </div>
                        <div class="table table-striped table-bordered dataTable no-footer table-select" id="ManageTableDiv" aria-describedby="editabledatatable_info">
                            <div id="data-grid"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

