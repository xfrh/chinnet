{
    @Html.AntiForgeryToken()
    <input type="hidden" id="selectedIds" name="selectedIds" value="" />
}*@

<script>
    $(document).ready(function () {

        $("#data-grid").kendoGrid({
            dataSource: {
                type: "json",
                transport: {
                    read: {
                        url: "@Html.Raw(Url.Action("ddGermList"))",
                        type: "POST",
                        dataType: "json",
                        data: additionalData
                    }
                },

                schema: {
                    data: "Data",
                    total: "Total",
                    errors: "Errors"
                },
                error: function (e) {
                    display_kendoui_grid_error(e);
                    // Cancel the changes
                    this.cancelChanges();
                },
                pageSize: 10,
                serverPaging: true,
                serverFiltering: true,
                serverSorting: true

            },
            pageable: {
                refresh: true,
                pageSizes: [10, 30, 50]
            },
            scrollable: false,
            groupable: true,
            dataBound: onDataBound,
            columns: [{
                field: "germ_id",
                headerTemplate: "  <div class='' style='text-align: center;'>    <label><input type='checkbox' id='mastercheckbox' /><span class='text'></span> </label>   </div>",
                headerAttributes: { style: "text-align:center" },
                attributes: { style: "text-align:center" },
                template: " <div class='' style='text-align: center;'>    <label><input type='checkbox' class='checkboxGroups'  value='#=germ_id#' /><span class='text'></span> </label>   </div> ",
                width: 50
            },
        {
          field: "title",
          title: "细菌名称",
          width: 150
        },
		{
		    field: "title_en",
		    title: "英文名称",
		    width: 150
		},
		{
		    field: "code",
		    title: "细菌代码",
		    width: 100
        },
        {
		    field: "sortid",
            title: "<div style='text-align: center;'>排序</div>",
            attributes: { style: "text-align:center" },
		    width: 100
		},
		{
		    field: "created",
            title: "<div style='text-align: center;'>添加时间<div>",
            attributes: { style: "text-align:center" },
		    width: 150
		},
		{
		    field: "username",
		    title: "添加人",
		    width: 100
		},
        {
                field: "antibiotic__id",
                title: "<div style='text-align: center;'>操作</div>",
                width: 70,
                template: "<div style='text-align: center;'><a href='/MicDistribution/CreateEdit/#=germ_id#'>编辑</a></div>"
        }]
        });
    });


    //设置查询参数
    function additionalData() {
        var data = {            
            title: $("#input-title").val(),
            code: $("#input-code").val(),
        };

        addAntiForgeryToken(data);
        return data;
    }  
    //function ReloadPage() {
    //    location.reload();
    //}
</script>

<script src="~/Content/Scripts/admin.listpage.js"></script>