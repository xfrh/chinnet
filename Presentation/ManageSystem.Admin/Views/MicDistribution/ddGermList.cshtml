@model  ManageSystem.Admin.Models.MicdataDistribution.ddGermModel

@{
    ViewBag.Title = "细菌管理";
    //bool IsEdit = UserinfoExtensions.CheckFunction(Url.Action("HospitalEdit"));
    //bool IsView = UserinfoExtensions.CheckFunction(Url.Action("HospitalView"));
}

@section HeadSection {
}

@section Breadcrumb{
    @{Html.RenderAction("Breadcrumb", "Shared", new Breadcrumb { MenuName = "MIC数据分布", SecondName = "细菌管理", LocationName = this.ViewBag.Title }); }
}


@Html.AntiForgeryToken()

<div class="page-body">

    <div class="row manage-page">
        <div class="col-xs-12 col-md-12">
            <div class="widget">
                <div class="widget-header bordered-bottom bordered-yellow manage-title-box">
                    <span class="widget-caption manage-title"><i class="glyphicon glyphicon-th "></i>@ViewBag.Title </span>
                    <div class="widget-buttons">
                        <a href="#" data-toggle="maximize"><i class="fa fa-expand"></i></a>
                        <a href="#" data-toggle="collapse"><i class="fa fa-minus"></i></a>
                    </div>
                </div>

                <div class="widget-body">
                    <div role="grid" id="searchable_wrapper" class="dataTables_wrapper form-inline">

                        <div id="searchable_filter" class="dataTables_filter manage-but-box">
                            <div style="width: 100%;">
                                @Html.ButtonHtml(HtmlButtonType.Add, "GermCreate", "MicDistribution")
                                @Html.ButtonHtml(HtmlButtonType.Delete, "HospitalDelete", "MicDistribution")
                            </div>
                            <div style="width: 100%;">
                                <div class="dataTables_filter manage-but-box">
                                    <label class="lb-left">@Html.NopLabelFor(model => model.title)：</label>
                                    <label class="lb-right"><input type="text" id="input-title" class="form-control input-sm  search" style="width:100%;" /></label>
                                    <label class="lb-left">@Html.NopLabelFor(model => model.code)：</label>
                                    <label class="lb-right"><input type="text" id="input-code" class="form-control input-sm  search" style="width:100%;" /></label>
                                    <label> <input type="button" id="btn-search" class="btn btn-blue" value="查 询" /> </label>
                                </div>
                            </div>
                        </div>
                        <div class="table table-striped table-bordered dataTable no-footer table-select" id="ManageTableDiv" aria-describedby="editabledatatable_info">
                            <div id="data-grid"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@*删除数据的表单*@
