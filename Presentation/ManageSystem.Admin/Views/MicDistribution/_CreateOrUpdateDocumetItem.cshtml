
@using ManageSystem.Admin.Extensions;
@model ManageSystem.Admin.Models.MicdataDistribution.ddDocumentModel
@using ManageSystem.Core.Utility
@using ManageSystem.Core.Utility
@using ManageSystem.Core.Extensions;
@using ManageSystem.Core.Domain.MicdataDistribution;

@Html.ValidationSummary(true)
@Html.HiddenFor(model => model.document_id)

<style type="text/css">
    .table-bordered > tbody > tr > td {
        border: 1px solid #ddd;
    }
</style>
<div>
    <div class="widget-main ">

        @{
            if (Model != null)
            {
                <div class="tab" style="padding-top:0px;">
                    <table width="100%" border="0" cellspacing="1" cellpadding="0" class="table table-striped table-bordered table-hover dataTable no-footer table-bordered">
                        <tbody>
                            <tr class="info">
                                <td colspan="8" style="text-align:center; font-weight:bold;">数据文件基本情况 </td>
                            </tr>
                            <tr>
                                <td class="cb" style="width:8%;">文件名</td>
                                <td style="width:15%;">@Model.title</td>
                                <td class="cb" style="width:6%;">数据行数</td>
                                <td style="width:15%;">@Model.datacount</td>
                            </tr>
                            <tr>
                                <td class="cb">数据所属时段</td>
                                <td>@ViewBag.year 年</td>
                                <td class="cb">上传时间</td>
                                <td>@Model.created.ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            }
        }

        <div class="tabbable" style="margin-top:30px;">
            @Html.Partial("/Views/MicDistribution/_CreateOrUpdateDocumetItem.Data.cshtml")
        </div>
    </div>
</div>


<input type="hidden" id="DataId" value="@Model.document_id.ToString()" />
    @Html.HiddenFor(model => model.document_id)

<link href="/Content/Scripts/laypage-v1.3/skin/laypage.css" rel="stylesheet" />
<script src="/Content/Scripts/laypage-v1.3/laypage.js"></script>


<script type="text/javascript">
    function SelectDataItem(obj) {
        var selectItem = $(obj).attr("SelectItem");
        if (selectItem == "1") {
            $(obj).removeClass("danger");
            $(obj).attr("SelectItem", "0");
        } else {
            $(obj).addClass('danger');
            $(obj).attr("SelectItem", "1");
        }
    }
</script>
