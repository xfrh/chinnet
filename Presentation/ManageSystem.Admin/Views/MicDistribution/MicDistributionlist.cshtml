@model ManageSystem.Admin.Models.MicdataDistribution.ddDocumentModel
    @{

        ViewBag.Title = "数据列表";
    }
    @section HeadSection {
        <style>
            ul.dataTables_filter,
            ul.dataTables_filter li {
                list-style: none;
                margin: 0;
                padding: 0;
            }

            ul.dataTables_filter {
                display: -webkit-box;
                display: -webkit-flex;
                display: -moz-box;
                display: -ms-flexbox;
                display: flex;
                -webkit-box-align: center;
                -webkit-align-items: center;
                -moz-box-align: center;
                -ms-flex-align: center;
                align-items: center;
                -webkit-flex-wrap: wrap;
                -ms-flex-wrap: wrap;
                flex-wrap: wrap;
            }

                ul.dataTables_filter li {
                    margin-right: 15px;
                    margin-bottom: 10px;
                }

                    ul.dataTables_filter li:last-child {
                        margin-right: 0;
                    }
        </style>
    }

    @section Breadcrumb{
        @{Html.RenderAction("Breadcrumb", "Shared", new Breadcrumb { MenuName = "MIC数据分布", SecondName = "数据管理列表", LocationName = this.ViewBag.Title }); }
    }

    @Html.AntiForgeryToken()

    <div class="page-body">

        <div class="row manage-page">
            <div class="col-xs-12 col-md-12">
                <div class="widget">
                    <div class="widget-header bordered-bottom bordered-yellow manage-title-box">
                        <span class="widget-caption manage-title"><i class="glyphicon glyphicon-th "></i>@ViewBag.Title </span>
                        <div class="widget-buttons">
                            <a href="#" data-toggle="maximize"><i class="fa fa-expand"></i></a>
                            <a href="#" data-toggle="collapse"><i class="fa fa-minus"></i></a>
                        </div>
                    </div>

                    <div class="widget-body">
                        <div role="grid" id="searchable_wrapper" class="dataTables_wrapper form-inline">

                            <div id="searchable_filter" class="dataTables_filter manage-but-box">
                                <div style="width: 100%;">
                                    @Html.ButtonHtml(HtmlButtonType.Import, "DocumentCreate", "MicDistribution")
                                    @Html.ButtonHtml(HtmlButtonType.Delete, "DocumentDataDelete", "MicDistribution")
                                </div>
                                <div style="width: 100%;">
                                    <div class="dataTables_filter manage-but-box">
                                        <label class="lb-left">@Html.NopLabelFor(model => model.title)：</label>
                                        <label class="lb-right"><input type="text" id="title" class="form-control input-sm  search" style="width:100%;" /></label>
                                        <label class="lb-left">@Html.NopLabelFor(m => m.year_id)：</label>
                                        <div class="form-control ddl lb-right " style="width: 10%;">
                                            @Html.DropDownList("year_id", Model.YearList, new { @class = "form-control dropdown" })
                                        </div>

                                        <label> <input type="button" id="btn-search" class="btn btn-blue" value="查 询" /> </label>
                                    </div>
                                </div>
                            </div>
                            <div class="table table-striped table-bordered dataTable no-footer table-select" id="ManageTableDiv" aria-describedby="editabledatatable_info">
                                <div id="data-grid"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    @*删除数据的表单*@
    @using (Html.BeginForm("DocumentDataDelete", "MicDistribution", FormMethod.Post, new { id = "delete-selected-form" }))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" id="selectedIds" name="selectedIds" value="" />

    }

    @*下载数据*@
    @using (Html.BeginForm("Exportexcel", "CREProject", FormMethod.Post, new { id = "form-download-ids" }))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" hidden="hidden" id="input-download-type" name="downloadEvent" value="" />
    }
    <script>
    $(document).ready(function () {

        $("#data-grid").kendoGrid({
            dataSource: {
                type: "json",
                transport: {
                    read: {
                        url: "@Html.Raw(Url.Action("MicDistributionlist"))",
                        type: "POST",
                        dataType: "json",
                        data: additionalData
                    }
                },

                schema: {
                    data: "Data",
                    total: "Total",
                    errors: "Errors"
                },
                error: function (e) {
                    display_kendoui_grid_error(e);
                    // Cancel the changes
                    this.cancelChanges();
                },
                pageSize: 10,
                serverPaging: true,
                serverFiltering: true,
                serverSorting: true

            },
            pageable: {
                refresh: true,
                pageSizes: [10, 30, 50]
            },
            scrollable: true,
            groupable: true,
            dataBound: onDataBound,
            columns: [{
                field: "document_id",
                headerTemplate: "  <div class='' style='text-align: center;'><label><input type='checkbox' id='mastercheckbox' /><span class='text'></span> </label></div>",
                headerAttributes: { style: "text-align:center" },
                attributes: { style: "text-align:center" },
                template: " <div class='' style='text-align: center;'><label><input type='checkbox' class='checkboxGroups'  value='#=document_id#' /><span class='text'></span> </label></div> ",
                width: 50
            },

            {
                field: "year",
                title: "<div style='text-align: center;'>年度</div>",
                attributes: { style: "text-align:center" },
                width: 90
            },
            {
                field: "title",
                title: "文件名",
                template: " <a href='#=file_path#'  target='_blank'>#=title#</a> ",
                width: 150
            },
             {
                field: "datacount",
                title: "<div style='text-align: center;'>数据量</div>",
                attributes: { style: "text-align:center" },
                width: 70
              },
            {
                field: "created",
                title: "<div style='text-align: center;'> 添加时间</div>",
                attributes: { style: "text-align:center" },
                width: 110
                },
            {
                field: "username",
                title: "上传者",
                width: 80
            },
            {
                field: "document_id",
                title: "<div style='text-align: center;'>操作</div>",
                width: 110,
                template: "<div style='text-align: center;'><a href='/MicDistribution/DocumentDataView/#=document_id#'>详情</a></div>"
            }
            ]
        });
    });
        //设置查询参数
    function additionalData() {
        var data = {
            title: $("#title").val(),
            year_id: $("#year_id").val(),
        };

        addAntiForgeryToken(data);
        return data;
    }
     $('#export').click(function (e) {
            $('#form-download-ids').html("");

          $('#data-grid').find('input[type="checkbox"][value]:checked').each(function (i, item) {
            if (item.value) {
                $('#form-download-ids').append('<input type="hidden" hidden="hidden" id="input-download-ids" name="ids" value="' + item.value + '" />');
            }
         });

          $('#form-download-ids').attr('action', '@Url.Action("Exportexcel", "CREProject")');
          $('#form-download-ids').submit();
            return false;
        })
    </script>
    <script src="~/Content/Scripts/admin.listpage.js"></script>
