@model  ManageSystem.Admin.Models.Articles.ArticleModel
@{ 
    Layout = "~/Views/Shared/_OpenLayout.cshtml";
}

<div class="page-body">

    <div class="row manage-page">
        <div class="col-xs-12 col-md-12">
            <div class="widget">
                <div class="widget-header bordered-bottom bordered-yellow manage-title-box">
                    <span class="widget-caption manage-title"><i class="glyphicon glyphicon-th "></i>@ViewBag.Title </span>
                    <div class="widget-buttons">
                        <a href="#" data-toggle="maximize"><i class="fa fa-expand"></i></a>
                        <a href="#" data-toggle="collapse"><i class="fa fa-minus"></i></a>
                    </div>
                </div>

                <div class="widget-body">
                    <div role="grid" id="searchable_wrapper" class="dataTables_wrapper form-inline">

                        <div id="searchable_filter" class="dataTables_filter manage-but-box">
                            <div style="width: 100%;">
                                <a class="btn btn-purple"  href="javascript:Confirm()">确认选择</a>
                            </div>
                            <div style="width: 100%;">
                                <div class="dataTables_filter manage-but-box">
                                   <label class="lb-left">@Html.NopLabelFor(model => model.Name)：</label>
                                    <label class="lb-right"><input type="text" id="input-search" class="form-control input-sm  search" aria-controls="searchable" name="searchKey" /></label>
                                    <label class="lb-left">@Html.NopLabelFor(m => m.State)：</label>
                                    <div class="form-control ddl lb-right " style="width: 10%;">
                                        @Html.DropDownList("State", Model.StateList, new { @class = "form-control dropdown" })
                                   </div>
                                    <label class="lb-left">@Html.NopLabelFor(m => m.ArticleTypeList)：</label>
                                    <div class="form-control ddl lb-right " style="width: 10%;">
                                        @Html.DropDownList("ArticleTypeId", Model.ArticleTypeList, new { @class = "form-control dropdown" })
                                    </div>
                                        <label> <input type="button" id="btn-search" class="btn btn-blue" value="查 询" /> </label>
                                    </div>
                            </div>
                        </div>
                        <div class="table table-striped table-bordered dataTable no-footer table-select" id="ManageTableDiv" aria-describedby="editabledatatable_info">
                            <div id="data-grid"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


    <input type="hidden" id="selectedIds" name="selectedIds" value="" />




<script>
    $(document).ready(function () {

        $("#data-grid").kendoGrid({
            dataSource: {
                type: "json",
                transport: {
                    read: {
                        url: "@Html.Raw(Url.Action("ArticleList"))",
                        type: "POST",
                        dataType: "json",
                        data: additionalData
                    }
                },

                schema: {
                    data: "Data",
                    total: "Total",
                    errors: "Errors"
                },
                error: function (e) {
                    display_kendoui_grid_error(e);
                    // Cancel the changes
                    this.cancelChanges();
                },
                pageSize: 10,
                serverPaging: true,
                serverFiltering: true,
                serverSorting: true

            },
            pageable: {
                refresh: true,
                pageSizes: [10,30,50]
            }, 
            scrollable: false,
            groupable: true,
            dataBound: onDataBound,
            columns: [{
                field: "Id",
                headerTemplate: "  <div class='' style='text-align: center;'>    <label><input type='checkbox' id='mastercheckbox' /><span class='text'></span> </label>   </div>",
                headerAttributes: { style: "text-align:center" },
                attributes: { style: "text-align:center" },
                template: " <div class='' style='text-align: center;'>    <label><input type='checkbox' class='checkboxGroups'  value='#=Id#' /><span class='text'></span> </label>   </div> ",
                width: 50
            },
             		{
			field: "Name",
			title: "文章名称",
             		},
                    	{
                    	    field: "TypeName",
                title: "所属分类",
        width: 100
    },

		{
		    field: "State",
			title: "文章状态",
			width: 100
		},
		{
			field: "Author",
			title: "文章作者",
			width: 100
		},
		{
			field: "ReleaseTime",
			title: "发布时间",
			type: "date",
			format: "{0:yyyy-MM-dd}",
			width: 120
		},

            {
                field: "Id",
                title: "操作",
                width: 120,
                template: '<a href="ArticleView/#=Id#">详细</a>&nbsp;&nbsp;<a href="ArticleEdit/#=Id#">编辑</a>'
            }]
        });
    });


    //设置查询参数
    function additionalData() {
        var data = {
            Name: $("#input-search").val(),
            State: $("#@Html.FieldNameFor(m=>m.State)").val(),
            ArticleTypeId: $("#@Html.FieldNameFor(m=>m.ArticleTypeId)").val(),
        };

        addAntiForgeryToken(data);
        return data;
    }

</script>



<script src="~/Content/Scripts/admin.listpage.js"></script>

<script src="~/Content/Scripts/layer/layer.js"></script>

<script type="text/javascript">

    var index = parent.layer.getFrameIndex(window.name); //获取窗口索引

    function Confirm()
    {
       var ids = selectedIds.join(",");
       var value= $('#selectedIds').val(ids);

       parent.ConfirmSelectArticle($('#selectedIds').val());
       parent.layer.close(index);
    }


</script>