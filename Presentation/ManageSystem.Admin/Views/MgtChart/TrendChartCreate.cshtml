        </td>
        <td class="text-center">
            <a class="btn btn-delete" style="float:left;margin-left:60px;" data-tagid="{{$value.uuid}}" onclick="deleteRow(1, '#list-item-{{$value.uuid}}'); return false;" href="javascript: void(0);">删&ensp;除</a>
