@model ManageSystem.Admin.Models.Meetings.MeetingModel
@{
    //page title
    ViewBag.Title = "添加信息动态";
}

@section Breadcrumb{
    @{Html.RenderAction("Breadcrumb", "Shared", new Breadcrumb { MenuName = "信息动态管理", SecondName = "会议管理", LocationName = this.ViewBag.Title }); }
}

@section HeadSection{
    <link href="~/Content/Scripts/bootstrap-fileinput/css/fileinput.css" media="all" rel="stylesheet" type="text/css" />
    <style>
        .flex {
            display: -webkit-box;
            display: -webkit-flex;
            display: -moz-box;
            display: -ms-flexbox;
            display: flex;
            -webkit-box-align: center;
            -webkit-align-items: center;
            -moz-box-align: center;
            -ms-flex-align: center;
            align-items: center;
        }

        .gap-time:before {
            content: '—';
            display: block;
            width: 15px;
            height: 34px;
            margin: 0 13px 0 15px;
            position: relative;
            top: -2px;
        }

        .gap-time {
            display: -webkit-box;
            display: -webkit-flex;
            display: -moz-box;
            display: -ms-flexbox;
            display: flex;
            -webkit-box-align: center;
            -webkit-align-items: center;
            -moz-box-align: center;
            -ms-flex-align: center;
            align-items: center;
        }

        .k-content .dropdown {
            z-index: 9999 !important;
        }

        .cover-file .k-upload-files {
            width: calc(80% + 24px);
        }

        .flex {
            display: -webkit-box;
            display: -webkit-flex;
            display: -moz-box;
            display: -ms-flexbox;
            display: flex;
        }

            .flex .text-box,
            .flex .dropdown {
                width: 100%;
            }

        .flex-1 {
            -webkit-box-flex: 1;
            -webkit-flex: 1;
            -moz-box-flex: 1;
            -ms-flex: 1;
            flex: 1;
        }

        .w80p {
            width: 80%;
        }

        .author-table {
            display: -webkit-box;
            display: -webkit-flex;
            display: -moz-box;
            display: -ms-flexbox;
            display: flex;
        }

        .author-cell {
            -webkit-box-flex: 1;
            -webkit-flex: 1;
            -moz-box-flex: 1;
            -ms-flex: 1;
            flex: 1;
        }

        .author-title {
            text-align: right;
            padding-right: 30px;
        }

        .author-data {
        }
    </style>
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true)

    @Html.HiddenFor(model => model.Id)

    <div class="page-body">
        <div class="row add-page">
            <div class="col-lg-12 col-sm-12 col-xs-12">
                <div class="widget ">
                    <div class="widget-header add-page-titlebox ">
                        <span class="widget-caption add-page-title"><i class="glyphicon glyphicon-plus "></i>@this.ViewBag.Title</span>
                    </div>
                    <div class="widget-body " id="BaseDiv" runat="server">
                        <div class="options add-page-options">
                            <input type="submit" name="save" class="btn btn-blue " value="保存" />
                        </div>
                        <div class="add-content ">
                            <div class="k-content k-state-active" id="customer-edit-1" role="tabpanel" aria-expanded="true" style="display: block;">
                                @Html.Partial("_CreateOrUpdateMeeting", Model)
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

}

