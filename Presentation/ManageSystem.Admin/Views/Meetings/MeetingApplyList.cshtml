@model  ManageSystem.Admin.Models.Meetings.MeetingApplyModel

@{
    ViewBag.Title = "信息动态报名";
    bool IsEdit = UserinfoExtensions.CheckFunction(Url.Action("MeetingApplyEdit"));
    bool IsView = UserinfoExtensions.CheckFunction(Url.Action("MeetingApplyView"));
}

@section HeadSection {
}

@section Breadcrumb{
    @{Html.RenderAction("Breadcrumb", "Shared", new Breadcrumb { MenuName = "信息动态管理", SecondName = "会议报名管理", LocationName = this.ViewBag.Title }); }
}

@Html.AntiForgeryToken()

<div class="page-body">

    <div class="row manage-page">
        <div class="col-xs-12 col-md-12">
            <div class="widget">
                <div class="widget-header bordered-bottom bordered-yellow manage-title-box">
                    <span class="widget-caption manage-title"><i class="glyphicon glyphicon-th "></i>@ViewBag.Title </span>
                    <div class="widget-buttons">
                        <a href="#" data-toggle="maximize"><i class="fa fa-expand"></i></a>
                        <a href="#" data-toggle="collapse"><i class="fa fa-minus"></i></a>
                    </div>
                </div>

                <div class="widget-body">
                    <div role="grid" id="searchable_wrapper" class="dataTables_wrapper form-inline">

                        <div id="searchable_filter" class="dataTables_filter manage-but-box">
                            <div style="width: 100%;">
                                @Html.ButtonHtml(HtmlButtonType.Delete, "MeetingApplyDelete", "Meetings")
                            </div>
                            <div style="width: 100%;">
                                <div class="dataTables_filter manage-but-box">
                                    <label class="lb-left">@Html.NopLabelFor(model => model.MeetingName)：</label>
                                    <label class="lb-right"><input type="text" id="input-search" class="form-control input-sm  search"  /></label>
                                    <label class="lb-left">@Html.NopLabelFor(model => model.Name)：</label>
                                    <label class="lb-right">@Html.EditorFor(m => m.Name, new { @class = "form-control input-sm" }) </label>
                                    <label class="lb-left">@Html.NopLabelFor(model => model.Email)：</label>
                                    <label class="lb-right">@Html.EditorFor(m => m.Email, new { @class = "form-control input-sm" }) </label>
                                    <label class="lb-left">@Html.NopLabelFor(model => model.Phone)：</label>
                                    <label class="lb-right">@Html.EditorFor(m => m.Phone, new { @class = "form-control input-sm" }) </label>
                                    <label> <input type="button" id="btn-search" class="btn btn-blue" value="查 询" /> </label>
                                </div>
                            </div>
                        </div>
                        <div class="table table-striped table-bordered dataTable no-footer table-select" id="ManageTableDiv" aria-describedby="editabledatatable_info">
                            <div id="data-grid"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@*删除数据的表单*@
@using (Html.BeginForm("MeetingApplyDelete", "Meetings", FormMethod.Post, new { id = "delete-selected-form" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" id="selectedIds" name="selectedIds" value="" />

}

<script>
    $(document).ready(function () {

        $("#data-grid").kendoGrid({
            dataSource: {
                type: "json",
                transport: {
                    read: {
                        url: "@Html.Raw(Url.Action("MeetingApplyList"))",
                        type: "POST",
                        dataType: "json",
                        data: additionalData
                    }
                },

                schema: {
                    data: "Data",
                    total: "Total",
                    errors: "Errors"
                },
                error: function (e) {
                    display_kendoui_grid_error(e);
                    // Cancel the changes
                    this.cancelChanges();
                },
                pageSize: 10,
                serverPaging: true,
                serverFiltering: true,
                serverSorting: true

            },
            pageable: {
                refresh: true,
                pageSizes: [10, 30, 50]
            },
            scrollable: false,
            groupable: true,
            dataBound: onDataBound,
            columns: [{
                field: "Id",
                headerTemplate: "  <div class='' style='text-align: center;'>    <label><input type='checkbox' id='mastercheckbox' /><span class='text'></span> </label>   </div>",
                headerAttributes: { style: "text-align:center" },
                attributes: { style: "text-align:center" },
                template: " <div class='' style='text-align: center;'>    <label><input type='checkbox' class='checkboxGroups'  value='#=Id#' /><span class='text'></span> </label>   </div> ",
                width: 50
            },
            	{
            	    field: "InsertTime",
            	    title: "添加时间",
            	    width: 180
            	},
	
		{
		    field: "MeetingId",
		    title: "信息动态的id",
		    width: 180
		},
		{
		    field: "MeetingName",
		    title: "信息动态的名称"
		},
        	{
        	    field: "MeetingTypeName",
        	    title: "信息动态类型",
        	    width: 100
        	},
		{
		    field: "MemberId",
		    title: "会员Id",
		    width: 180
		},
        	{
        	    field: "Name",
        	    title: "报名人姓名",
        	    width: 100
        	},
		{
		    field: "Email",
		    title: "邮箱地址",
		    width: 200
		},
		{
		    field: "Phone",
		    title: "手机号码",
		    width: 150
		},

		{
		    field: "StatusName",
		    title: "报名状态",
		    width: 80
		},

            {
                field: "Id",
                title: "操作",
                width: 100,
                template: "@Html.KendoUIEditAndView(IsView, "MeetingApplyView", IsEdit, "MeetingApplyEdit")"
            }]
        });
    });


    //设置查询参数
    function additionalData() {
        var data = {
            MeetingId:'@this.Request.QueryString["MeetingId"]',
            MeetingName: $("#input-search").val(),
            Name: $("#@Html.FieldIdFor(m=>m.Name)").val(),
            Email: $("#@Html.FieldIdFor(m=>m.Email)").val(),
            Phone: $("#@Html.FieldIdFor(m=>m.Phone)").val(),
        };

        addAntiForgeryToken(data);
        return data;
    }

</script>


<script src="~/Content/Scripts/admin.listpage.js"></script>