@model ManageSystem.Admin.Models.Meetings.MeetingApplyModel
@using ManageSystem.Admin.Extensions;
@using ManageSystem.Core.Utility;

@Html.ValidationSummary(true)
@Html.HiddenFor(model => model.Id)


		<table class="adminContent">
            <tr class="insert-time-tr" style="display:none;">
                <td class="adminTitle">@Html.NopLabelFor(m => m.InsertTime)：</td>
                <td class="adminData">
                    @Model.InsertTime.ToString("yyyy-MM-dd HH:mm")
                </td>
            </tr>
            <tr class="insert-time-tr" style="display:none;">
                <td class="adminTitle">@Html.NopLabelFor(m => m.UpdateTime)：</td>
                <td class="adminData">
                    @Model.UpdateTime.ToString("yyyy-MM-dd HH:mm")
                </td>
            </tr>
		<tr>
			<td class="adminTitle">@Html.NopLabelFor(m => m.MemberId)：</td>
				<td class="adminData">
                    @Model.MemberId
			</td>
			</tr>
		<tr>
			<td class="adminTitle">@Html.NopLabelFor(m => m.MemberName)：</td>
				<td class="adminData">
                    @Model.MemberName
			</td>
			</tr>
		<tr>
			<td class="adminTitle">@Html.NopLabelFor(m => m.MeetingId)：</td>
				<td class="adminData">
                    @Model.MeetingId
			</td>
			</tr>
		<tr>
			<td class="adminTitle">@Html.NopLabelFor(m => m.MeetingName)：</td>
				<td class="adminData">
                    @Model.MeetingName
			</td>
			</tr>
		<tr>
			<td class="adminTitle">@Html.NopLabelFor(m => m.Name)：</td>
				<td class="adminData">
				@Html.EditorFor(m => m.Name, new { htmlAttributes = new { @onkeydown = "keypresshandle(event);" } })
				@Html.ValidationMessageFor(m => m.Name)
			</td>
			</tr>
		<tr>
			<td class="adminTitle">@Html.NopLabelFor(m => m.Email)：</td>
				<td class="adminData">
				@Html.EditorFor(m => m.Email, new { htmlAttributes = new { @onkeydown = "keypresshandle(event);" } })
				@Html.ValidationMessageFor(m => m.Email)
			</td>
			</tr>
		<tr>
			<td class="adminTitle">@Html.NopLabelFor(m => m.Phone)：</td>
				<td class="adminData">
				@Html.EditorFor(m => m.Phone, new { htmlAttributes = new { @onkeydown = "keypresshandle(event);" } })
				@Html.ValidationMessageFor(m => m.Phone)
			</td>
			</tr>
		<tr>
			<td class="adminTitle">@Html.NopLabelFor(m => m.Remark)：</td>
				<td class="adminData">
				@Html.EditorFor(m => m.Remark, new { htmlAttributes = new { @onkeydown = "keypresshandle(event);" } })
				@Html.ValidationMessageFor(m => m.Remark)
			</td>
			</tr>
	
		<tr>
			<td class="adminTitle">@Html.NopLabelFor(m => m.Status)：</td>
				<td class="adminData">
                    @Html.DropDownListFor(model => model.Status, Model.MeetingApplyStatusList, new { @class = "form-control dropdown" })
				@Html.ValidationMessageFor(m => m.Status)
			</td>
			</tr>
		<tr>
			<td class="adminTitle">@Html.NopLabelFor(m => m.StatusTime)：</td>
				<td class="adminData">
                    @Model.StatusTime.GetNormalString("L")
			</td>
			</tr>
		<tr>
			<td class="adminTitle">@Html.NopLabelFor(m => m.OrderSN)：</td>
				<td class="adminData">
                    @Model.OrderSN
			</td>
			</tr>
		<tr>
			<td class="adminTitle">@Html.NopLabelFor(m => m.CallBackSN)：</td>
				<td class="adminData">
                    @Model.CallBackSN
			</td>
			</tr>
		<tr>
			<td class="adminTitle">@Html.NopLabelFor(m => m.PayMethod)：</td>
				<td class="adminData">
				@Model.PayMethod
			</td>
			</tr>
		<tr>
			<td class="adminTitle">@Html.NopLabelFor(m => m.Price)：</td>
				<td class="adminData">
                    @Model.Price
			</td>
			</tr>
		<tr>
			<td class="adminTitle">@Html.NopLabelFor(m => m.PayAmount)：</td>
				<td class="adminData">
                    @Model.PayAmount
			</td>
			</tr>
		<tr>
			<td class="adminTitle">@Html.NopLabelFor(m => m.ReceivedAmount)：</td>
				<td class="adminData">
                    @Model.ReceivedAmount
			</td>
			</tr>
		<tr>
			<td class="adminTitle">@Html.NopLabelFor(m => m.PayTime)：</td>
				<td class="adminData">
                    @Model.PayTime.GetNormalString("L")
			</td>
			</tr>
		</table>

        <script src="/Content/Scripts/TranTextBox.js"></script>
<script type="text/javascript">

				$("#PayTime").kendoDatePicker({ value: new Date(), format: "yyyy-MM-dd HH:mm" });


   
</script>