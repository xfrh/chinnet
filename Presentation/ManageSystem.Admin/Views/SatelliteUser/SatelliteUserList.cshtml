@model  ManageSystem.Admin.Models.Satellite.SatelliteUserModel

@{
    /**/

    ViewBag.Title = "卫星网申请记录账号列表";
}

@section HeadSection {
    <style>
        ul.dataTables_filter,
        ul.dataTables_filter li {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        ul.dataTables_filter {
            display: -webkit-box;
            display: -webkit-flex;
            display: -moz-box;
            display: -ms-flexbox;
            display: flex;
            -webkit-box-align: center;
            -webkit-align-items: center;
            -moz-box-align: center;
            -ms-flex-align: center;
            align-items: center;
            -webkit-flex-wrap: wrap;
            -ms-flex-wrap: wrap;
            flex-wrap: wrap;
        }

            ul.dataTables_filter li {
                margin-right: 15px;
                margin-bottom: 10px;
            }

                ul.dataTables_filter li:last-child {
                    margin-right: 0;
                }
    </style>
}

@section Breadcrumb{
    @{Html.RenderAction("Breadcrumb", "Shared", new Breadcrumb { LocationName = this.ViewBag.Title }); }
}

@Html.AntiForgeryToken()
<div class="page-body">

    <div class="row manage-page">
        <div class="col-xs-12 col-md-12">
            <div class="widget">
                <div class="widget-header bordered-bottom bordered-yellow manage-title-box">
                    <span class="widget-caption manage-title"><i class="glyphicon glyphicon-th "></i>@ViewBag.Title </span>
                    <div class="widget-buttons">
                        <a href="#" data-toggle="maximize"><i class="fa fa-expand"></i></a>
                        <a href="#" data-toggle="collapse"><i class="fa fa-minus"></i></a>
                    </div>
                </div>

                <div class="widget-body">
                    <div role="grid" id="searchable_wrapper" class="dataTables_wrapper form-inline">

                        <div id="searchable_filter" class="dataTables_filter manage-but-box">
                            <div style="width: 100%;">
                                @*<div style="width: 100%;">
                                    <a class="btn btn-purple" href="/SatelliteUser/SatelliteUserInfo/@Model.SatelliteId">添 加</a>
                                    
                                </div>*@
                                <div class="dataTables_filter manage-but-box">
                                    <label class="lb-left">账号：</label>
                                    <label class="lb-right"><input type="text" id="UserName" class="form-control input-sm  search" style="width:100%;" /></label>
                                    <label class="lb-left">密码：</label>
                                    <label class="lb-right"><input type="text" id="UserPassword" class="form-control input-sm  search" style="width:100%;" /></label>
                                    <label> <input type="button" onclick="CreatUser()" class="btn btn-blue" value="添加" /></label>
                                </div>
                            </div>
                        </div>
                        <div class="table table-striped table-bordered dataTable no-footer table-select" id="ManageTableDiv" aria-describedby="editabledatatable_info">
                            <div id="data-grid"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<input type="hidden" name="SatelliteId" id="SatelliteId" value="@Model.SatelliteId" />
<script>
    $(document).ready(function () {
        $("#data-grid").kendoGrid({
            dataSource: {
                type: "json",
                transport: {
                    read: {
                        url: "@Html.Raw(Url.Action("SatelliteUserListPage", "SatelliteUser"))",
                        type: "POST",
                        dataType: "json",
                        data: SaData
                    }
                },
                schema: {
                    data: "Data",
                    total: "Total",
                    errors: "Errors"
                },
                error: function (e) {
                    display_kendoui_grid_error(e);
                    // Cancel the changes
                    this.cancelChanges();
                },
                pageSize: 100,
                serverPaging: true,
                serverFiltering: true,
                serverSorting: true

            },
            pageable: {
                refresh: true,
                pageSizes: [10, 30, 50,70,90,100]
            },
            scrollable: true,
            groupable: true,
            dataBound: onDataBound,
            columns: [
                
    	    {
		        field: "UserName",
		        title: "账号",
		        width: 60
		    },
		    {
		        field: "PassWord",
		        title: "密码",
		        width: 110
		    },{
                field: "ID",
                title: "操作",
                width: 120,
                template: " @Html.Raw("#=EditBtn#") @Html.Raw("#=DelBtn#")"
            }]
        });
    });

    //设置查询参数
    function SaData() {
        var data = {
            UserName: $("#UserName").val(),
            SatelliteId: $("#SatelliteId").val() 
        };
        addAntiForgeryToken(data);
        return data;
    }


    function DelUser(ID) {
        console.log(ID);
        $.ajax({
            url: "/SatelliteUser/SatelliteUserDelete",
            type: "POST",
            dataType: "json",
            data: {
                ID: ID,
            SatelliteId: $("#SatelliteId").val() },
            success: function myfunction() {

            }
        })
    }

    function CreatUser()
    {
        $.ajax({
            url: "/SatelliteUser/CreatUser",
            type: "POST",
            dataType: "json",
            data: {
                ID: $("#SatelliteId").val() ,
                account: $("#UserName").val(),
                password: $("#UserPassword").val()
            },
            success: function myfunction() {
                location.reload();
            }
        })
        location.reload();
    }

</script>

<script src="~/Content/Scripts/admin.listpage.js"></script>



