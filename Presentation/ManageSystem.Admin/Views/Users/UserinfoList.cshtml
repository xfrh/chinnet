@model  ManageSystem.Admin.Models.Users.UserinfoModel

@{
    ViewBag.Title = "用户管理";

    bool IsEdit = UserinfoExtensions.CheckFunction(Url.Action("UserinfoEdit"));
    bool IsView = UserinfoExtensions.CheckFunction(Url.Action("UserinfoView"));
}

@section HeadSection {
}

@section Breadcrumb{
    @{Html.RenderAction("Breadcrumb", "Shared", new Breadcrumb { MenuName = "用户管理", SecondName = "用户管理", LocationName = this.ViewBag.Title }); }
}

@Html.AntiForgeryToken()

<div class="page-body">

    <div class="row manage-page">
        <div class="col-xs-12 col-md-12">
            <div class="widget">
                <div class="widget-header bordered-bottom bordered-yellow manage-title-box">
                    <span class="widget-caption manage-title"><i class="glyphicon glyphicon-th "></i>@ViewBag.Title </span>
                    <div class="widget-buttons">
                        <a href="#" data-toggle="maximize"><i class="fa fa-expand"></i></a>
                        <a href="#" data-toggle="collapse"><i class="fa fa-minus"></i></a>
                    </div>
                </div>

                <div class="widget-body">
                    <div role="grid" id="searchable_wrapper" class="dataTables_wrapper form-inline">

                        <div id="searchable_filter" class="dataTables_filter manage-but-box">
                            <div style="width: 100%;">
                                @Html.ButtonHtml(HtmlButtonType.Add, "UserinfoCreate", "Users")
                                @Html.ButtonHtml(HtmlButtonType.Delete, "UserinfoDelete", "Users")
                            </div>
                            <div style="width: 100%;">
                                <div class="dataTables_filter manage-but-box">
                                   <label class="lb-left">@Html.NopLabelFor(model => model.LoginId)：</label>
                                    <label class="lb-right"><input type="text" id="input-search" class="form-control input-sm  search" aria-controls="searchable" name="searchKey" /></label>
                                    <label class="lb-left">@Html.NopLabelFor(model => model.Name)：</label>
                                    <label class="lb-right"><input type="text" id="input-name" class="form-control input-sm  search" aria-controls="searchable" name="searchKey" /></label>
                                    <label>@Html.NopLabelFor(model => model.State)：</label>
                                    <div class="form-control ddl " style="width: 15%;">@Html.DropDownList("state", Model.UserinfoStateList, new { @class = "form-control dropdown" })</div>
                                     <label> <input type="button" id="btn-search" class="btn btn-blue" value="查 询" /> </label>
                                </div>
                            </div>
                        </div>
                        <div class="table table-striped table-bordered dataTable no-footer table-select" id="ManageTableDiv" aria-describedby="editabledatatable_info">
                            <div id="data-grid"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@*删除数据的表单*@
@using (Html.BeginForm("UserinfoDelete", "Users", FormMethod.Post, new { id = "delete-selected-form" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" id="selectedIds" name="selectedIds" value="" />

    <script type="text/javascript">

        $(document).ready(function () {
           //删除事件
        $('#btn-delete').click(function (e) {

            if (selectedIds == null || selectedIds.length <= 0) {
                alert("请勾选需要删除的数据！")
                return;
            }

            if (confirm("不可恢复操作，确认删除吗？"))
            {
                e.preventDefault();
                var ids = selectedIds.join(",");
                $('#delete-selected-form #selectedIds').val(ids);
                $('#delete-selected-form').submit();
                return false;
            }
        });

    });

    </script>
}

<script>
    $(document).ready(function () {

        $("#data-grid").kendoGrid({
            dataSource: {
                type: "json",
                transport: {
                    read: {
                        url: "@Html.Raw(Url.Action("UserinfoList"))",
                        type: "POST",
                        dataType: "json",
                        data: additionalData
                    }
                },

                schema: {
                    data: "Data",
                    total: "Total",
                    errors: "Errors"
                },
                error: function (e) {
                    display_kendoui_grid_error(e);
                    // Cancel the changes
                    this.cancelChanges();
                },
                pageSize: 10,
                serverPaging: true,
                serverFiltering: true,
                serverSorting: true

            },
            pageable: {
                refresh: true,
                pageSizes: [10,30,50]
            }, 
            scrollable: false,
            groupable: true,
            dataBound: onDataBound,
            columns: [{
                field: "Id",
                headerTemplate: "  <div class='' style='text-align: center;'>    <label><input type='checkbox' id='mastercheckbox' /><span class='text'></span> </label>   </div>",
                headerAttributes: { style: "text-align:center" },
                attributes: { style: "text-align:center" },
                template: " <div class='' style='text-align: center;'>    <label><input type='checkbox' class='checkboxGroups'  value='#=Id#' /><span class='text'></span> </label>   </div> ",
                width: 50
            },
             		{
			field: "LoginId",
			title: "登录帐号",
			width: 120
		},
		{
			field: "Name",
			title: "真实姓名",
			width: 120
		},
		{
			field: "NickName",
			title: "用户别名",
			width: 120
		},
		{
			field: "Phone",
			title: "手机号码",
			width: 100
		},
		{
			field: "Email",
			title: "邮箱地址",
			width: 150
		},
	
		{
			field: "StateName",
			title: "帐号状态",
			width: 80
		},
            {
                field: "Id",
                title: "操作",
                width: 150,
                template: "@Html.KendoUIEditAndView(IsView, "UserinfoView", IsEdit, "UserinfoEdit")"
               
            }]
        });
    });


    //设置查询参数
    function additionalData() {
        var data = {
            LoginId: $("#input-search").val(),
            Name: $("#input-name").val(),
            State:$("#state").val()
        };

        addAntiForgeryToken(data);
        return data;
    }

</script>

<script type="text/javascript">

    var selectedIds = [];

    $(document).ready(function () {

        //查询事件
        $('#btn-search').click(function () {
            var grid = $('#data-grid').data('kendoGrid');
            grid.dataSource.page(1);
            $('.checkboxGroups').attr('checked', false).change();
            selectedIds = [];
            return false;
        });

        //全选功能
        $('#mastercheckbox').click(function () {
            $('.checkboxGroups').attr('checked', $(this).is(':checked')).change();
        });

        //选中 checkboxes.
        $('#data-grid').on('change', 'input[type=checkbox][id!=mastercheckbox]', function (e) {
            var $check = $(this);
            if ($check.is(":checked") == true) {
                var checked = jQuery.inArray($check.val(), selectedIds);
                if (checked == -1) {
                    //add id to selectedIds.
                    selectedIds.push($check.val());
                }
            }
            else {
                var checked = jQuery.inArray($check.val(), selectedIds);
                if (checked > -1) {
                    //remove id from selectedIds.
                    selectedIds = $.grep(selectedIds, function (item, index) {
                        return item != $check.val();
                    });
                }
            }
            updateMasterCheckbox();
        });

    });

    //加载数据的时候检查选中
    function onDataBound(e) {

        $('#data-grid input[type=checkbox][id!=mastercheckbox]').each(function () {
            var currentId = $(this).val();
            var checked = jQuery.inArray(currentId, selectedIds);
            //set checked based on if current checkbox's value is in selectedIds.
            $(this).attr('checked', checked > -1);
        });

        updateMasterCheckbox();
    }

    //设置全选的checkboxes
    function updateMasterCheckbox() {
        var numChkBoxes = $('#data-grid input[type=checkbox][id!=mastercheckbox]').length;
        var numChkBoxesChecked = $('#data-grid input[type=checkbox][id!=mastercheckbox]:checked').length;
        $('#mastercheckbox').attr('checked', numChkBoxes == numChkBoxesChecked && numChkBoxes > 0);
    }


</script>
