<style type="text/css">
    .role-page-div .f-div {
        margin: 20px 0px;
        border: 1px solid #ccc;
        padding: 10px;
    }

    .role-page-div .f-item li {
        float: left;
        text-decoration: none;
        list-style: none;
        padding: 0px 5px;
        width: auto;
        margin-right: 10px;
    }

    .role-page-div .m-item {
