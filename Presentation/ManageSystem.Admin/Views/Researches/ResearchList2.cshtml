@model  ManageSystem.Admin.Models.Researches.ResearchModel

@{
    ViewBag.Title = "科研管理";
	bool IsEdit = UserinfoExtensions.CheckFunction(Url.Action("ResearchEdit"));
    bool IsView = UserinfoExtensions.CheckFunction(Url.Action("ResearchView"));
}

@section HeadSection {
}

@section Breadcrumb{
    @{Html.RenderAction("Breadcrumb", "Shared", new Breadcrumb { MenuName = "科研合作管理", SecondName = "科研管理", LocationName = this.ViewBag.Title }); }
}

@Html.AntiForgeryToken()

<div class="page-body">

    <div class="row manage-page">
        <div class="col-xs-12 col-md-12">
            <div class="widget">
                <div class="widget-header bordered-bottom bordered-yellow manage-title-box">
                    <span class="widget-caption manage-title"><i class="glyphicon glyphicon-th "></i>@ViewBag.Title </span>
                    <div class="widget-buttons">
                        <a href="#" data-toggle="maximize"><i class="fa fa-expand"></i></a>
                        <a href="#" data-toggle="collapse"><i class="fa fa-minus"></i></a>
                    </div>
                </div>

                <div class="widget-body">
                    <div role="grid" id="searchable_wrapper" class="dataTables_wrapper form-inline">

                        <div id="searchable_filter" class="dataTables_filter manage-but-box">
                            <div style="width: 100%;">
                                @Html.ButtonHtml(HtmlButtonType.Add, "ResearchCreate", "Researches")
                                @Html.ButtonHtml(HtmlButtonType.Delete, "ResearchDelete", "Researches")

                            </div>
                            <div style="width: 100%;">
                                <div class="dataTables_filter manage-but-box">
                                   <label class="lb-left">@Html.NopLabelFor(model => model.InsertTime)：</label>
                                    <label class="lb-right"><input type="text" id="input-search" class="form-control input-sm  search" aria-controls="searchable" name="searchKey" /></label>
                                      <label> <input type="button" id="btn-search" class="btn btn-blue" value="查 询" /> </label>
                                </div>
                            </div>
                        </div>
                        <div class="table table-striped table-bordered dataTable no-footer table-select" id="ManageTableDiv" aria-describedby="editabledatatable_info">
                            <div id="data-grid"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@*删除数据的表单*@
@using (Html.BeginForm("ResearchDelete", "Researches", FormMethod.Post, new { id = "delete-selected-form" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" id="selectedIds" name="selectedIds" value="" />

}

<script>
    $(document).ready(function () {

        $("#data-grid").kendoGrid({
            dataSource: {
                type: "json",
                transport: {
                    read: {
                        url: "@Html.Raw(Url.Action("ResearchList"))",
                        type: "POST",
                        dataType: "json",
                        data: additionalData
                    }
                },

                schema: {
                    data: "Data",
                    total: "Total",
                    errors: "Errors"
                },
                error: function (e) {
                    display_kendoui_grid_error(e);
                    // Cancel the changes
                    this.cancelChanges();
                },
                pageSize: 10,
                serverPaging: true,
                serverFiltering: true,
                serverSorting: true

            },
            pageable: {
                refresh: true,
                pageSizes: [10,30,50]
            }, 
            scrollable: false,
            groupable: true,
            dataBound: onDataBound,
            columns: [{
                field: "Id",
                headerTemplate: "  <div class='' style='text-align: center;'>    <label><input type='checkbox' id='mastercheckbox' /><span class='text'></span> </label>   </div>",
                headerAttributes: { style: "text-align:center" },
                attributes: { style: "text-align:center" },
                template: " <div class='' style='text-align: center;'>    <label><input type='checkbox' class='checkboxGroups'  value='#=Id#' /><span class='text'></span> </label>   </div> ",
                width: 50
            },
             		{
			field: "Name",
			title: "研究名称",
			width: 100
		},
		{
			field: "Code",
			title: "研究编码",
			width: 100
		},
		{
			field: "Area",
			title: "科研区域",
			type: "date",
			format: "{0:yyyy-MM-dd HH:mm}",
			width: 100
		},
		{
			field: "StartTime",
			title: "科研时间",
			type: "date",
			format: "{0:yyyy-MM-dd HH:mm}",
			width: 100
		},
		{
			field: "Require",
			title: "参与要求",
			width: 100
		},
		{
			field: "Initiator",
			title: "科研发起人",
			width: 100
		},
		{
			field: "ResearchTypeId",
			title: "科研类型id",
			width: 100
		},
		{
			field: "LogoImage",
			title: "研究Logo",
			width: 100
		},
		{
			field: "Remark",
			title: "研究简介",
			width: 100
		},
		{
			field: "MemberId",
			title: "发布用户的id",
			width: 100
		},
		{
			field: "MemberName",
			title: "发布用户的姓名",
			width: 100
		},
		{
			field: "Status",
			title: "状态",
			width: 100
		},

            {
                field: "Id",
                title: "操作",
                width: 150,
				template: "@Html.KendoUIEditAndView(IsView, "ResearchView", IsEdit, "ResearchEdit")" 
            }]
        });
    });


    //设置查询参数
    function additionalData() {
        var data = {
            Title: $("#input-search").val()
        };

        addAntiForgeryToken(data);
        return data;
    }

</script>


<script src="~/Content/Scripts/admin.listpage.js"></script>