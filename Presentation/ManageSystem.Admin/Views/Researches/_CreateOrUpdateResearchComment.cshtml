@model ManageSystem.Admin.Models.Researches.ResearchCommentModel
@using ManageSystem.Admin.Extensions;

@Html.ValidationSummary(true)
@Html.HiddenFor(model => model.Id)


<table class="adminContent">
    <tr class="insert-time-tr" style="display:none;">
        <td class="adminTitle">@Html.NopLabelFor(m => m.InsertTime)：</td>
        <td class="adminData">
            @Model.InsertTime.ToString("yyyy-MM-dd HH:mm")
        </td>
    </tr>
    <tr class="insert-time-tr" style="display:none;">
        <td class="adminTitle">@Html.NopLabelFor(m => m.UpdateTime)：</td>
        <td class="adminData">
            @Model.UpdateTime.ToString("yyyy-MM-dd HH:mm")
        </td>
    </tr>
    <tr>
        <td class="adminTitle">@Html.NopLabelFor(m => m.MemberId)：</td>
        <td class="adminData">
            @Model.MemberId
        </td>
    </tr>
    <tr>
        <td class="adminTitle">@Html.NopLabelFor(m => m.MemberName)：</td>
        <td class="adminData">
            @Model.MemberName
        </td>
    </tr>
    <tr>
        <td class="adminTitle">@Html.NopLabelFor(m => m.ResearchId)：</td>
        <td class="adminData">
            @Model.ResearchId
        </td>
    </tr>
    <tr>
        <td class="adminTitle">@Html.NopLabelFor(m => m.ResearchName)：</td>
        <td class="adminData">
            @Model.ResearchName
        </td>
    </tr>
    <tr>
        <td class="adminTitle">@Html.NopLabelFor(m => m.Ip)：</td>
        <td class="adminData">
            @Model.Ip
        </td>
    </tr>
    <tr>
        <td class="adminTitle">@Html.NopLabelFor(m => m.BrowserName)：</td>
        <td class="adminData">
            @Model.BrowserName
        </td>
    </tr>

    <tr>
        <td class="adminTitle">@Html.NopLabelFor(m => m.Type)：</td>
        <td class="adminData">
            @Model.TypeName
        </td>
    </tr>
    <tr>
        <td class="adminTitle">@Html.NopLabelFor(m => m.Content)：</td>
        <td class="adminData">
            @Html.TextAreaFor(model => model.Content, new { @class = "form-control txt", cols = "30", rows = "3" })
            @Html.ValidationMessageFor(m => m.Content)
        </td>
    </tr>
</table>

