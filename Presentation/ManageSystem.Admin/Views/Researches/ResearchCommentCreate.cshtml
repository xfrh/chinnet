@model ManageSystem.Admin.Models.Researches.ResearchCommentModel
@{
    //page title
    ViewBag.Title = "添加科研合作管理";
}

@section Breadcrumb{
    @{Html.RenderAction("Breadcrumb", "Shared", new Breadcrumb { MenuName = "科研合作管理", SecondName = "科研评论管理", LocationName = this.ViewBag.Title }); }
}

@using (Html.BeginForm())
{
  @Html.AntiForgeryToken()

 <div class="page-body">
    <div class="row add-page">
        <div class="col-lg-12 col-sm-12 col-xs-12">
            <div class="widget ">
                <div class="widget-header add-page-titlebox ">
                    <span class="widget-caption add-page-title"><i class="glyphicon glyphicon-plus "></i>@this.ViewBag.Title</span>
                </div>
                <div class="widget-body " id="BaseDiv" runat="server">
                    <div class="options add-page-options">
                    <input type="submit" name="save" class="btn btn-blue " value="保存" />
                </div>
                    <div class="add-content ">
                        <div class="k-content k-state-active" id="customer-edit-1" role="tabpanel" aria-expanded="true" style="display: block;">
                            @Html.Partial("_CreateOrUpdateResearchComment", Model)
                           </div>
                        </div>
                </div>
            </div>
        </div>
    </div>
</div>

}

