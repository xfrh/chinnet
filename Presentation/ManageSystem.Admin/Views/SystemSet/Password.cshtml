@model ManageSystem.Admin.Models.SystemSet.PasswordModel
@using ManageSystem.Admin.Extensions;

@{
    //page title
    ViewBag.Title = "修改密码";
}

@section Breadcrumb{
    @{Html.RenderAction("Breadcrumb", "Shared", new Breadcrumb { MenuName = "系统管理", SecondName = "修改密码", LocationName = this.ViewBag.Title }); }
}

@Html.ValidationSummary(true)

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="page-body">
        <div class="row add-page">
            <div class="col-lg-12 col-sm-12 col-xs-12">
                <div class="widget ">
                    <div class="widget-header add-page-titlebox ">
                        <span class="widget-caption add-page-title"><i class="glyphicon glyphicon-plus "></i>@this.ViewBag.Title</span>
                    </div>
                    <div class="widget-body " id="BaseDiv" runat="server">

                        <div class="add-content ">

                            <div class="k-content k-state-active" id="customer-edit-1" role="tabpanel" aria-expanded="true" style="display: block;">

                                <table class="adminContent">
                                    <tbody>
                                        <tr>
                                            <td class="adminTitle">@Html.NopLabelFor(m => m.OldPassword)</td>
                                            <td class="adminData">
                                                @Html.PasswordFor(m => m.OldPassword, new { @class = "text-box single-line valid" })
                                                @Html.ValidationMessageFor(model => model.OldPassword)
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="adminTitle">@Html.NopLabelFor(m => m.NewPassword)</td>
                                            <td class="adminData">
                                                @Html.PasswordFor(m => m.NewPassword, new { @class = "text-box single-line valid" })
                                                @Html.ValidationMessageFor(model => model.NewPassword)
                                            </td>
                                        </tr>

                                        <tr>
                                            <td class="adminTitle">@Html.NopLabelFor(m => m.ConfirmPassword)</td>
                                            <td class="adminData">
                                                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "text-box single-line valid" })
                                                @Html.ValidationMessageFor(model => model.ConfirmPassword)
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                        </div>
                        <div class="options add-page-options" style="text-align:right">
                            <input type="submit" name="save" class="btn btn-blue " value="保存" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

}
