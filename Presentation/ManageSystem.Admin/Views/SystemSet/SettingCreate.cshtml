@model  ManageSystem.Admin.Models.Configuration.SettingModel
@{
    //page title
    ViewBag.Title ="添加系统配置";
}

@section Breadcrumb{
  @{Html.RenderAction("Breadcrumb", "Shared", new Breadcrumb { MenuName = "系统管理", SecondName = "系统配置（高级）", LocationName = this.ViewBag.Title }); }
}


@using (Html.BeginForm())
{
  @Html.AntiForgeryToken()

 <div class="page-body">
    <div class="row add-page">
        <div class="col-lg-12 col-sm-12 col-xs-12">
            <div class="widget ">
                <div class="widget-header add-page-titlebox ">
                    <span class="widget-caption add-page-title"><i class="glyphicon glyphicon-plus "></i>@this.ViewBag.Title</span>
                </div>
                <div class="widget-body " id="BaseDiv" runat="server">
                    <div class="options add-page-options">
                    <input type="submit" name="save" class="btn btn-blue " value="保存" />
                </div>
                    <div class="add-content ">
                        <div class="k-content k-state-active" id="customer-edit-1" role="tabpanel" aria-expanded="true" style="display: block;">
                        @Html.ValidationSummary(true)
                        @Html.HiddenFor(model => model.Id)

                         <table class="adminContent">
                            <tr>
                                <td class="adminTitle">@Html.NopLabelFor(m => m.Title)：</td>
                                <td class="adminData">
                                    @Html.EditorFor(m=>m.Title)
                                    @Html.ValidationMessageFor(m => m.Title)
                                </td>
                            </tr>
                            <tr>
                                <td class="adminTitle">@Html.NopLabelFor(m => m.Name)：</td>
                                <td class="adminData">
                                    @Html.EditorFor(m => m.Name)
                                    @Html.ValidationMessageFor(m => m.Name)
                                </td>
                            </tr>
                             <tr>
                                 <td class="adminTitle">@Html.NopLabelFor(m => m.Type)：</td>
                                 <td class="adminData">
                                     @Html.EditorFor(m => m.Type)
                                     @Html.ValidationMessageFor(m => m.Type)
                                 </td>
                             </tr>
                            <tr>
                                <td class="adminTitle">@Html.NopLabelFor(m => m.IsCache)：</td>
                                <td class="adminData">
                                    @Html.CheckBoxFor(m => m.IsCache, new { @class = "n-chk" })
                                    @Html.ValidationMessageFor(m => m.IsCache)
                                </td>
                            </tr>
                            <tr>
                                <td class="adminTitle">@Html.NopLabelFor(m => m.IsAdmin)：</td>
                                <td class="adminData">
                                    @Html.CheckBoxFor(m => m.IsAdmin, new { @class = "n-chk" })
                                    @Html.ValidationMessageFor(m => m.IsAdmin)
                                </td>
                            </tr>
                            <tr>
                                <td class="adminTitle">@Html.NopLabelFor(m => m.Value)：</td>
                                <td class="adminData">
                                    @Html.TextAreaFor(m => m.Value, new { @class = "form-control txt", cols = "30", rows = "3" })
                                    @Html.ValidationMessageFor(m => m.Value)
                                </td>
                            </tr>
                            <tr>
                                <td class="adminTitle"></td>
                                <td class="adminData"></td>
                            </tr>
                            <tr>
                                <td class="adminTitle">@Html.NopLabelFor(m => m.Describe)：</td>
                                <td class="adminData">
                                    @Html.TextAreaFor(model => model.Describe, new { @class = "form-control txt", cols = "30", rows = "3" })
                                    @Html.ValidationMessageFor(m => m.Describe)
                                </td>
                            </tr>
                        </table>

                           </div>
                        </div>
                </div>
            </div>
        </div>
    </div>
</div>

}

