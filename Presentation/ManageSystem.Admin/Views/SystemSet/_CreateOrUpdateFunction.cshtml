@model ManageSystem.Admin.Models.SystemSet.FunctionModel
@using ManageSystem.Admin.Extensions;

@Html.ValidationSummary(true)
@Html.HiddenFor(model => model.Id)


<table class="adminContent">
    <tr>
        <td class="adminTitle">@Html.NopLabelFor(m => m.Name)：</td>
        <td class="adminData">
            @Html.EditorFor(m => m.Name, new { htmlAttributes = new { @onkeydown = "keypresshandle(event);" } })
            @Html.ValidationMessageFor(m => m.Name)
        </td>
    </tr>
    <tr>
        <td class="adminTitle">@Html.NopLabelFor(m => m.Sort)：</td>
        <td class="adminData">
            @Html.EditorFor(m => m.Sort, new { htmlAttributes = new { @onkeydown = "keypresshandle(event);" } })
            @Html.ValidationMessageFor(m => m.Sort)
        </td>
    </tr>
    <tr>
        <td class="adminTitle">@Html.NopLabelFor(m => m.Url)：</td>
        <td class="adminData">
            @Html.EditorFor(m => m.Url, new { htmlAttributes = new { @onkeydown = "keypresshandle(event);" } })
        </td>
    </tr>
    <tr>
        <td class="adminTitle">@Html.NopLabelFor(m => m.Type)：</td>
        <td class="adminData">
            @Html.DropDownListFor(m => m.Type, Model.FunctionTypeList, new { @class = "form-control dropdown" })
            @Html.ValidationMessageFor(m => m.Type)
        </td>
    </tr>
    <tr>
        <td class="adminTitle">@Html.NopLabelFor(m => m.IsMenu)：</td>
        <td class="adminData">
             @Html.CheckBoxFor(m=>m.IsMenu, new{ @class= "n-chk" })
        </td>
    </tr>
    <tr>
        <td class="adminTitle">@Html.NopLabelFor(m => m.ControlId)：</td>
        <td class="adminData">
            @Html.EditorFor(m => m.ControlId, new { htmlAttributes = new { @onkeydown = "keypresshandle(event);" } })
        </td>
    </tr>
    <tr>
        <td class="adminTitle">@Html.NopLabelFor(m => m.Image)：</td>
        <td class="adminData">
            @Html.EditorFor(m => m.Image, new { htmlAttributes = new { @onkeydown = "keypresshandle(event);" } })
        </td>
    </tr>
    <tr>
        <td class="adminTitle">@Html.NopLabelFor(m => m.CustomClass)：</td>
        <td class="adminData">
            @Html.EditorFor(m => m.CustomClass, new { htmlAttributes = new { @onkeydown = "keypresshandle(event);" } })
        </td>
    </tr>
    <tr>
        <td class="adminTitle">@Html.NopLabelFor(m => m.FunctionId)：</td>
        <td class="adminData">
            @Html.DropDownListFor(model => model.FunctionId, Model.AvailableFunctions, new { @class = "form-control dropdown" })
            @Html.ValidationMessageFor(m => m.FunctionId)
        </td>
    </tr>
    <tr>
        <td class="adminTitle">@Html.NopLabelFor(m => m.Describe)：</td>
        <td class="adminData">
            @Html.TextAreaFor(model => model.Describe, new { @class = "form-control txt", cols = "30", rows = "3" })

        </td>
    </tr>
    <tr>
        <td class="adminTitle">@Html.NopLabelFor(m => m.CreateName)：</td>
        <td class="adminData">
            @Html.HiddenFor(m => m.CreateName)
            @Model.CreateName
        </td>
    </tr>

</table>

<script src="/Content/Scripts/TranTextBox.js"></script>
<script type="text/javascript">



</script>