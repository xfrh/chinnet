@model ManageSystem.Admin.Models.SystemSet.RoleModel
@{
    //page title
    ViewBag.Title ="编辑角色";
}

@section Breadcrumb{
    @{Html.RenderAction("Breadcrumb", "Shared", new Breadcrumb { MenuName = "系统管理", SecondName = "角色管理", LocationName = this.ViewBag.Title }); }
}


@using (Html.BeginForm())
{
  @Html.AntiForgeryToken()

 <div class="page-body">
    <div class="row add-page">
        <div class="col-lg-12 col-sm-12 col-xs-12">
            <div class="widget ">
                <div class="widget-header add-page-titlebox ">
                    <span class="widget-caption add-page-title"><i class="glyphicon glyphicon-plus "></i>@this.ViewBag.Title</span>
                </div>
                <div class="widget-body " id="BaseDiv" runat="server">

                    <div class="add-content ">
                        <div class="k-content k-state-active" id="customer-edit-1" role="tabpanel" aria-expanded="true" style="display: block;">
                            @Html.Partial("_CreateOrUpdateRole", Model)
                        </div>
                    </div>
                </div>
                <div class="options add-page-options" style="text-align:right">
                    <input type="submit" name="save" id="btnSave" class="btn btn-blue " value="保存" />
                </div>
            </div>
        </div>
    </div>
</div>


<script type="text/javascript">
    $(document).ready(function () {

        $('#btnSave').click(function (e) {

            //设置选择的功能id 集合
            var selectedIds = [];
            var chkList = $(".role-chk");
            for (var i = 0; i < chkList.length; i++) {
                if ($(chkList[i]).is(":checked") == true) {
                    var idValue = $(chkList[i]).val();
                    var checked = jQuery.inArray(idValue, selectedIds);
                    if (checked == -1) {
                        selectedIds.push(idValue);
                    }
                }
            }

            var ids = selectedIds.join(",");
            $("#@Html.FieldIdFor(m=>m.FunctionIds)").val(ids);
            $('#form1').submit();
        });

    });
</script>
}

