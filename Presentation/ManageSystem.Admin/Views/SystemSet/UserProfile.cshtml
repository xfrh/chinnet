@model ManageSystem.Admin.Models.SystemSet.UserProfileModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "个人中心";
}


@section Breadcrumb{
    @{Html.RenderAction("Breadcrumb", "Shared", new Breadcrumb { MenuName = "系统管理", SecondName = "系统管理", LocationName = this.ViewBag.Title }); }
}



@using (Html.BeginForm("UserProfile", "SystemSet", FormMethod.Post, new { id = "form1" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)
    @Html.HiddenFor(model => model.Id)


    <div class="page-body">
        <div class="row add-page">
            <div class="col-lg-12 col-sm-12 col-xs-12">
                <div class="widget ">
                    <div class="widget-header add-page-titlebox ">
                        <span class="widget-caption add-page-title"><i class="glyphicon glyphicon-plus "></i>@this.ViewBag.Title</span>
                    </div>
                    <div class="widget-body " id="BaseDiv" runat="server">

                        <div class="add-content ">
                            <div class="k-content k-state-active" id="customer-edit-1" role="tabpanel" aria-expanded="true" style="display: block;">
                                <!-- 修改个人信息-->
                                <div id="settings" class='tab-pane active '>
                                    <div class="form-title">
                                        基本信息（必填）
                                    </div>

                                    <div class="row">
                                        <div class="col-sm-6">
                                            <div class="form-group">
                                                <span class="input-icon icon-right">
                                                    @Model.LoginId
                                                </span>
                                            </div>
                                        </div>
                                        <div class="col-sm-6">
                                            <div class="form-group">
                                                <span class="input-icon icon-right">
                                                    @Html.TextBoxFor(m => m.Name, "", new { @class = "form-control txt", placeholder = "真实姓名" })
                                                    @Html.ValidationMessageFor(m => m.Name)
                                                    <i class="fa fa-user blue"></i>
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-title">
                                        其他信息（选填）
                                    </div>

                                    <div class="row">

                                        <div class="col-sm-6">
                                            <div class="form-group">
                                                <span class="input-icon icon-right">
                                                    @Html.TextBoxFor(m => m.NickName, "", new { @class = "form-control txt", placeholder = "昵称" })
                                                    <i class="fa fa-user orange"></i>
                                                </span>
                                            </div>
                                        </div>

                                        <div class="col-sm-6">
                                            <div class="form-group">
                                                <span class="input-icon icon-right">
                                                    @Html.TextBoxFor(m => m.Email, "", new { @class = "form-control txt", placeholder = "邮箱地址" })
                                                    <i class="fa  fa-comments orange"></i>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-sm-6">
                                            <div class="form-group">
                                                <span class="input-icon icon-right">
                                                    @Html.TextBoxFor(m => m.Phone, "", new { @class = "form-control txt", placeholder = "手机号码" })
                                                    <i class="glyphicon glyphicon-earphone yellow"></i>
                                                </span>
                                            </div>
                                        </div>
                                        <div class="col-sm-6">
                                            <div class="form-group">
                                                <div class="radio" style="float: left; width: 80px">
                                                    <label style="padding-left: 0px;">
                                                        @Html.RadioButtonFor(m => m.Sex, 2, new { @class = "colored-blue" })
                                                        <span class="text">男性</span>
                                                    </label>
                                                </div>
                                                <div class="radio" style="float: left; margin-top: 10px; width: 80px">
                                                    <label style="padding-left: 0px;">
                                                        @Html.RadioButtonFor(m => m.Sex, 1, new { @class = "colored-danger" })
                                                        <span class="text">女性</span>
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                                <!-- 修改个人信息-->
                            </div>
                        </div>
                    </div>
                    <div class="options add-page-options" style="text-align:right">
                        <input type="submit" name="save" id="btnSave" class="btn btn-blue " value="保存" />
                    </div>
                </div>
            </div>
        </div>
    </div>

}



<script type="text/javascript">

</script>
