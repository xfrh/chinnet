@model  ManageSystem.Admin.Models.SystemSet.ScheduleTaskModel

    @{
        ViewBag.Title = "计划任务";


        bool IsEdit = UserinfoExtensions.CheckFunction(Url.Action("ScheduleTaskEdit"));
        bool IsView = UserinfoExtensions.CheckFunction(Url.Action("ScheduleTaskView"));
        bool IsRun= UserinfoExtensions.CheckFunction(Url.Action("ScheduleTaskRun"));
        string RunHtml = IsRun ? "&nbsp;&nbsp;<a href=\"/SystemSet/ScheduleTaskRun?Id=#=Id#\" >运行</a>" : "";
    }

    @section HeadSection {
    }

    @section Breadcrumb{
        @{Html.RenderAction("Breadcrumb", "Shared", new Breadcrumb { MenuName = "系统管理", SecondName = "计划任务", LocationName = this.ViewBag.Title }); }
    }

    @Html.AntiForgeryToken()

    <div class="page-body">

        <div class="row manage-page">
            <div class="col-xs-12 col-md-12">
                <div class="widget">
                    <div class="widget-header bordered-bottom bordered-yellow manage-title-box">
                        <span class="widget-caption manage-title"><i class="glyphicon glyphicon-th "></i>@ViewBag.Title </span>
                        <div class="widget-buttons">
                            <a href="#" data-toggle="maximize"><i class="fa fa-expand"></i></a>
                            <a href="#" data-toggle="collapse"><i class="fa fa-minus"></i></a>
                        </div>
                    </div>

                    <div class="widget-body">
                        <div role="grid" id="searchable_wrapper" class="dataTables_wrapper form-inline">

                            <div id="searchable_filter" class="dataTables_filter manage-but-box">
                                <div style="width: 100%;">
                                
                                </div>
                                <div style="width: 100%;">
                                    <div class="dataTables_filter manage-but-box">
                                        <label class="lb-left">@Html.NopLabelFor(model => model.Name)：</label>
                                        <label class="lb-right"><input type="text" id="input-search" class="form-control input-sm  search" aria-controls="searchable" name="searchKey" /></label>
                                        <label> <input type="button" id="btn-search" class="btn btn-blue" value="查 询" /> </label>
                                    </div>
                                </div>
                            </div>
                            <div class="table table-striped table-bordered dataTable no-footer table-select" id="ManageTableDiv" aria-describedby="editabledatatable_info">
                                <div id="data-grid"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>



    <script>
        $(document).ready(function () {

            $("#data-grid").kendoGrid({
                dataSource: {
                    type: "json",
                    transport: {
                        read: {
                            url: "@Html.Raw(Url.Action("ScheduleTaskList"))",
                            type: "POST",
                            dataType: "json",
                            data: additionalData
                        }
                    },

                    schema: {
                        data: "Data",
                        total: "Total",
                        errors: "Errors"
                    },
                    error: function (e) {
                        display_kendoui_grid_error(e);
                        // Cancel the changes
                        this.cancelChanges();
                    },
                    pageSize: 10,
                    serverPaging: true,
                    serverFiltering: true,
                    serverSorting: true

                },
                pageable: {
                    refresh: true,
                    pageSizes: [10, 30, 50]
                },
                scrollable: false,
                groupable: true,
                dataBound: onDataBound,
                columns: [
                {
                    field: "Name",
                    title: "计划任务名称"
                },
                  {
                      field: "Seconds",
                      title: "运行时间(秒)",
                      width: 200
                  },
               {
                   field: "Enabled",
                   title: "是否启用",
                   width: 200
               },

            {
                field: "StopOnError",
                title: "发生错误停止",
                width: 150
            },
                  {
                      field: "LastStartUtc",
                      title: "最后开始时间",
                      width: 150
                  },
                        {
                            field: "LastEndUtc",
                            title: "最后完成时间",
                            width: 150
                        },
            {
                field: "LastSuccessUtc",
                title: "最后成功时间",
                width: 150,
            },
                {
                    field: "Id",
                    title: "操作",
                    width: 150,
                    template: "@Html.KendoUIEditAndView(IsView, "ScheduleTaskView", IsEdit, "ScheduleTaskEdit")" + '@Html.Raw(RunHtml) '
                }]
            });
        });


        //设置查询参数
        function additionalData() {
            var data = {
                Name: $("#input-search").val()
            };

            addAntiForgeryToken(data);
            return data;
        }

    </script>

    <script src="~/Content/Scripts/admin.listpage.js"></script>
