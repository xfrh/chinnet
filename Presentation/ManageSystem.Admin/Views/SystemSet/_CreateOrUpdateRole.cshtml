@model ManageSystem.Admin.Models.SystemSet.RoleModel
@using ManageSystem.Admin.Extensions;

@Html.ValidationSummary(true)
@Html.HiddenFor(model => model.Id)
@Html.HiddenFor(model => model.FunctionIds)

<style type="text/css">
    .role-page-div .f-div {
        margin: 20px 0px;
        border: 1px solid #ccc;
        padding: 10px;
    }

    .role-page-div .f-item li {
        float: left;
        text-decoration: none;
        list-style: none;
        padding: 0px 5px;
        width: auto;
        margin-right: 10px;
    }

    .role-page-div .m-item {
        float: left;
        width: 100%;
        margin-bottom: 10px;
        padding-left: 20px;
    }

    .role-page-div .m-check {
        text-align: center;
        float: left;
    }

    .role-page-div .m-item h5 {
        font-size: 14px;
    }

    .role-page-div .role-title {
    border-bottom:1px solid #ccc; font-size:16px; padding:10px 0px; font-weight:bold;
    }
    .role-page-div ul {
        height: auto;
        width: 100%;
        float: left;
        padding-left: 20px;
    }

    .role-page-div li {
        text-decoration: none;
        list-style: none;
        padding: 0px 5px;
        width: 100%;
        margin-right: 10px;
        line-height: 30px;
        float: left;
    }


    .role-page-div .role-li {
        float: left;
        width: auto;
    }
</style>
<table class="adminContent">
    <tr>
        <td class="adminTitle">@Html.NopLabelFor(m => m.Name)：</td>
        <td class="adminData">
            @Html.EditorFor(m => m.Name, new { htmlAttributes = new { @onkeydown = "keypresshandle(event);" } })
            @Html.ValidationMessageFor(m => m.Name)
        </td>
    </tr>
    <tr>
        <td class="adminTitle">@Html.NopLabelFor(m => m.SatelliteId)：</td>
        <td class="adminData">
            @Html.DropDownList("SatelliteId", Model.SatelliteList, new { @class = "form-control dropdown" })
            @Html.ValidationMessageFor(m => m.SatelliteList)
        </td>
    </tr>
    <tr>
        <td class="adminTitle">@Html.NopLabelFor(m => m.Sort)：</td>
        <td class="adminData">

            @Html.EditorFor(m => m.Sort, new { htmlAttributes = new { @onkeydown = "keypresshandle(event);" } })
            @Html.ValidationMessageFor(m => m.Sort)
        </td>
    </tr>
    <tr>
        <td class="adminTitle">@Html.NopLabelFor(m => m.Describe)：</td>
        <td class="adminData">
            @Html.TextAreaFor(model => model.Describe, new { @class = "form-control txt", cols = "30", rows = "3" })
        </td>
    </tr>
    <tr>
        <td class="adminTitle">@Html.NopLabelFor(m => m.CreateName)：</td>
        <td class="adminData">
            @Html.HiddenFor(m => m.CreateName)
            @Model.CreateName
        </td>
    </tr>
    <tr>
        <td class="adminData" colspan="2"></td>
    </tr>
</table>

<div class="role-page-div">
    <p class="role-title">分配权限</p>

    @Html.Raw(Model.FunctionHtml)

    <div class="clearfix"></div>

</div>

<script src="/Content/Scripts/TranTextBox.js"></script>
<script type="text/javascript">

    $(document).ready(function () {

        $(".role-chk").change(function () {
            var li = $(this).parents("li")[0];
            var list = $(li).find(".role-chk");
            $(li).find(".role-chk").attr('checked', $(this).attr('checked'));
        });
    });


</script>