@model  ManageSystem.Admin.Models.Products.ProductModel

@{
    ViewBag.Title = "商品";
	bool IsEdit = UserinfoExtensions.CheckFunction(Url.Action("ProductEdit"));
    bool IsView = UserinfoExtensions.CheckFunction(Url.Action("ProductView"));
}

@section HeadSection {
}


@section Breadcrumb{
    @{Html.RenderAction("Breadcrumb", "Shared", new Breadcrumb { MenuName = "商品管理", SecondName = "商品管理", LocationName = this.ViewBag.Title }); }
}

@Html.AntiForgeryToken()

<div class="page-body">

    <div class="row manage-page">
        <div class="col-xs-12 col-md-12">
            <div class="widget">
                <div class="widget-header bordered-bottom bordered-yellow manage-title-box">
                    <span class="widget-caption manage-title"><i class="glyphicon glyphicon-th "></i>@ViewBag.Title </span>
                    <div class="widget-buttons">
                        <a href="#" data-toggle="maximize"><i class="fa fa-expand"></i></a>
                        <a href="#" data-toggle="collapse"><i class="fa fa-minus"></i></a>
                    </div>
                </div>

                <div class="widget-body">
                    <div role="grid" id="searchable_wrapper" class="dataTables_wrapper form-inline">

                        <div id="searchable_filter" class="dataTables_filter manage-but-box">
                            <div style="width: 100%;">
							     @Html.ButtonHtml(HtmlButtonType.Add, "ProductCreate", "Products")
                                @Html.ButtonHtml(HtmlButtonType.Delete, "ProductDelete", "Products")
                            </div>
                            <div style="width: 100%;">
                                <div class="dataTables_filter manage-but-box">
                                   <label class="lb-left">@Html.NopLabelFor(model => model.Name)：</label>
                                    <label class="lb-right"><input type="text" id="Name" class="form-control input-sm  search"  /></label>
                                    <label class="lb-left">@Html.NopLabelFor(m => m.Status)：</label>
                                    <div class="form-control ddl lb-right " style="width: 10%;">    @Html.DropDownList("Status", Model.StatusList, new { @class = "form-control dropdown" })   </div>
                                    <label class="lb-left">@Html.NopLabelFor(m => m.ProductCategoryId)：</label>
                                    <div class="form-control ddl lb-right " style="width: 10%;">    @Html.DropDownList("ProductCategoryId", Model.ProductCategoryList, new { @class = "form-control dropdown" })   </div>
                                    <label class="lb-left">@Html.NopLabelFor(m => m.ProductBrandId)：</label>
                                    <div class="form-control ddl lb-right " style="width: 10%;">    @Html.DropDownList("ProductBrandId", Model.ProductBrandList, new { @class = "form-control dropdown" })   </div>

                                      <label> <input type="button" id="btn-search" class="btn btn-blue" value="查 询" /> </label>
                                </div>
                            </div>
                        </div>
                        <div class="table table-striped table-bordered dataTable no-footer table-select" id="ManageTableDiv" aria-describedby="editabledatatable_info">
                            <div id="data-grid"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@*删除数据的表单*@
@using (Html.BeginForm("ProductDelete", "Products", FormMethod.Post, new { id = "delete-selected-form" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" id="selectedIds" name="selectedIds" value="" />

}

<script>
    $(document).ready(function () {

        $("#data-grid").kendoGrid({
            dataSource: {
                type: "json",
                transport: {
                    read: {
                        url: "@Html.Raw(Url.Action("ProductList"))",
                        type: "POST",
                        dataType: "json",
                        data: additionalData
                    }
                },

                schema: {
                    data: "Data",
                    total: "Total",
                    errors: "Errors"
                },
                error: function (e) {
                    display_kendoui_grid_error(e);
                    // Cancel the changes
                    this.cancelChanges();
                },
                pageSize: 10,
                serverPaging: true,
                serverFiltering: true,
                serverSorting: true

            },
            pageable: {
                refresh: true,
                pageSizes: [10,30,50]
            }, 
            scrollable: false,
            groupable: true,
            dataBound: onDataBound,
            columns: [{
                field: "Id",
                headerTemplate: "  <div class='' style='text-align: center;'>    <label><input type='checkbox' id='mastercheckbox' /><span class='text'></span> </label>   </div>",
                headerAttributes: { style: "text-align:center" },
                attributes: { style: "text-align:center" },
                template: " <div class='' style='text-align: center;'>    <label><input type='checkbox' class='checkboxGroups'  value='#=Id#' /><span class='text'></span> </label>   </div> ",
                width: 50
            },
            	{
            	    field: "InsertTime",
            	    title: "创建时间",
            	    width: 130
            	},
             		{
             		    field: "Name",
			title: "商品名称"
		},
		{
			field: "Status",
			title: "状态",
			width: 80
		},
		{
		    field: "ProductCategoryName",
			title: "商品分类",
			width: 200
		},
		{
		    field: "ProductBrandName",
			title: "商品品牌",
			width: 200
		},
		{
			field: "Code",
			title: "商品编码",
			width: 100
		},
		{
			field: "CostPrice",
			title: "商品成本价",
			width: 80
		},
		{
			field: "MarketPrice",
			title: "商品市场价",
			width: 80
		},
		{
			field: "Count",
			title: "库存数量",
			width: 80
		},

            {
                field: "Id",
                title: "操作",
                width: 150,
				template: "@Html.KendoUIEditAndView(IsView, "ProductView", IsEdit, "ProductEdit")" 
            }]
        });
    });


    //设置查询参数
    function additionalData() {
        var data = {
            Name: $("#Name").val(),
            Status: $("#@Html.FieldNameFor(m=>m.Status)").val(),
            ProductCategoryId: $("#@Html.FieldNameFor(m=>m.ProductCategoryId)").val(),
            ProductBrandId: $("#@Html.FieldNameFor(m=>m.ProductBrandId)").val()
        };

        addAntiForgeryToken(data);
        return data;
    }

</script>


<script src="~/Content/Scripts/admin.listpage.js"></script>