@{
    ViewBag.Title = "细菌列表";
}
@section HeadSection {
    <style>
        ul.dataTables_filter,
        ul.dataTables_filter li {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        ul.dataTables_filter {
            display: -webkit-box;
            display: -webkit-flex;
            display: -moz-box;
            display: -ms-flexbox;
            display: flex;
            -webkit-box-align: center;
            -webkit-align-items: center;
            -moz-box-align: center;
            -ms-flex-align: center;
            align-items: center;
            -webkit-flex-wrap: wrap;
            -ms-flex-wrap: wrap;
            flex-wrap: wrap;
        }

            ul.dataTables_filter li {
                margin-right: 15px;
                margin-bottom: 10px;
            }

                ul.dataTables_filter li:last-child {
                    margin-right: 0;
                }
    </style>
}

@section Breadcrumb{
    @{Html.RenderAction("Breadcrumb", "Shared", new Breadcrumb { MenuName = "CRE专项检测", SecondName = "细菌列表", LocationName = this.ViewBag.Title }); }
}

@Html.AntiForgeryToken()

<div class="page-body">

    <div class="row manage-page">
        <div class="col-xs-12 col-md-12">
            <div class="widget">
                <div class="widget-header bordered-bottom bordered-yellow manage-title-box">
                    <span class="widget-caption manage-title"><i class="glyphicon glyphicon-th "></i>@ViewBag.Title</span>
                    <div class="widget-buttons">
                        <a href="#" data-toggle="maximize"><i class="fa fa-expand"></i></a>
                        <a href="#" data-toggle="collapse"><i class="fa fa-minus"></i></a>
                    </div>
                </div>

                <div class="widget-body">
                    <div role="grid" id="searchable_wrapper" class="dataTables_wrapper form-inline">

                        <div id="searchable_filter" class="dataTables_filter manage-but-box">
                            <div style="width: 100%;">
                                <a class="btn btn-purple" href="/CREProject/CreateBacteria">添 加</a>
                                @*<input type="button" value="删 除" class="btn btn-danger" id="btn-delete">*@
                                @*<button class="btn btn-palegreen" type="button" id="Release">发布</button>
                                    <button class="btn btn-palegreen" type="button" id="Norelease">取消发布</button>*@
                            </div>
                            <div style="width: 100%;">
                                <div class="dataTables_filter manage-but-box">
                                    <label class="lb-left">细菌名称：</label>
                                    <label class="lb-right"><input type="text" id="Germ_name" class="form-control input-sm  search" style="width:100%;" /></label>
                                    @*<label class="lb-left">添加人姓名：</label>
                                        <label class="lb-right"><input type="text" id="Created_by" class="form-control input-sm  search" style="width:100%;" /></label>
                                        <label class="lb-left">年度：</label>*@
                                    @*<label class="lb-left">@Html.NopLabelFor(model => model.)：</label>*@
                                    @*<label class="lb-right"><input type="text" id="Data_year" class="form-control input-sm  search" style="width:100%;" /></label>*@

                                    <label> <input type="button" id="btn-search" class="btn btn-blue" value="查 询" /> </label>
                                </div>
                            </div>
                        </div>
                        <div class="table table-striped table-bordered dataTable no-footer table-select" id="ManageTableDiv" aria-describedby="editabledatatable_info">
                            <div id="data-grid"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@*删除细菌*@
@using (Html.BeginForm("CREBacteriaDelete", "CREProject", FormMethod.Post, new { id = "delete-selected-form" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" id="selectedIds" name="selectedIds" value="" />

}
<script>
    $(document).ready(function () {

        $("#data-grid").kendoGrid({
            dataSource: {
                type: "json",
                transport: {
                    read: {
                        url: "@Html.Raw(Url.Action("BacteriaList"))",
                        type: "POST",
                        dataType: "json",
                        data: additionalData
                    }
                },

                schema: {
                    data: "Data",
                    total: "Total",
                    errors: "Errors"
                },
                error: function (e) {
                    display_kendoui_grid_error(e);
                    // Cancel the changes
                    this.cancelChanges();
                },
                pageSize: 10,
                serverPaging: true,
                serverFiltering: true,
                serverSorting: true

            },
            pageable: {
                refresh: true,
                pageSizes: [10, 30, 50]
            },
            scrollable: true,
            groupable: true,
            dataBound: onDataBound,
            columns: [{
                field: "Germ_id",
                headerTemplate: "  <div class='' style='text-align: center;'>    <label><input type='checkbox' id='mastercheckbox' /><span class='text'></span> </label>   </div>",
                headerAttributes: { style: "text-align:center" },
                attributes: { style: "text-align:center" },
                template: " <div class='' style='text-align: center;'>    <label><input type='checkbox' class='checkboxGroups'  value='#=Germ_id#' /><span class='text'></span> </label>   </div> ",
                width: 50
            },
            //{
            //    field: "Data_id",
            //    title: "ID",
            //    width: 110
            //},
            {
                field: "Germ_name",
                title: "细菌名称",
                width: 110
                },
             {
                field: "Germ_upload_name",
                title: "细菌上传名称",
                width: 110
                },
            {
                field: "Cr_name",
                title: "耐药名称",
                width: 150
                },
             {
                field: "Ger_code",
                title: "耐药Code",
                width: 70
                },
            {
                field: "Sortid",
                title: "排序",
                width: 70
                },
             {
                field: "Allow_data_upload",
                title: "是否允许数据上传",
                width: 70
                },
             {
                field: "allow_edit",
                title: "是否允许修改",
                width: 70
                },
              {
                field: "Allow_report_display",
                title: "是否在热图上显示",
                width: 70
                },
              {
                field: "InsrtTime",
                title: "添加时间",
                width: 80
                },
            {
                field: "Germ_id",
                title: "操作",
                width: 70,
                template: "<a href='/CREProject/Bacteriadetails/#=Germ_id#'>详情</a>&nbsp;&nbsp;<a href='/CREProject/BacteriaEdit/#=Germ_id#'>编辑</a>"
            }
            ]
        });
    });
        //设置查询参数
    function additionalData() {
        var data = {
            Germ_name: $("#Germ_name").val(),           
        };

        addAntiForgeryToken(data);
        return data;
    }
</script>
<script src="~/Content/Scripts/admin.listpage.js"></script>