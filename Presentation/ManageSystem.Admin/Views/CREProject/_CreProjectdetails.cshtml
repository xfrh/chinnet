                    <input class="n-chk" id="Two" name="Two" type="checkbox" checked="checked" value="(2) 改良Hodge试验">
                }
                else
                {
                    <input class="n-chk" id="Two" name="Two" type="checkbox" value="(2) 改良Hodge试验">
                }
            </td>
        </tr>
        <tr>
