        <tr>
            <td class="adminTitle">药敏试验是否常规报告CRE所产碳青霉烯酶型别：</td>
            <td class="adminData">
                <div class="post_main_r">
                    <select id="whether" onchange="whether()" class="select-area-ddl">
                        <option value="0">否</option>
                        <option value="1">是</option>
                    </select>
                    <select id="mode" onchange="mode()" class="select-area-ddl">
                        <option value="">-- 请选择 --</option>
                        <option value="口头沟通报告">口头沟通报告</option>
                        <option value="报告中标注">报告中标注</option>
                    </select>
                </div>
                <span class="field-validation-error" id="modewhether" hidden="hidden"></span>
            </td>
        </tr>
        <tr>
            <td class="adminTitle">实验室检测碳青霉烯酶的方法：</td>
            @*<td class="adminData">
                @Html.EditorFor(m => m.Email)
                @Html.ValidationMessageFor(m => m.Email)
            </td>*@
        </tr>
        <tr>
            <td class="adminTitle">(1) 仅以药敏试验结果判断CRE：</td>
            <td class="adminData">
                @if (Model.Sensitive != "")
                {
                <input class="n-chk"id="One" name="One" type="checkbox" checked="checked" value="(1)仅以药敏试验结果判断CRE">
                }
                else
                { 
                   <input class="n-chk" id="One" name="One" type="checkbox" value="(1)仅以药敏试验结果判断CRE">
                }
            </td>
        </tr>
        <tr>
            <td class="adminTitle">(2) 改良Hodge试验：</td>
            <td class="adminData">
                @if (Model.Hodge != "")
