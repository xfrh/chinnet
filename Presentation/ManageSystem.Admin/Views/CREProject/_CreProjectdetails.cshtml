@model ManageSystem.Core.Domain.Cre.Toconfigure
@using ManageSystem.Admin.Extensions;
@Html.ValidationSummary(true)
@Html.HiddenFor(model => model.Cre_id)

    <style>
        .select-area-ddl {
            width: 28.5% !important;
            border: 1px solid #d9d9d9 !important;
            color: #444 !important;
        }

        .post_main_r {
            width: 82%;
        }
    </style>

    <table class="adminContent">

        <tr class="insert-time-tr" style="display:none;">
            <td class="adminTitle">上传时间：</td>
            <td class="adminData">
                @Model.Created.ToString()
            </td>
        </tr>
        <tr class="insert-time-tr" style="display:none;">
            <td class="adminTitle">修改时间：</td>
            <td class="adminData">
                @Model.Modified.ToString()
            </td>
        </tr>
        <tr>
            <td class="adminTitle">医院名称：</td>
            <td class="adminData">
                @Html.EditorFor(m => m.Hospital, new { htmlAttributes = new { @onkeydown = "keypresshandle(event);" } })              
            </td>
        </tr>
        <tr>
            <td class="adminTitle">省市区：</td>
            <td class="adminData">
                <div class="post_main_r">
                    @Html.Partial("~/Views/PartialView/_SelectArea.cshtml")
                </div>
                @Html.HiddenFor(a => a.Province_id)
                @Html.HiddenFor(a => a.City_id)
                @Html.HiddenFor(a => a.District_id)
                @*@Html.HiddenFor(a => a.Area)*@
            </td>
        </tr>
        <tr>
            <td class="adminTitle">详细地址：</td>
            <td class="adminData">
                @Html.EditorFor(m => m.Detailedaddress, new { htmlAttributes = new { @onkeydown = "keypresshandle(event);" } })
                @Html.ValidationMessageFor(m => m.Detailedaddress)
            </td>
        </tr>
        <tr>
            <td class="adminTitle">负责人：</td>
            <td class="adminData">
                @Html.EditorFor(m => m.Contact, new { htmlAttributes = new { @onkeydown = "keypresshandle(event);" } })
                @Html.ValidationMessageFor(m => m.Contact)
            </td>
        </tr>
        <tr>
            <td class="adminTitle">联系电话：</td>
            <td class="adminData">
                @Html.EditorFor(m => m.Mobile, new { htmlAttributes = new { @onkeydown = "keypresshandle(event);" } })
                @Html.ValidationMessageFor(m => m.Mobile)
            </td>
        </tr>


        <tr>
            <td class="adminTitle">邮箱地址：</td>
            <td class="adminData">
                @Html.EditorFor(m => m.Email, new { htmlAttributes = new { @onkeydown = "keypresshandle(event);" } })
                @Html.ValidationMessageFor(m => m.Email)
            </td>
        </tr>
        <tr>
            <td class="adminTitle">上报所属年份：</td>
            <td class="post_main_r">
                @Html.HiddenFor(a => a.Data_year)
                <select id="year"style="width:1008px;border: 1px solid #d9d9d9;color: #444">
                    <option value="2019">2019年</option>
                    <option value="2020">2020年</option>
                </select>

            </td>
        </tr>
        <tr>
            <td class="adminTitle">上报所属季度：</td>
            <td class="post_main_r">
                @Html.HiddenFor(a => a.Data_season)
                <select id="season" style="width:1008px;border: 1px solid #d9d9d9;color: #444" onchange="SelectCallBack()">
                    <option value="1">第一季度（1月-3月）</option>
                    <option value="2">第二季度（4月-6月）</option>
                    <option value="3">第三季度（7月-9月）</option>
                    <option value="4">第四季度（10月-12月）</option>
                </select>

            </td>
        </tr>
        <tr>
            <td class="adminTitle">细菌名称：</td>
            <td class="adminData">              
                @Html.DropDownList("Germ", Model.BacteriafenlList, new { @class = "form-control dropdown" })
                @*@Html.ValidationMessageFor(m => m.BacteriafenlList)*@
            </td>
        </tr>
        <tr>
            <td class="adminTitle">细菌检出株数：</td>
            <td class="adminData">
                @Html.EditorFor(m => m.Germ_detected, new { htmlAttributes = new { @onkeydown = "keypresshandle(event);" } })
                @Html.ValidationMessageFor(m => m.Germ_detected)
            </td>
        </tr>
        <tr>
            <td class="adminTitle">耐药检出株数：</td>
