@model  ManageSystem.Admin.Models.CRs.CRDataModel
@{
    //page title
    ViewBag.Title = "查看数据";
}

@section Breadcrumb{
    @{Html.RenderAction("Breadcrumb", "Shared", new Breadcrumb { MenuName = "CR项目信息", SecondName = "数据管理", LocationName = this.ViewBag.Title }); }
}

<style>
    .col-lg-10 {
        width: 60%;
    }

    .add-page .add-content label {
        width: 180px;
    }

    .input-no {
        background-color: #f3f3f3;
    }
</style>
<div class="page-body">
    <div class="row add-page">
        <div class="col-lg-12 col-sm-12 col-xs-12">
            <div class="widget ">
                <div class="widget-header add-page-titlebox ">
                    <span class="widget-caption add-page-title"><i class="glyphicon glyphicon-plus "></i>@this.ViewBag.Title</span>
                </div>

                <div class="widget-body add-content " style="padding-top: 30px;">
                    <div class="form-horizontal bv-form">


                        <div>
                            <div class="widget-main ">
                                <div class="tabbable">
                                    <ul class="nav nav-tabs tabs-flat" id="myTab11" style="font-size: 14px;">
                                        <li class="active">
                                            <a data-toggle="tab" href="#SystemDiv">
                                                基本信息
                                            </a>
                                        </li>
                                        <li class="">
                                            <a data-toggle="tab" href="#SEODiv">
                                                上传数据
                                            </a>
                                        </li>
                                        <li class="">
                                            <a data-toggle="tab" href="#EmailDiv">
                                                操作日志
                                            </a>
                                        </li>

                                    </ul>
                                    <div class="tab-content tabs-flat" style="background-color: white; padding: 30px 12px; min-height: 350px;">
                                        <input type="hidden" id="id" value="@Model.Id" />
                                        <!-- 基本信息 -->
                                        <div id="SystemDiv" class="tab-pane active">

                                            <div class="row">
                                                <div class="col-sm-6">
                                                    <div class="form-group has-feedback">
                                                        <label class="col-lg-2 control-label">提交时间</label>
                                                        <div class="col-lg-10">
                                                            @Html.TextBox("InsertTime", Model.InsertTime, new { @class = "form-control txt", placeholder = "提交时间" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-sm-6">
                                                    <div class="form-group has-feedback">
                                                        <label class="col-lg-2 control-label">修改时间</label>
                                                        <div class="col-lg-10">
                                                            @Html.TextBox("UpdateTime", Model.UpdateTime, new { @class = "form-control txt", placeholder = "修改时间" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-sm-6">
                                                    <div class="form-group has-feedback">
                                                        <label class="col-lg-2 control-label">用户账号</label>
                                                        <div class="col-lg-10">
                                                            @Html.TextBox("MemberId", Model.LoginId, new { @class = "form-control txt", placeholder = "用户账号" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-sm-6">
                                                    <div class="form-group has-feedback">
                                                        <label class="col-lg-2 control-label">用户姓名</label>
                                                        <div class="col-lg-10">
                                                            @Html.TextBox("MemberName", Model.MemberName, new { @class = "form-control txt", placeholder = "用户姓名" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-sm-6">
                                                    <div class="form-group has-feedback">
                                                        <label class="col-lg-2 control-label">医院名称</label>
                                                        <div class="col-lg-10">
                                                            @Html.TextBox("HospitalName", Model.HospitalName, new { @class = "form-control txt", placeholder = "医院名称" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-sm-6">
                                                    <div class="form-group has-feedback">
                                                        <label class="col-lg-2 control-label">医院等级</label>
                                                        <div class="col-lg-10">
                                                            @Html.TextBox("HospitalGrade", Model.HospitalGrade, new { @class = "form-control txt", placeholder = "医院等级" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-sm-6">
                                                    <div class="form-group has-feedback">
                                                        <label class="col-lg-2 control-label">年度</label>
                                                        <div class="col-lg-10">
                                                            @Html.TextBox("Year", Model.Year, new { @class = "form-control txt", placeholder = "年度" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-sm-6">
                                                    <div class="form-group has-feedback">
                                                        <label class="col-lg-2 control-label">季度</label>
                                                        <div class="col-lg-10">
                                                            @Html.TextBox("Quarter", Model.Quarter, new { @class = "form-control txt", placeholder = "季度" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-sm-6">
                                                    <div class="form-group has-feedback">
                                                        <label class="col-lg-2 control-label">省市区</label>
                                                        <div class="col-lg-10">
                                                            @Html.TextBox("Area", Model.Area, new { @class = "form-control txt", placeholder = "省市区" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-sm-6">
                                                    <div class="form-group has-feedback">
                                                        <label class="col-lg-2 control-label">详细地址</label>
                                                        <div class="col-lg-10">
                                                            @Html.TextBox("Address", Model.Address, new { @class = "form-control txt", placeholder = "详细地址" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-sm-6">
                                                    <div class="form-group has-feedback">
                                                        <label class="col-lg-2 control-label">上年CRE平均检出率</label>
                                                        <div class="col-lg-10">
                                                            @Html.TextBox("CREDetectionRate", Model.CREDetectionRate, new { @class = "form-control txt", placeholder = "上年CRE平均检出率" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-sm-6">
                                                    <div class="form-group has-feedback">
                                                        <label class="col-lg-2 control-label">上年CRAB平均检出率</label>
                                                        <div class="col-lg-10">
                                                            @Html.TextBox("CREDrugRate", Model.CREDrugRate, new { @class = "form-control txt", placeholder = "上年CRAB平均检出率" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-sm-6">
                                                    <div class="form-group has-feedback">
                                                        <label class="col-lg-2 control-label">MH平板来源厂家</label>
                                                        <div class="col-lg-10">
                                                            @if (string.IsNullOrWhiteSpace(Model.MHSource))
                                                            {
                                                                @Html.TextBox("MHSource", Model.MHSource, new { @class = "form-control txt", placeholder = "-" })
                                                            }
                                                            else
                                                            {
                                                                @Html.TextBox("MHSource", Model.MHSource, new { @class = "form-control txt", placeholder = "MH平板来源厂家" })
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-sm-6">
                                                    <div class="form-group has-feedback">
                                                        <label class="col-lg-2 control-label">微生物负责人</label>
                                                        <div class="col-lg-10">
                                                            @Html.TextBox("Name", Model.Name, new { @class = "form-control txt", placeholder = "微生物负责人" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-sm-6">
                                                    <div class="form-group has-feedback">
                                                        <label class="col-lg-2 control-label">联系电话</label>
                                                        <div class="col-lg-10">
                                                            @Html.TextBox("Phone", Model.Phone, new { @class = "form-control txt", placeholder = "联系电话" })
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-sm-6">
                                                    <div class="form-group has-feedback">
                                                        <label class="col-lg-2 control-label">上传文件</label>
                                                        <div class="col-lg-10">
                                                            <a style="height: 34px;line-height:34px;" href="@Model.UploadFilePath">@Model.FileName</a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-sm-6">
                                                    <div class="form-group has-feedback">
                                                        <label class="col-lg-2 control-label">邮箱地址</label>
                                                        <div class="col-lg-10">
                                                            @Html.TextBox("Email", Model.Email, new { @class = "form-control txt", placeholder = "邮箱地址" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-sm-6">
                                                    <div class="form-group has-feedback">
                                                        <label class="col-lg-2 control-label">邮件通知</label>
                                                        <div class="col-lg-10">
                                                            @if (Model.EmailStatus == 2)
                                                            {
                                                                <input class="form-control txt" type="text" value="已发送">
                                                            }
                                                            else if (Model.EmailStatus == 3)
                                                            {
                                                                <input class="form-control txt" type="text" value="已确认">
                                                            }
                                                            else
                                                            {
                                                                <input class="form-control txt" type="text" value="未发送">
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-sm-6">
                                                    <div class="form-group has-feedback">
                                                        <label class="col-lg-2 control-label">医院邮件确认</label>
                                                        <div class="col-lg-10">
                                                            @if (Model.EmailStatus == 3)
                                                            {
                                                                <input class="form-control txt" type="text" value="已确认">
                                                            }
                                                            else
                                                            {
                                                                <input class="form-control txt" type="text" value="未确认">
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>

                                        <!-- 上传数据 -->
                                        <div id="SEODiv" class="tab-pane">
                                            <div class="table table-striped table-bordered dataTable no-footer table-select" id="ManageTableDiv" aria-describedby="editabledatatable_info">
                                                <div id="data-grid"></div>
                                            </div>
                                        </div>

                                        <!-- 操作日志 -->
                                        <div id="EmailDiv" class="tab-pane">
                                            <div class="table table-striped table-bordered dataTable no-footer table-select" id="ManageTableDivs" aria-describedby="editabledatatable_info">
                                                <div id="data-grids"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(function () {
         var ProjectId = $("#id").val();
        $.post("@Html.Raw(Url.Action("CRDataLogViewList"))", { ProjectId: ProjectId }, function (data) {
            console.log(data);

    })
    });
    $(document).ready(function () {

        //基本样式
        $("input").attr("disabled", "disabled");
        $("textarea").attr("disabled", "disabled");
        $("select").attr("disabled", "disabled");
        $("input").addClass("input-no");
        $("textarea").addClass("input-no");
        var ProjectId = $("#id").val();

        $("#data-grid").kendoGrid({
            dataSource: {
                type: "json",
                transport: {
                    read: {
                        url: "@Html.Raw(Url.Action("CRDataViewList"))",
                        type: "POST",
                        dataType: "json",
                        data: additionalData
                    }
                },

                schema: {
                    data: "Data",
                    total: "Total",
                    errors: "Errors"
                },
                error: function (e) {
                    display_kendoui_grid_error(e);
                    // Cancel the changes
                    this.cancelChanges();
                },
                pageSize: 10,
                serverPaging: true,
                serverFiltering: true,
                serverSorting: true

            },
            pageable: {
                refresh: true,
                pageSizes: [10, 30, 50]
            },
            scrollable: true,
            groupable: true,
            dataBound: onDataBound,
            columns: [{
                field: "Id",
                headerTemplate: "  <div class='' style='text-align: center;'>    <label><input type='checkbox' id='mastercheckbox' /><span class='text'></span> </label>   </div>",
                headerAttributes: { style: "text-align:center" },
                attributes: { style: "text-align:center" },
                template: " <div class='' style='text-align: center;'>    <label><input type='checkbox' class='checkboxGroups'  value='#=Id#' /><span class='text'></span> </label>   </div> ",
                width: 50
            },
                {
                    field: "InsertTime",
                    title: "添加时间",
                    width: 150
                },
                {
                    field: "Number",
                    title: "编号",
                    width: 80
                },
                {
                    field: "Name",
                    title: "细菌名称",
                    width: 110
                },
                {
                    field: "MIC_Imipenem",
                    title: "亚胺培南MIC值(ug/ml)",
                    width: 180
                },
                {
                    field: "ImineNumber",
                    title: "亚胺培南抑菌圈(mm)",
                    width: 180
                },
                {
                    field: "TegacyclineNumber",
                    title: "替加环素抑菌圈直径(mm)",
                    width: 180
                },
                {
                    field: "BacteriostasisNumber",
                    title: "替加环素复敏抑菌圈直径(mm)",
                    width: 210
                },
                {
                    field: "RecheckNumber",
                    title: "肉汤法MIC值(ug/ml)",
                    width: 180
                },
                {
                     field: "Specimensource",
                    title: "标本来源",
                    width: 180
                }]
        });
        $("#data-grids").kendoGrid({
            dataSource: {
                type: "json",
                transport: {
                    read: {
                        url: "@Html.Raw(Url.Action("CRDataLogViewList"))",
                        type: "POST",
                        dataType: "json",
                         data: additionalData
                    }
                    
                },
               
                schema: {
                    data: "Data",
                    total: "Total",
                    errors: "Errors"
                },
                error: function (e) {
                    display_kendoui_grid_error(e);
                    // Cancel the changes
                    this.cancelChanges();
                },
                pageSize: 10,
                serverPaging: true,
                serverFiltering: true,
                serverSorting: true

            },
            pageable: {
                refresh: true,
                pageSizes: [10, 30, 50]
            },
            scrollable: true,
            groupable: true,
            dataBound: onDataBound,
            columns: [{
                field: "Id",
                headerTemplate: "  <div class='' style='text-align: center;'>    <label><input type='checkbox' id='mastercheckbox' /><span class='text'></span> </label>   </div>",
                headerAttributes: { style: "text-align:center" },
                attributes: { style: "text-align:center" },
                template: " <div class='' style='text-align: center;'>    <label><input type='checkbox' class='checkboxGroups'  value='#=Id#' /><span class='text'></span> </label>   </div> ",
                width: 50
            },
                {
                    field: "InsertTime",
                    title: "添加时间",
                    width: 150
                },
                {
                    field: "UserinfoName",
                    title: "操作人",
                    width: 110
                },
                {
                    field: "Content",
                    title: "内容",
                    width: 110
                }]
        });
    });
    //设置查询参数
    function additionalData() {
        var data = {
            ProjectId: $("#id").val()
        };

        addAntiForgeryToken(data);
        return data;
    }


</script>


<script src="~/Content/Scripts/admin.listpage.js"></script>
@Html.Partial("~/Views/Common/_ViewPageJs.cshtml")
