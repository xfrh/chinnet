<script src="/Content/Scripts/TranTextBox.js"></script>
<script>

      if (@Model.DistrictsId> 0) {
            SetDistrictSelect(@Model.ProvinceId, @Model.CityId, @Model.DistrictsId);
        } else {
            GetDistrictList(0, 1);
    }
</script>
