        <td class="adminTitle">@Html.NopLabelFor(m => m.Area)：</td>
        <td class="adminData">
            @Html.Partial("~/Views/PartialView/_SelectArea.cshtml")

            @Html.HiddenFor(a => a.ProvinceId)
            @Html.HiddenFor(a => a.CityId)
            @Html.HiddenFor(a => a.DistrictsId)
