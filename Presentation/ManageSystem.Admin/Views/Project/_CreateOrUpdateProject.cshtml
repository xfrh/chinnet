@model  ManageSystem.Admin.Models.Project.ProjectDataModel
@using ManageSystem.Admin.Extensions;
@using ManageSystem.Services.Common;


@Html.ValidationSummary(true)
@Html.HiddenFor(model => model.Id)
@Html.HiddenFor(model => model.MemberId)
@Html.HiddenFor(model => model.MemberName)
@Html.HiddenFor(model => model.FileName)
@Html.HiddenFor(model => model.UploadFilePath)
@Html.HiddenFor(model => model.EmailStatus)


<table class="adminContent">
    <tr>
        <td class="adminTitle">@Html.NopLabelFor(m => m.HospitalName)：</td>
        <td class="adminData">
            @Html.EditorFor(m => m.HospitalName, new { htmlAttributes = new { @onkeydown = "keypresshandle(event);" } })
            @Html.ValidationMessageFor(m => m.HospitalName)
        </td>
    </tr>

    <tr>
        <td class="adminTitle">@Html.NopLabelFor(m => m.HospitalGrade)：</td>
