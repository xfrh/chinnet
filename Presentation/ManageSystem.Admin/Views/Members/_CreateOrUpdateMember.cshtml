    <tr>
        <td class="adminTitle">@Html.NopLabelFor(m => m.ProjectUploadList)：</td>
        <td class="adminData">
            <div class="well bordered-left bordered-yellow" style="margin-bottom: 0; padding: 0;">
                <style>
                    .pro-upl-table th,
                    .pro-upl-table td {
                        vertical-align: middle !important;
                    }
                </style>
                <table class="table table-condensed table-responsive pro-upl-table">
                    <thead>
                        <tr>
                            <th>上传数据所属项目</th>
                            <th>设置默认选中</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ProjectUploadList)
                        {
                            <tr>
                                <td>
                                    <label class="user-select-no" for="ProjectUploadItem@(item.Value)" style="margin-right: 2rem;">
                                        <input class="colored-blue role-chk" type="checkbox" name="SelectProjectUpload[]" id="ProjectUploadItem@(item.Value)" data-df="#labDefaultProject@(item.Value)" value="@item.Value" @(item.Selected ? "checked=\"checked\"" : null) />
                                        <span class="text" style="color: initial;">@item.Text</span>
                                    </label>
                                </td>
                                <td>
                                    <label id="labDefaultProject@(item.Value)" class="user-select-no" for="DefaultProject@(item.Value)" style="margin-right: 2rem; display: @(item.Selected ? "block" : "none")">
                                        <input class="colored-blue role-chk" type="checkbox" name="DefaultProject" id="DefaultProject@(item.Value)" value="@item.Value" @(item.Value.Equals(Model.DefaultProject.ToString()) ? "checked=\"checked\"" : null) />
                                        <span class="text" style="color: initial;">默认选中【@item.Text】</span>
                                    </label>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </td>
    </tr>
