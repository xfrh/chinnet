<script src="/Content/Scripts/TranTextBox.js"></script>
<script>
    $('input[name="SelectProjectUpload[]"]').on('click', function (e) {
        var $that = $(this),
            $df = $($that.data('df'));
        if ($that.prop('checked')) {
            $df.find('input[name="DefaultProject"]').prop('checked', false);
            $df.show();
        }
        else {
            $df.hide();
        }

    });
    $('input[name="DefaultProject"]').on('click', function () {
        var $that = $(this);
        if ($that.prop('checked')) {
            $('input[name="DefaultProject"]:checked').prop('checked', false);
            $that.prop('checked', true);
        }
    });
</script>