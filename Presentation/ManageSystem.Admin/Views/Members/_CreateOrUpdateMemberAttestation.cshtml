                    @Html.ValidationMessageFor(m => m.DoctorTitleId)
                </td>
            </tr>
		<tr>
			<td class="adminTitle">@Html.NopLabelFor(m => m.DoctorTitleName)：</td>
				<td class="adminData">
				@Html.EditorFor(m => m.DoctorTitleName, new { htmlAttributes = new { @onkeydown = "keypresshandle(event);" } })
				@Html.ValidationMessageFor(m => m.DoctorTitleName)
			</td>
			</tr>
            <tr class="display-no-view">
                <td class="adminTitle">@Html.NopLabelFor(m => m.Status)：</td>
                <td class="adminData">
                    @Html.EditorFor(m => m.Status, new { htmlAttributes = new { @onkeydown = "keypresshandle(event);" } })
                    @Html.ValidationMessageFor(m => m.Status)
                </td>
            </tr>
            <tr class="display-view" style="display:none">
                <td class="adminTitle">@Html.NopLabelFor(m => m.Status)：</td>
                <td class="adminData">
                    @Html.EditorFor(m => m.StatusName, new { htmlAttributes = new { @onkeydown = "keypresshandle(event);" } })
                </td>
            </tr>
		</table>

