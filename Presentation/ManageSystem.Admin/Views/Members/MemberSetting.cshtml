@model ManageSystem.Admin.Models.Members.MemberSettingModel

@{
    ViewBag.Title = "会员设置";
}


@section Breadcrumb{
    @{Html.RenderAction("Breadcrumb", "Shared", new Breadcrumb { MenuName = "会员管理", SecondName = "会员设置", LocationName = this.ViewBag.Title }); }
}

<div class="page-body">
    <div class="row add-page">
        <div class="col-lg-12 col-sm-12 col-xs-12">
            <div class="widget ">
                <div class="widget-header add-page-titlebox ">
                    <span class="widget-caption add-page-title"><i class="glyphicon glyphicon-plus "></i>@this.ViewBag.Title</span>
                </div>
                <div class="widget-body add-content " style="padding-top: 30px;">
                    <div class="form-horizontal bv-form">

                        @using (Html.BeginForm("MemberSetting", "Members", FormMethod.Post, new { id = "form1", enctype = "multipart/form-data" }))
                        {
                            @Html.AntiForgeryToken()
                            <div>
                                <div class="widget-main ">
                                    <div class="tabbable">
                                        <ul class="nav nav-tabs tabs-flat" id="myTab11" style="font-size: 14px;">
                                            <li class="active">
                                                <a data-toggle="tab" href="#SystemDiv">
                                                    基本设置
                                                </a>
                                            </li>
                                        </ul>
                                        <div class="tab-content tabs-flat" style="background-color: white; padding: 30px 12px; min-height: 350px;">

                                            <!-- 基本设置 -->
                                            <div id="SystemDiv" class="tab-pane active">
                                               
                                                    <div class="row">
                                                        <div class="col-sm-12">
                                                            <div class="form-group has-feedback">
                                                                <label class="col-lg-2 control-label">认证金额</label>
                                                                <div class="col-lg-10" >
                                                                    @Html.TextBox("AuthenticationAmount", Model.AuthenticationAmount, new { @class = "form-control txt", placeholder = "" })
                                                                    <span style="color:#BC5679;padding:5px 0px; display: block;">会员认证的金额</span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                <div class="row">
                                                    <div class="col-sm-12">
                                                        <div class="form-group has-feedback">
                                                            <label class="col-lg-2 control-label">信息接收管理员</label>
                                                            <div class="col-lg-10">
                                                                @Html.TextBox("MemberWeixinMessageAdmin", Model.MemberWeixinMessageAdmin, new { @class = "form-control txt", placeholder = "" })
                                                                <span style="color:#BC5679;padding:5px 0px; display: block;">微信信息接收管理员微信会员Ids，多个使用逗号分割</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                 
                                                </div>
                                            </div>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="col-lg-offset-2 col-lg-10" style="text-align:right">
                                    <input type="submit" value="保 存" class="btn btn-blue btn-lg" />
                                </div>
                            </div>
                        }

     
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
