@model  ManageSystem.Admin.Models.Members.FeedbackModel

@{
    ViewBag.Title = "建议反馈";
    bool IsView = UserinfoExtensions.CheckFunction(Url.Action("FeedbackView"));
}

@section HeadSection {
}

@section Breadcrumb{
    @{Html.RenderAction("Breadcrumb", "Shared", new Breadcrumb { MenuName = "会员管理", SecondName = "建议反馈", LocationName = this.ViewBag.Title }); }
}

@Html.AntiForgeryToken()

<div class="page-body">

    <div class="row manage-page">
        <div class="col-xs-12 col-md-12">
            <div class="widget">
                <div class="widget-header bordered-bottom bordered-yellow manage-title-box">
                    <span class="widget-caption manage-title"><i class="glyphicon glyphicon-th "></i>@ViewBag.Title </span>
                    <div class="widget-buttons">
                        <a href="#" data-toggle="maximize"><i class="fa fa-expand"></i></a>
                        <a href="#" data-toggle="collapse"><i class="fa fa-minus"></i></a>
                    </div>
                </div>

                <div class="widget-body">
                    <div role="grid" id="searchable_wrapper" class="dataTables_wrapper form-inline">

                        <div id="searchable_filter" class="dataTables_filter manage-but-box">
                            <div style="width: 100%;">
                                @Html.ButtonHtml(HtmlButtonType.Delete, "FeedbackDelete", "Members")
                            </div>
                            <div style="width: 100%;">
                                <div class="dataTables_filter manage-but-box">
                                    <label class="lb-left">@Html.NopLabelFor(model => model.Name)：</label>
                                    <label class="lb-right"><input type="text" id="Name" class="form-control input-sm search "  /></label>
                                    <label class="lb-left">@Html.NopLabelFor(m => m.StatusList)：</label>
                                    <div class="form-control ddl lb-right " style="width: 10%;"> @Html.DropDownList("StatusValue", Model.StatusList, new { @class = "form-control dropdown" })   </div>
                                      <label> <input type="button" id="btn-search" class="btn btn-blue" value="查 询" /> </label>
                                </div>
                            </div>
                        </div>
                        <div class="table table-striped table-bordered dataTable no-footer table-select" id="ManageTableDiv" aria-describedby="editabledatatable_info">
                            <div id="data-grid"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@*删除数据的表单*@
@using (Html.BeginForm("FeedbackDelete", "Members", FormMethod.Post, new { id = "delete-selected-form" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" id="selectedIds" name="selectedIds" value="" />

}

<script>
    $(document).ready(function () {

        $("#data-grid").kendoGrid({
            dataSource: {
                type: "json",
                transport: {
                    read: {
                        url: "@Html.Raw(Url.Action("FeedbackList"))",
                        type: "POST",
                        dataType: "json",
                        data: additionalData
                    }
                },

                schema: {
                    data: "Data",
                    total: "Total",
                    errors: "Errors"
                },
                error: function (e) {
                    display_kendoui_grid_error(e);
                    // Cancel the changes
                    this.cancelChanges();
                },
                pageSize: 10,
                serverPaging: true,
                serverFiltering: true,
                serverSorting: true

            },
            pageable: {
                refresh: true,
                pageSizes: [10, 30, 50]
            },
            scrollable: false,
            groupable: true,
            dataBound: onDataBound,
            columns: [{
                field: "Id",
                headerTemplate: "  <div class='' style='text-align: center;'>    <label><input type='checkbox' id='mastercheckbox' /><span class='text'></span> </label>   </div>",
                headerAttributes: { style: "text-align:center" },
                attributes: { style: "text-align:center" },
                template: " <div class='' style='text-align: center;'>    <label><input type='checkbox' class='checkboxGroups'  value='#=Id#' /><span class='text'></span> </label>   </div> ",
                width: 50
            },
            {
                field: "InsertTime",
                title: "提交时间",
                width: 130
            },
		{
		    field: "MemberName",
		    title: "会员姓名",
		    width: 100
                },
        {
		    field: "Mobile",
		    title: "手机号",
		    width: 120
                },
        {
		    field: "Email",
		    title: "邮箱",
		    width: 150
		},
		{
		    field: "Status",
		    title: "是否已查看",
		    width: 80
		},
		{
		    field: "Name",
		    title: "反馈标题",
		    width: 400
		},
		{
		    field: "Content",
		    title: "反馈内容"
		},

            {
                field: "Id",
                title: "操作",
                width: 150,
                template: "@Html.KendoUIEditAndView(IsView, "FeedbackView", false, "FeedbackEdit")"
            }]
        });
    });


    //设置查询参数
    function additionalData() {
        var data = {
            Name: $("#Name").val(),
            StatusValue: $("#StatusValue").val()
        };

        addAntiForgeryToken(data);
        return data;
    }

</script>


<script src="~/Content/Scripts/admin.listpage.js"></script>