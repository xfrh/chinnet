@model ManageSystem.Admin.Models.Members.MemberIntegralLogModel
@{
    //page title
    ViewBag.Title ="编辑用户积分使用记录";
}

@section Breadcrumb{
    @{Html.RenderAction("Breadcrumb", "Shared", new Breadcrumb { MenuName = "会员管理", SecondName = "积分使用明细", LocationName = this.ViewBag.Title }); }
}

@using (Html.BeginForm())
{
  @Html.AntiForgeryToken()

 <div class="page-body">
    <div class="row add-page">
        <div class="col-lg-12 col-sm-12 col-xs-12">
            <div class="widget ">
                <div class="widget-header add-page-titlebox ">
                    <span class="widget-caption add-page-title"><i class="glyphicon glyphicon-plus "></i>@this.ViewBag.Title</span>
                </div>
                <div class="widget-body " id="BaseDiv" runat="server">
                    
                    <div class="add-content ">
                        <div class="k-content k-state-active" id="customer-edit-1" role="tabpanel" aria-expanded="true" style="display: block;">
                           @Html.ValidationSummary(true)
                          @Html.HiddenFor(model => model.Id)


                        <table class="adminContent">
                            <tr>
                                <td class="adminTitle">@Html.NopLabelFor(m => m.MemberId)：</td>
                                <td class="adminData">
                                    @Model.MemberId
                                </td>
                            </tr>
                            <tr >
                                <td class="adminTitle">@Html.NopLabelFor(m => m.MemberLoginId)：</td>
                                <td class="adminData">
                                    @Model.MemberLoginId
                                </td>
                            </tr>
                            <tr>
                                <td class="adminTitle">@Html.NopLabelFor(m => m.MemberName)：</td>
                                <td class="adminData">
                                    @Model.MemberName
                                </td>
                            </tr>
                            <tr>
                                <td class="adminTitle">@Html.NopLabelFor(m => m.Type)：</td>
                                <td class="adminData">
                                    @Model.Type
                                </td>
                            </tr>
                            <tr>
                                <td class="adminTitle">@Html.NopLabelFor(m => m.Type)：</td>
                                <td class="adminData">
                                    @Model.Source
                                </td>
                            </tr>
                            <tr>
                                <td class="adminTitle">@Html.NopLabelFor(m => m.Value)：</td>
                                <td class="adminData">
                                    @Html.EditorFor(m => m.Value)
                                    @Html.ValidationMessageFor(m => m.Value)
                                </td>
                            </tr>
                         
                            <tr>
                                <td class="adminTitle">@Html.NopLabelFor(m => m.Remark)：</td>
                                <td class="adminData">
                                    @Html.TextAreaFor(model => model.Remark, new { @class = "form-control txt", cols = "30", rows = "3", style = "margin-bottom: 10px;" })
                                    @Html.ValidationMessageFor(m => m.Remark)
                                </td>
                            </tr>
                            <tr>
                                <td class="adminTitle">@Html.NopLabelFor(m => m.Describe)：</td>
                                <td class="adminData">
                                    @Html.TextAreaFor(model => model.Describe, new { @class = "form-control txt", cols = "30", rows = "3" })
                                    @Html.ValidationMessageFor(m => m.Describe)
                                </td>
                            </tr>
                        </table>
                           </div>
                        </div>
                </div>
                <div class="options add-page-options" style="text-align:right">
                    <input type="submit" name="save" class="btn btn-blue " value="保存" />
                </div>
            </div>
        </div>
    </div>
</div>

}

