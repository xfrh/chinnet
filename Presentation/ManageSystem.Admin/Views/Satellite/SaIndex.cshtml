<script>
    function Agree(ID) {
        console.log(ID);
     $.ajax({
            type: "POST",
                url: "@Url.Action("Agree", "Satellite")",
            dataType: "json",
         data: { ID: ID },
            success: function myfunction() {
                console.log(123);
            }
     })
        location.reload();
    }

    function EditInfo(ID) {
        console.log(ID);
        $.ajax({
            url: "/Satellite/EditInfo",
            type: "POST",
            dataType: "json",
            data: { ID: ID },
            success: function myfunction() {

            }
        })
    }

    var itemId;

    function Reject(ID) {
        itemId = ID;
        //document.getElementById("a").style.visibility = "visible";
        layer.open({
            type: 2,
            area: ['650px', '380px'],
            fix: false, //不固定
            maxmin: true,
            title: "驳回卫星网申请",
            content: '/Satellite/SalliteRejectView?Smid=' + ID
        });

    }

    function ReloadPage() {
        location.reload();
    }

    function RejectWithReason()
    {
        if ($('#rejectReason').val() == "")
        {
            alert("请填写驳回原因！");
            return;
        }
        /*  console.log(itemId);*/
         $.ajax({
            url: '@Url.Action("Reject", "Satellite")',
            type: "POST",
             dataType: "json",
             data: { ID: itemId, Reason: $('#rejectReason').val() },
            success: function myfunction() {
                $('#rejectReason').val("");
            }
        })
        location.reload();
    }

    function ShowAdmin(ID) {
        itemId = ID;
        /*document.getElementById("b").style.visibility = "visible";*/
        //$('#admin_div').show();

        layer.open({
            type: 2,
            area: ['650px', '380px'],
            fix: false, //不固定
            maxmin: true,
            title: "设置卫星网管理员",
            content: '/Satellite/SatelliteSetAdminView?SaId=' + ID
        });
    }

    function SetAdmin() {
        if ($('#admin_account').val().length < 4) {
            alert("账号长度需要大于4位！");
            return;
        }
        if ($('#admin_account').val().length >= 15) {
            alert("账号长度最长为15位！");
            return;
        }
        if ($('#admin_password').val().length < 6) {
            alert("密码长度需要大于6位！");
            return;
        }

          $.ajax({
            url: '@Url.Action("SetAdmin", "Satellite")',
            type: "POST",
            dataType: "json",
            data: { ID: itemId, Account: $('#admin_account').val(), Password: $('#admin_password').val() },
              success: function myfunction(data) {
                  console.log(data)
                $('#admin_account').val("");
                $('#admin_password').val("");
            }
          })
        location.reload();
        alert("设置成功");
    }
</script>
<script src="~/Content/Scripts/admin.listpage.js"></script>



