				@Html.EditorFor(m => m.SubscribeTime, new { htmlAttributes = new { @onkeydown = "keypresshandle(event);" } })
				@Html.ValidationMessageFor(m => m.SubscribeTime)
			</td>
			</tr>
		<tr>
			<td class="adminTitle">@Html.NopLabelFor(m => m.UnsubscribeTime)：</td>
				<td class="adminData">
				@Html.EditorFor(m => m.UnsubscribeTime, new { htmlAttributes = new { @onkeydown = "keypresshandle(event);" } })
				@Html.ValidationMessageFor(m => m.UnsubscribeTime)
			</td>
			</tr>

		</table>

        <script src="/Content/Scripts/TranTextBox.js"></script>
<script type="text/javascript">

				$("#SubscribeTime").kendoDatePicker({ value: new Date(), format: "yyyy-MM-dd HH:mm" });
				$("#UnsubscribeTime").kendoDatePicker({ value: new Date(), format: "yyyy-MM-dd HH:mm" });


   
</script>