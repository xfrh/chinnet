@model  List<ManageSystem.Admin.Models.Weixin.WeixinMenuModel>
@using ManageSystem.Admin.Extensions;
@using ManageSystem.Core.Domain.Weixin;


@{
    ViewBag.Title = "微信菜单";
}

@section HeadSection {
    <style type="text/css">
        .wm-div {
            border: 1px solid #ccc;
            padding: 10px;
            margin: 10px;
        }

            .wm-div p {
                word-break: break-all;
                word-wrap: break-word;
            }
    </style>
}
@section Breadcrumb{
    @{Html.RenderAction("Breadcrumb", "Shared", new Breadcrumb { MenuName = "微信设置", SecondName = "微信菜单", LocationName = this.ViewBag.Title }); }
}

@Html.AntiForgeryToken()

<div class="page-body">

    <div class="row manage-page">
        <div class="col-xs-12 col-md-12">
            <div class="widget">
                <div class="widget-header bordered-bottom bordered-yellow manage-title-box">
                    <span class="widget-caption manage-title"><i class="glyphicon glyphicon-th "></i>@ViewBag.Title </span>
                    <div class="widget-buttons">
                        <a href="#" data-toggle="maximize"><i class="fa fa-expand"></i></a>
                        <a href="#" data-toggle="collapse"><i class="fa fa-minus"></i></a>
                    </div>
                </div>

                <div class="widget-body">
                    <div role="grid" id="searchable_wrapper" class="dataTables_wrapper form-inline">

                        <div id="searchable_filter" class="dataTables_filter manage-but-box">
                            <div style="width: 100%;">
                                @Html.ButtonHtml(HtmlButtonType.Add, "WeixinMenuCreate", "WeixinSet")
                                @{

                                    var url = "/WeixinSet/SyncWeixinMenu";
                                    if (UserinfoExtensions.CheckFunction(url))
                                    {
                                <input type="button" value="同步菜单到微信" class="btn btn-blue " id="btnAnsy " onclick="SyncMenu()" />
                                    }
                                }

                            </div>
                            <div style="width: 100%;">

                            </div>
                        </div>


                        <div class="table table-striped table-bordered dataTable no-footer table-select" id="ManageTableDiv" aria-describedby="editabledatatable_info">
                            <div class="row">
                                @{

                                    <div class="col-lg-1"></div>
                                    foreach (var item in Model)
                                    {
                                <div class="col-lg-3">
                                    <div class="wm-div">
                                        <p>菜单名称：@item.Name</p>
                                        <p>菜单类型：@item.TypeName</p>
                                        <p>关键字：@item.Key</p>
                                        <p>菜单值：@item.Value</p>
                                        <p>

                                            <a href="WeixinMenuView/@item.Id">详细</a>&nbsp;&nbsp;
                                            <a href="WeixinMenuEdit/@item.Id">编辑</a>&nbsp;&nbsp;
                                            <a href="javascript:Delete('@item.Id')">删除</a>
                                        </p>
                                    </div>

                                    @{foreach (var node in item.ChildList)
                                                {
                                            <div class="wm-div">
                                                <p>菜单名称：@node.Name</p>
                                                <p>菜单类型：@node.TypeName</p>
                                                <p>关键字：@node.Key</p>
                                                @{
                                                            if (node.Type == (int)WeixinMenuType.view)
                                                            {
                                                        <p>菜单值：@node.Value</p>
                                                            }
                                                            else
                                                            {
                                                        <p>菜单值：</p>
                                                        <p>
                                                            <ul>
                                                                @{
                                                                            if (node.ArticleItemList != null && node.ArticleItemList.Any())
                                                                            {
                                                                                foreach (var article in node.ArticleItemList)
                                                                                {
                                                                        <li>@article.Name</li>
                                                                                }
                                                                            }
                                                                }
                                                            </ul>
                                                        </p>
                                                            }
                                                }

                                                <p>
                                                    <a href="WeixinMenuView/@node.Id">详细</a>&nbsp;&nbsp;
                                                    <a href="WeixinMenuEdit/@node.Id">编辑</a>&nbsp;&nbsp;
                                                    <a href="javascript:Delete('@node.Id')">删除</a>
                                                </p>
                                            </div>
                                                }
                                    }

                                </div>
                                                }
                                }
                                <div class="col-lg-1"></div>
                            </div>

                        </div>

                        <div class="row" style="width:70%; margin:0px auto; margin-top: 50px;   font-size:14px; ">
                            <p style="border-bottom:1px solid #ccc; margin:10px 0px;   font-size: 16px; height:30px;line-height:30px;">注意事项</p>
                            <div class="widget">
                                <div class="widget-header bg-palegreen">
                                    <div class="widget-buttons">
                                        <a href="#" data-toggle="collapse">     <i class="fa fa-minus"></i></a>
                                        <a href="#" data-toggle="dispose">     <i class="fa fa-times"></i>   </a>
                                    </div>
                                </div>
                                <div class="widget-body">
                                    <code>
                                        1、修改菜单项的信息以后需要“同步菜单到微信”。
                                    </code><br><br>
                                    <code>
                                        2、最上面3个为一级菜单，删除一级菜单会导致二级菜单无法使用，请谨慎操作。
                                    </code><br><br>
                                    <code>
                                        3、同步以后菜单后，菜单的刷新策略是，在用户进入公众号会话页或公众号profile页时，如果发现上一次拉取菜单的请求在5分钟以前，就会拉取一下菜单，如果菜单有更新，就会刷新客户端的菜单。测试时可以尝试取消关注公众账号后再次关注，则可以看到创建后的效果。
                                    </code><br><br>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>


            </div>


        </div>

    </div>
</div>


@*删除数据的表单*@
@using (Html.BeginForm("WeixinMenuDelete", "WeixinSet", FormMethod.Post, new { id = "delete-selected-form" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" id="selectedIds" name="selectedIds" value="" />

}

<script type="text/javascript">
    function Delete(id) {
        if (confirm("不可恢复操作，确认操作吗？")) {
            $("#selectedIds").val(id);
            $("#delete-selected-form").submit();
        }
    }

    function SyncMenu() {
        if (confirm("确认同步微信菜单吗？")) {
            $.ajax({
                type: "Post",
                url: "@Url.Action("SyncWeixinMenu")",
                data: "",
                dataType: "text",
                success: function (data) {
                    alert(data);
                }
            });
        }
    }

</script>


<script src="~/Content/Scripts/admin.listpage.js"></script>