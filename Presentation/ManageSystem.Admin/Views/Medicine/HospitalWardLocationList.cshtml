@model  ManageSystem.Admin.Models.Medicine.HospitalModel

@{
    ViewBag.Title = "医院科室配置管理";
    bool IsCreate = true || UserinfoExtensions.CheckFunction(Url.Action("HospitalWardLocationCreate"));
    bool IsView = UserinfoExtensions.CheckFunction(Url.Action("HospitalWardLocationDetail"));
    bool IsExcel = UserinfoExtensions.CheckFunction(Url.Action("HospitalWardLocation"));
    bool IsDelete = true || UserinfoExtensions.CheckFunction(Url.Action("HospitalWardLocationDelete"));
}

@section HeadSection {
    <link href="~/Content/Scripts/toastr/toastr.min.css" rel="stylesheet" />
    <link href="~/Content/Scripts/ladda/ladda-themeless.min.css" rel="stylesheet" />
    <style>
        @@media (min-width: 768px) {
            .modal-sm {
                width: 350px;
            }
        }
    </style>
}

@section Breadcrumb{
    @{Html.RenderAction("Breadcrumb", "Shared", new Breadcrumb { MenuName = "医学信息", SecondName = "医院管理", LocationName = this.ViewBag.Title }); }
}

@Html.AntiForgeryToken()
@Html.Hidden("HiddenServerUrl", Url.Action("HospitalWardLocationList"))

<div class="page-body">

    <div class="row manage-page">
        <div class="col-xs-12 col-md-12">
            <div class="widget">
                <div class="widget-header bordered-bottom bordered-yellow manage-title-box">
                    <span class="widget-caption manage-title"><i class="glyphicon glyphicon-th "></i>@ViewBag.Title </span>
                    <div class="widget-buttons">
                        <a href="#" data-toggle="maximize"><i class="fa fa-expand"></i></a>
                        <a href="#" data-toggle="collapse"><i class="fa fa-minus"></i></a>
                    </div>
                </div>

                <div class="widget-body">
                    <div role="grid" id="searchable_wrapper" class="dataTables_wrapper form-inline">

                        <div id="searchable_filter" class="dataTables_filter manage-but-box">
                            <div style="width: 100%;">
                                <div class="dataTables_filter manage-but-box">
                                    @if (IsCreate)
                                    {
                                        <a class="btn btn-primary btn-sm" href="@Url.Action("HospitalWardLocationCreate")" style="margin-right: 8px;">
                                            <i class="fa fa-plus fa-fw" aria-hidden="true"></i>&ensp;新&ensp;增
                                        </a>
                                    }
                                    @if (IsExcel)
                                    {
                                        <a class="btn btn-primary btn-sm" href="/Medicine/HospitalWardLocation" style="margin-right: 8px;">
                                            <i class="fa fa-file-excel-o"></i>批量导入
                                        </a>
                                    }
                                    @if (IsDelete)
                                    {
                                        <a id="btnDeletes" class="btn btn-danger btn-sm ladda-button" data-style="zoom-in" href="#" onclick="onDeleteHWLs(); return false;" style="margin-right: 8px;">
                                            <i class="fa fa-trash-o fa-fw" aria-hidden="true"></i>&ensp;删&ensp;除
                                        </a>
                                    }
                                    <label class="lb-left" style="margin-left: 0;">医院名称：</label>
                                    <label class="lb-right">
                                        <input type="text" id="input-search" class="form-control input-sm  search" aria-controls="searchable" name="searchKey" />
                                    </label>
                                    <label> <input type="button" id="btn-search" class="btn btn-blue" value="查 询" /> </label>
                                </div>
                            </div>
                        </div>
                        <div class="table table-striped table-bordered dataTable no-footer table-select" id="ManageTableDiv" aria-describedby="editabledatatable_info">
                            <div id="data-grid"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="modal_delete_confirm" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="deleteHWLItem" data-backdrop="static">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title" id="deleteHWLItem" style="font-size: 14px;">科室配置删除提醒</h4>
            </div>
            <div class="modal-body">
                @using (Html.BeginForm("HospitalWardLocationDelete", "Medicine", FormMethod.Post, new { id = "deleteForm" }))
                {
                    @Html.AntiForgeryToken()
                    <div id="ids_container"></div>
                    <div class="table-responsive">
                        <div class="flex flex-vertical-center">
                            <span class="fa fa-exclamation-triangle" aria-hidden="true" style="font-size: 35px; top: 0; color: #e46f61;"></span>
                            <span style="margin-left: 15px;">确定<span class="text-danger">删除所选医院的全部科室配置数据</span>？</span>
                        </div>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <span style="margin-right: 10px; color: #c7254e80;">注意：删除后不可恢复</span>
                <button type="button" class="btn btn-danger ladda-button" data-style="zoom-in" id="btnSubmitDelete" onclick="onSubmitDelete(); return false;">删除</button>
                <button type="button" class="btn btn-default" data-dismiss="modal">取消</button>
            </div>
        </div>
    </div>
</div>

@section FooterSection {
    <script id="kendo_template_option" type="text/x-kendo-template">
        @if (IsView)
        {
            <a class="btn btn-link user-select-no" href="/Medicine/HospitalWardLocationDetail/#=HospitalId#">查看</a>
        }
        @if (IsDelete)
        {
            <a class="btn btn-link user-select-no" style="color: \\#d73d32 !important;" href="\\#" data-toggle="modal" data-target="\\#modal_delete_confirm" onclick="setDeleteValue('#=HospitalId#'); return false;">删除</a>
        }
    </script>

    <script id="template_delete_input_ids" type="text/html">
        {{each ids}}
        <input name="ids[{{$index}}]" type="hidden" hidden="hidden" value="{{$value}}" />
        {{/each}}
    </script>

    <script id="kendo_template_checkbox_item" type="text/x-kendo-template">
        <div class="text-center">
            <label>
                <input type="checkbox" class="checkboxGroups" value="#=HospitalId#" />
                <span class="text"></span>
            </label>
        </div>
    </script>

    <script src="~/Content/Scripts/layer/layer.js"></script>
    <script src="~/Content/Scripts/toastr/toastr.min.js"></script>
    <script src="~/Content/Scripts/admin.listpage.js"></script>
    <script src="~/Content/Scripts/template-web.js"></script>
    <script src="~/Content/Scripts/ladda/spin.min.js"></script>
    <script src="~/Content/Scripts/ladda/ladda.min.js"></script>
    <script>
        $(document).ready(function () {

            $("#data-grid").kendoGrid({
                dataSource: {
                    type: "json",
                    transport: {
                        read: {
                            url: document.getElementById('HiddenServerUrl').value,
                            type: 'POST',
                            dataType: 'JSON',
                            data: additionalData
                        }
                    },
                    schema: {
                        data: "Data",
                        total: "Total",
                        errors: "Errors"
                    },
                    error: function (e) {
                        display_kendoui_grid_error(e);
                        // Cancel the changes
                        this.cancelChanges();
                    },
                    pageSize: 10,
                    serverPaging: true,
                    serverFiltering: true,
                    serverSorting: true

                },
                pageable: {
                    refresh: true,
                    pageSizes: [10, 30, 50]
                },
                scrollable: false,
                groupable: true,
                dataBound: onDataBound,
                columns: [
                    {
                        field: "HospitalId",
                        headerTemplate: '<div class="" style="text-align: center;"><label><input type="checkbox" id="mastercheckbox" /><span class="text"></span></label></div>',
                        headerAttributes: {
                            style: 'text-align: center;'
                        },
                        attributes: {
                            style: 'text-align: center;'
                        },
                        template: kendo.template(document.getElementById('kendo_template_checkbox_item').innerHTML),
                        width: 50
                    },
                    {
                        field: "Name",
                        title: "医院名称",
                        width: 300
                    },
                    {
                        field: "WardCount",
                        title: "已上传科室配置条数",
                        width: 100
                    },
                    {
                        field: "DateTime",
                        title: "最后一次上传时间",
                        width: 100
                    },
                    {
                        field: "HospitalId",
                        title: "操作",
                        width: 150,
                        template: kendo.template(document.getElementById('kendo_template_option').innerHTML)
                    }
                ]
            });
        });


        //设置查询参数
        function additionalData() {
            var data = {
                Name: $("#input-search").val()
            };

            addAntiForgeryToken(data);
            return data;
        }

        function ReloadPage() {
            location.reload();
        }

        function setDeleteValue(id) {
            if (id) {
                $('#modal_delete_confirm #ids_container').html(template('template_delete_input_ids', { ids: [id] }));
            }
            return false;
        }

        $('#modal_delete_confirm').on('hidden.bs.modal', function () {
            $('#modal_delete_confirm #ids_container').empty();
        });

        function onSubmitDelete() {
            var l = Ladda.create(document.getElementById('btnSubmitDelete'));
            if (!l.isLoading()) {
                l.start();
                $('#deleteForm').submit();
            }
            return false;
        }

        function onDeleteHWLs() {
            var _ids = [];
            $('#data-grid table > tbody > tr input[type="checkbox"].checkboxGroups:checked').each(function (i, item) {
                _ids.push(item.value);
            });
            if (_ids && _ids.length > 0) {
                $('#modal_delete_confirm #ids_container').html(template('template_delete_input_ids', { ids: _ids }));
                $('#modal_delete_confirm').modal('show');
            }
            else {
                toastr.error('请选择需要删除的数据', '删除提示', {
                    positionClass: 'toast-top-center'
                });
            }
            return false;
        }
    </script>
}
