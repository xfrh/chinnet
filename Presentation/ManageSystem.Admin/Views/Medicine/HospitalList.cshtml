@model  ManageSystem.Admin.Models.Medicine.HospitalModel

@{
    ViewBag.Title = "医院管理";
    bool IsEdit = UserinfoExtensions.CheckFunction(Url.Action("HospitalEdit"));
    bool IsView = UserinfoExtensions.CheckFunction(Url.Action("HospitalView"));
}

@section HeadSection {
}

@section Breadcrumb{
    @{Html.RenderAction("Breadcrumb", "Shared", new Breadcrumb { MenuName = "医学信息", SecondName = "医院管理", LocationName = this.ViewBag.Title }); }
}


@Html.AntiForgeryToken()

<div class="page-body">

    <div class="row manage-page">
        <div class="col-xs-12 col-md-12">
            <div class="widget">
                <div class="widget-header bordered-bottom bordered-yellow manage-title-box">
                    <span class="widget-caption manage-title"><i class="glyphicon glyphicon-th "></i>@ViewBag.Title </span>
                    <div class="widget-buttons">
                        <a href="#" data-toggle="maximize"><i class="fa fa-expand"></i></a>
                        <a href="#" data-toggle="collapse"><i class="fa fa-minus"></i></a>
                    </div>
                </div>

                <div class="widget-body">
                    <div role="grid" id="searchable_wrapper" class="dataTables_wrapper form-inline">

                        <div id="searchable_filter" class="dataTables_filter manage-but-box">
                            <div style="width: 100%;">
                                @Html.ButtonHtml(HtmlButtonType.Add, "HospitalCreate", "Medicine")
                                @Html.ButtonHtml(HtmlButtonType.Delete, "HospitalDelete", "Medicine")
                            </div>
                            <div style="width: 100%;">
                                <div class="dataTables_filter manage-but-box">
                                    <label class="lb-left">@Html.NopLabelFor(model => model.Name)：</label>
                                    <label class="lb-right"><input type="text" id="input-search" class="form-control input-sm  search" aria-controls="searchable" name="searchKey" /></label>
                                    <label class="lb-left">@Html.NopLabelFor(m => m.State)：</label>
                                    <div class="form-control ddl lb-right " style="width: 10%;">
                                        @Html.DropDownList("StateValue", Model.StateList, new { @class = "form-control dropdown" })
                                    </div>
                                    <label> <input type="button" id="btn-search" class="btn btn-blue" value="查 询" /> </label>
                                </div>
                            </div>
                        </div>
                        <div class="table table-striped table-bordered dataTable no-footer table-select" id="ManageTableDiv" aria-describedby="editabledatatable_info">
                            <div id="data-grid"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@*删除数据的表单*@
@using (Html.BeginForm("HospitalDelete", "Medicine", FormMethod.Post, new { id = "delete-selected-form" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" id="selectedIds" name="selectedIds" value="" />
}

<script>
    $(document).ready(function () {

        $("#data-grid").kendoGrid({
            dataSource: {
                type: "json",
                transport: {
                    read: {
                        url: "@Html.Raw(Url.Action("HospitalList"))",
                        type: "POST",
                        dataType: "json",
                        data: additionalData
                    }
                },

                schema: {
                    data: "Data",
                    total: "Total",
                    errors: "Errors"
                },
                error: function (e) {
                    display_kendoui_grid_error(e);
                    // Cancel the changes
                    this.cancelChanges();
                },
                pageSize: 10,
                serverPaging: true,
                serverFiltering: true,
                serverSorting: true

            },
            pageable: {
                refresh: true,
                pageSizes: [10, 30, 50]
            },
            scrollable: false,
            groupable: true,
            dataBound: onDataBound,
            columns: [
                {
                    field: "IdString",
                    headerTemplate: "  <div class='' style='text-align: center;'>    <label><input type='checkbox' id='mastercheckbox' /><span class='text'></span> </label>   </div>",
                    headerAttributes: { style: "text-align:center" },
                    attributes: { style: "text-align:center" },
                    template: " <div class='' style='text-align: center;'>    <label><input type='checkbox' class='checkboxGroups'  value='#=IdString#' /><span class='text'></span> </label>   </div> ",
                    width: 50
                },
             	{
             		field: "Name",
             		title: "医院名称",
             		width: 200
             	},
		        {
		            field: "Code",
		            title: "医院代码",
		            width: 100
                },
                {
                    field: "Sort",
                    title: "排序",
                    width: 100
                },
		        {
		            field: "StateValue",
		            title: "是否启用",
		            width: 100
		        }, {
		            field: "ProvinceName",
		            title: "所属省份",
		            width: 100
		        },
		        {
		            field: "Address",
		            title: "医院地址",
		            width: 300
		        },
		        {
		            field: "ContactsUser",
		            title: "联系人",
		            width: 100
		        },
		        {
		            field: "ContactsTel",
		            title: "联系方式",
		            width: 100
                },
                {
                    field: "InsertTimestring",
                    title: "<div style='text-align: center;'>添加时间</div>",
                    attributes: { style: "text-align:center" },
                    width: 150
                },
                {
                    field: "MemberName",
                    title: "管理员",
                    width: 100
                },
                {
                    field: "IdString",
                    title: "操作",
                    width: 150,
                    template: '@Html.Raw("#=ActionHtml#")'
                }
            ]
        });
    });


    //设置查询参数
    function additionalData() {
        var data = {
            Name: $("#input-search").val(),
            StateValue: $("#StateValue").val()
        };

        addAntiForgeryToken(data);
        return data;
    }

    //确认发货
    function SetAdmin(id) {
        //iframe层-父子操作
        layer.open({
            type: 2,
            area: ['650px', '380px'],
            fix: false, //不固定
            maxmin: true,
            title: "设置医院管理员",
            content: '/Medicine/HospitalSetAdmin?id=' + id
        });
    }

    function ReloadPage() {
        location.reload();
    }
</script>

<script src="~/Content/Scripts/layer/layer.js"></script>
<script src="~/Content/Scripts/admin.listpage.js"></script>