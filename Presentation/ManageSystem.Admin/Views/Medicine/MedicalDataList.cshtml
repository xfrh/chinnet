@model  ManageSystem.Admin.Models.Medicine.MedicalDataModel

@{
    /**/

    ViewBag.Title = "医学数据";
    bool IsEdit = false;
    bool IsView = UserinfoExtensions.CheckFunction(Url.Action("MedicalDataView"));
    bool IsDownload1 = UserinfoExtensions.CheckFunction(Url.Action("MedicalDataDownload1"));
    bool IsDownload2 = UserinfoExtensions.CheckFunction(Url.Action("MedicalDataDownload2"));
}

@section HeadSection {
    <style>
        ul.dataTables_filter,
        ul.dataTables_filter li {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        ul.dataTables_filter {
            display: -webkit-box;
            display: -webkit-flex;
            display: -moz-box;
            display: -ms-flexbox;
            display: flex;
            -webkit-box-align: center;
            -webkit-align-items: center;
            -moz-box-align: center;
            -ms-flex-align: center;
            align-items: center;
            -webkit-flex-wrap: wrap;
            -ms-flex-wrap: wrap;
            flex-wrap: wrap;
        }

            ul.dataTables_filter li {
                margin-right: 15px;
                margin-bottom: 10px;
            }

                ul.dataTables_filter li:last-child {
                    margin-right: 0;
                }
    </style>
}

@section Breadcrumb{
    @{Html.RenderAction("Breadcrumb", "Shared", new Breadcrumb { MenuName = "医学信息", SecondName = "数据上传", LocationName = this.ViewBag.Title }); }
}

@Html.AntiForgeryToken()

<div class="page-body">

    <div class="row manage-page">
        <div class="col-xs-12 col-md-12">
            <div class="widget">
                <div class="widget-header bordered-bottom bordered-yellow manage-title-box">
                    <span class="widget-caption manage-title"><i class="glyphicon glyphicon-th "></i>@ViewBag.Title </span>
                    <div class="widget-buttons">
                        <a href="#" data-toggle="maximize"><i class="fa fa-expand"></i></a>
                        <a href="#" data-toggle="collapse"><i class="fa fa-minus"></i></a>
                    </div>
                </div>

                <div class="widget-body">
                    <div role="grid" id="searchable_wrapper" class="dataTables_wrapper form-inline">

                        <div id="searchable_filter" class="dataTables_filter manage-but-box">
                            <div style="width: 100%;">
                                @Html.ButtonHtml(HtmlButtonType.Delete, "MedicalDataDelete", "Medicine")
                                @if (IsDownload1)
                                {
                                    <button class="btn btn-primary" type="button" id="btnDownload1">下载原始文件</button>
                                }
                                @if (IsDownload2)
                                {
                                    <button class="btn btn-primary" type="button" id="btnDownload2">下载容错文件</button>
                                }
                            </div>
                            <div style="width: 100%;">
                                <div class="dataTables_filter manage-but-box">
                                    <label class="lb-left">@Html.NopLabelFor(model => model.HospitalName)：</label>
                                    <label class="lb-right"><input type="text" id="HospitalName" class="form-control input-sm  search" style="width:100%;" /></label>
                                    <label class="lb-left">@Html.NopLabelFor(m => m.ProjectType)：</label>
                                    <div class="form-control ddl lb-right " style="width: 20%;">
                                        @Html.DropDownList("ProjectType", Model.ProjectTypeItems, new { @class = "form-control dropdown" })
                                    </div>
                                    <label class="lb-left">@Html.NopLabelFor(m => m.AreaId)：</label>
                                    <div class="form-control ddl lb-right " style="width: 15%;">
                                        @Html.DropDownList("AreaId", Model.AreaList, new { @class = "form-control dropdown" })
                                    </div>
                                </div>
                                <div class="dataTables_filter manage-but-box">
                                    <label class="lb-left">@Html.NopLabelFor(m => m.HospitalId)：</label>
                                    <div class="form-control ddl lb-right " style="width: 15%;">
                                        @Html.DropDownList("HospitalId", Model.HospitalList, new { @class = "form-control dropdown" })
                                    </div>
                                    <label class="lb-left">@Html.NopLabelFor(m => m.Year)：</label>
                                    <div class="form-control ddl lb-right " style="width: 10%;">
                                        @Html.DropDownList("Year", Model.YearList, new { @class = "form-control dropdown" })
                                    </div>
                                    <label class="lb-left">@Html.NopLabelFor(m => m.Quarter)：</label>
                                    <div class="form-control ddl lb-right " style="width: 15%;">
                                        @Html.DropDownList("Quarter", Model.QuarterList, new { @class = "form-control dropdown" })
                                    </div>
                                    <label> <input type="button" id="btn-search" class="btn btn-blue" value="查 询" /> </label>
                                    <label><button class="btn btn-primary" type="button" id="situation">项目上传情况</button></label>
                                </div>
                            </div>
                        </div>
                        <div class="table table-striped table-bordered dataTable no-footer table-select" id="ManageTableDiv" aria-describedby="editabledatatable_info">
                            <div id="data-grid"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@*删除数据的表单*@
@using (Html.BeginForm("MedicalDataDelete", "Medicine", FormMethod.Post, new { id = "delete-selected-form" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" id="selectedIds" name="selectedIds" value="" />

}

@*下载数据*@
@using (Html.BeginForm("MedicalDataDownload", "Medicine", FormMethod.Post, new { id = "form-download-ids" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" hidden="hidden" id="input-download-type" name="downloadEvent" />
}

<script>
    $(document).ready(function () {

        $("#data-grid").kendoGrid({
            dataSource: {
                type: "json",
                transport: {
                    read: {
                        url: "@Html.Raw(Url.Action("MedicalDataList"))",
                        type: "POST",
                        dataType: "json",
                        data: additionalData
                    }
                },

                schema: {
                    data: "Data",
                    total: "Total",
                    errors: "Errors"
                },
                error: function (e) {
                    display_kendoui_grid_error(e);
                    // Cancel the changes
                    this.cancelChanges();
                },
                pageSize: 10,
                serverPaging: true,
                serverFiltering: true,
                serverSorting: true

            },
            pageable: {
                refresh: true,
                pageSizes: [10, 30, 50]
            },
            scrollable: true,
            groupable: true,
            dataBound: onDataBound,
            columns: [{
                field: "Id",
                headerTemplate: "  <div class='' style='text-align: center;'>    <label><input type='checkbox' id='mastercheckbox' /><span class='text'></span> </label>   </div>",
                headerAttributes: { style: "text-align:center" },
                attributes: { style: "text-align:center" },
                template: " <div class='' style='text-align: center;'>    <label><input type='checkbox' class='checkboxGroups'  value='#=Id#' /><span class='text'></span> </label>   </div> ",
                width: 50
            },
    	{
		    field: "Year",
		    title: "年度",
		    width: 60
		},
		{
		    field: "Quarter",
		    title: "季度",
		    width: 110
		},
    {
		    field: "HospitalName",
		    title: "所属医院",
		    width: 230
		},
    	{
                            field: "FileName",
                            title: "文件名称",
                            template: " <a href='#=UploadFilePath#'  target='_blank'>#=FileName#</a> ",
             		    width: 200
                },

                {
                    field: "DisposeFilePath",
                    title: "容错后的文件",
                    template: " <a href='/Medicine/DownloadNewData/#=Id#' target='_blank'>#=DisposeFileName#</a> ",
                    width: 100
                },

            {
                field: "InsertTime",
                title: "上传时间",
                width: 150
            },
     {
                field: "MemberName",
                title: "上传人",
                width: 120
                },
                {
                    field: "LoginId",
                    title: "上传账号",
                    width: 120
                },
     {
                field: "Size",
                title: "文件大小",
                width: 120
            },
            {
                field: "SN",
                title: "编号",
                width: 100
            },
		{
		    field: "AreName",
		    title: "区域",
		    width:100
		},

            {
                field: "Id",
                title: "操作",
                width: 120,
                template: "@Html.KendoUIEditAndView(IsView, "MedicalDataView", IsEdit, "MedicalDataEdit")"
            }]
        });
    });

    //设置查询参数
    function additionalData() {
        var data = {
            HospitalName: $("#HospitalName").val(),
            AreaId: $("#AreaId").val(),
            HospitalId: $("#HospitalId").val(),
            Year: $("#Year").val(),
            Quarter: $("#Quarter").val(),
            ProjectType: $('#ProjectType').val()
        };

        addAntiForgeryToken(data);
        return data;
    }

    $('#btnDownload1').click(function (e) {
        if ($('#data-grid').find('input[type="checkbox"][value]:checked').length <= 0) {
            alert("请勾选需要下载的数据！")
            return;
        }

        if (confirm("确定要下载您所勾选的数据吗？")) {
            e.preventDefault();
            $('#data-grid').find('input[type="checkbox"][value]:checked').each(function (i, item) {
                if (item.value) {
                    $('#form-download-ids').append('<input type="hidden" hidden="hidden" id="input-download-ids" name="ids" value="' + item.value + '" />');
                }
            });
            $('#form-download-ids #input-download-type').val(0);
            $('#form-download-ids').attr('action', '@Url.Action("MedicalDataDownload1", "Medicine")');
            $('#form-download-ids').submit();
            return false;
        }
    });

    $('#btnDownload2').click(function (e) {
        if ($('#data-grid').find('input[type="checkbox"][value]:checked').length <= 0) {
            alert("请勾选需要下载的数据！")
            return;
        }

        if (confirm("确定要下载您所勾选的数据吗？")) {
            e.preventDefault();
            $('#data-grid').find('input[type="checkbox"][value]:checked').each(function (i, item) {
                if (item.value) {
                    $('#form-download-ids').append('<input type="hidden" hidden="hidden" id="input-download-ids" name="ids" value="' + item.value + '" />');
                }
            });
            $('#form-download-ids #input-download-type').val(1);
            $('#form-download-ids').attr('action', '@Url.Action("MedicalDataDownload2", "Medicine")');
            $('#form-download-ids').submit();
            return false;
        }
    });


    $('#situation').click(function () {
        location.href ='/Medicine/ProjectSituationList'
    })

</script>


<script src="~/Content/Scripts/admin.listpage.js"></script>
