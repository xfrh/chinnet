@model  ManageSystem.Admin.Models.Medicine.HospitalModel

@{
    ViewBag.Title = "医院科室配置详情";
    bool IsView = UserinfoExtensions.CheckFunction(Url.Action("HospitalWardLocationDetail"));
    bool IsCreate = true || UserinfoExtensions.CheckFunction(Url.Action("HWLItemCreate"));
    bool IsEdit = true || UserinfoExtensions.CheckFunction(Url.Action("HWLItemEdit"));
    bool IsDelete = true || UserinfoExtensions.CheckFunction(Url.Action("HWLItemDelete"));
}

@section HeadSection {
    <link href="~/Content/Scripts/toastr/toastr.min.css" rel="stylesheet" />
    <link href="~/Content/Scripts/ladda/ladda-themeless.min.css" rel="stylesheet" />
}

@section Breadcrumb{
    @{Html.RenderAction("Breadcrumb", "Shared", new Breadcrumb { MenuName = "医学信息", SecondName = "医院科室配置管理", LocationName = this.ViewBag.Title }); }
}

@Html.AntiForgeryToken()
@Html.Hidden("HiddenServerUrl", Url.Action("HospitalWardLocationDetail"))
@Html.Hidden("HiddenHospitalID", ViewContext.RouteData.Values["id"])
<div class="page-body">

    <div class="row manage-page">
        <div class="col-xs-12 col-md-12">
            <div class="widget">
                <div class="widget-header bordered-bottom bordered-yellow manage-title-box">
                    <span class="widget-caption manage-title"><i class="glyphicon glyphicon-th "></i>@ViewBag.Title </span>
                    <div class="widget-buttons">
                        <a href="#" data-toggle="maximize"><i class="fa fa-expand"></i></a>
                        <a href="#" data-toggle="collapse"><i class="fa fa-minus"></i></a>
                    </div>
                </div>

                <div class="widget-body">
                    <div role="grid" id="searchable_wrapper" class="dataTables_wrapper form-inline">

                        <div id="searchable_filter" class="dataTables_filter manage-but-box">
                            <div style="width: 100%;">
                                <div class="dataTables_filter manage-but-box">
                                    @if (IsCreate)
                                    {
                                        <a class="btn btn-primary" href="@Url.Action("HWLItemCreate", new { id = ViewContext.RouteData.Values["id"] })">
                                            <i class="fa fa-plus fa-fw" aria-hidden="true"></i>&ensp;新&ensp;增
                                        </a>
                                    }
                                    @if (IsDelete)
                                    {
                                        <a id="btnDeletes" class="btn btn-danger ladda-button" data-style="zoom-in" href="#" onclick="onDeleteHWLs(); return false;">
                                            <i class="fa fa-trash-o fa-fw" aria-hidden="true"></i>&ensp;删&ensp;除
                                        </a>
                                    }
                                    <a class="btn btn-default" href="@Url.Action("HospitalWardLocationList")">返回列表</a>
                                </div>
                            </div>
                        </div>
                        <div class="table table-striped table-bordered dataTable no-footer table-select" id="ManageTableDiv" aria-describedby="editabledatatable_info">
                            <div id="data-grid"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="modal_delete_confirm" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="deleteHWLItem" data-backdrop="static">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title" id="deleteHWLItem" style="font-size: 14px;">科室配置删除提醒</h4>
            </div>
            <div class="modal-body">
                @using (Html.BeginForm("HWLItemDelete", "Medicine", FormMethod.Post, new { id = "deleteHWLItemForm" }))
                {
                    @Html.AntiForgeryToken()
                    <input name="id" id="return_hospital_id" value="@ViewContext.RouteData.Values["id"]" type="hidden" hidden="hidden" />
                    <input name="ids[0]" id="DeleteValue" value="" type="hidden" hidden="hidden" />
                    <div class="table-responsive">
                        <div class="flex flex-vertical-center">
                            <span class="fa fa-exclamation-triangle" aria-hidden="true" style="font-size: 35px; top: 0; color: #e46f61;"></span>
                            <span style="margin-left: 15px;">确定删除该条科室配置？</span>
                        </div>
                        <span style="display: block; margin-top: 13px; color: #c7254e80;">注意：删除后不可恢复</span>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger ladda-button" data-style="zoom-in" id="btnSubmitHWLItemDelete" onclick="onSubmitHWLItemDelete(); return false;">删除</button>
                <button type="button" class="btn btn-default" data-dismiss="modal">取消</button>
            </div>
        </div>
    </div>
</div>

<div id="modal_deleteHWLs_confirm" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="deleteHWLItem" data-backdrop="static">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title" id="deleteHWLItem" style="font-size: 14px;">科室配置删除提醒</h4>
            </div>
            <div class="modal-body">
                @using (Html.BeginForm("HWLItemDelete", "Medicine", FormMethod.Post, new { id = "deleteHWLsForm" }))
                {
                    @Html.AntiForgeryToken()
                    <input name="id" id="_return_hospital_id" value="@ViewContext.RouteData.Values["id"]" type="hidden" hidden="hidden" />
                    <div id="ids_container"></div>
                    <div class="table-responsive">
                        <div class="flex flex-vertical-center">
                            <span class="fa fa-exclamation-triangle" aria-hidden="true" style="font-size: 35px; top: 0; color: #e46f61;"></span>
                            <span style="margin-left: 15px;">确定删除所选的科室配置？</span>
                        </div>
                        <span style="display: block; margin-top: 13px; color: #c7254e80;">注意：删除后不可恢复</span>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger ladda-button" data-style="zoom-in" id="btnSubmitHWLsDelete" onclick="onSubmitHWLsDelete(); return false;">删除</button>
                <button type="button" class="btn btn-default" data-dismiss="modal">取消</button>
            </div>
        </div>
    </div>
</div>
@section FooterSection {
    <script src="~/Content/Scripts/layer/layer.js"></script>
    <script src="~/Content/Scripts/toastr/toastr.min.js"></script>
    <script src="~/Content/Scripts/admin.listpage.js"></script>
    <script src="~/Content/Scripts/template-web.js"></script>
    <script src="~/Content/Scripts/ladda/spin.min.js"></script>
    <script src="~/Content/Scripts/ladda/ladda.min.js"></script>

    <script id="template_delete_input_ids" type="text/html">
        {{each ids}}
        <input name="ids[{{$index}}]" type="hidden" hidden="hidden" value="{{$value}}" />
        {{/each}}
    </script>

    <script id="kendo_template_option" type="text/x-kendo-template">
        @if (IsEdit)
        {
            <a class="btn btn-xs btn-info" href="@Regex.Replace(Url.Action("HWLItemEdit",new { id = 0 }), "/0$", "/#=Id#")">编辑</a>
        }
        @if (IsDelete)
        {
            <a class="btn btn-xs btn-danger" data-toggle="modal" data-target="\\#modal_delete_confirm" onclick="setDeleteValue('#=Id#');">删除</a>
        }
    </script>

    <script id="kendo_template_checkbox_item" type="text/x-kendo-template">
        <div class="text-center">
            <label>
                <input type="checkbox" class="checkboxGroups" value="#=Id#" />
                <span class="text"></span>
            </label>
        </div>
    </script>

    <script>
        $(document).ready(function () {

            $("#data-grid").kendoGrid({
                dataSource: {
                    type: "json",
                    transport: {
                        read: {
                            url: document.getElementById('HiddenServerUrl').value,
                            type: 'POST',
                            dataType: 'JSON',
                            data: function () {
                                var data = {
                                    id: document.getElementById('HiddenHospitalID').value
                                };
                                addAntiForgeryToken(data);
                                return data;
                            }
                        }
                    },
                    schema: {
                        data: "Data",
                        total: "Total",
                        errors: "Errors"
                    },
                    error: function (e) {
                        display_kendoui_grid_error(e);
                        // Cancel the changes
                        this.cancelChanges();
                    },
                    pageSize: 10,
                    serverPaging: true,
                    serverFiltering: true,
                    serverSorting: true

                },
                pageable: {
                    refresh: true,
                    pageSizes: [10, 30, 50]
                },
                scrollable: false,
                groupable: true,
                dataBound: onDataBound,
                columns: [
                    {
                        field: "Id",
                        headerTemplate: '<div class="" style="text-align: center;"><label><input type="checkbox" id="mastercheckbox" /><span class="text"></span></label></div>',
                        headerAttributes: {
                            style: 'text-align: center;'
                        },
                        attributes: {
                            style: 'text-align: center;'
                        },
                        template: kendo.template(document.getElementById('kendo_template_checkbox_item').innerHTML),
                        width: 50
                    },
                    {
                        field: "Name",
                        title: "医院名称",
                        width: 300
                    },
                    {
                        field: "Ward",
                        title: "Ward",
                        width: 150
                    },
                    {
                        field: "Department",
                        title: "Department",
                        width: 100
                    },
                    {
                        field: "Location",
                        title: "Location",
                        width: 100
                    },
                    {
                        field: "Location_Type",
                        title: "Location_Type",
                        width: 100
                    },
                    {
                        field: "DateTime",
                        title: "上传日期",
                        width: 130
                    },
                    {
                        field: "Id",
                        title: "操作",
                        width: 150,
                        template: kendo.template(document.getElementById('kendo_template_option').innerHTML)
                    }
                ]
            });
        });

        function ReloadPage() {
            location.reload();
        }

        function setDeleteValue(id) {
            if (id) {
                $('#modal_delete_confirm #DeleteValue').val(id);
            }
        }

        $('#modal_delete_confirm').on('hidden.bs.modal', function () {
            $('#modal_delete_confirm #DeleteValue').val('');
        });

        function onSubmitHWLItemDelete() {
            var l = Ladda.create(document.getElementById('btnSubmitHWLItemDelete'));
            if (!l.isLoading()) {
                l.start();
                $('#deleteHWLItemForm').submit();
            }
            return false;
        }

        function onDeleteHWLs() {
            var _ids = [];
            $('#data-grid table > tbody > tr input[type="checkbox"].checkboxGroups:checked').each(function (i, item) {
                _ids.push(item.value);
            });
            if (_ids && _ids.length > 0) {
                $('#modal_deleteHWLs_confirm #ids_container').html(template('template_delete_input_ids', { ids: _ids }));
                $('#modal_deleteHWLs_confirm').modal('show');
            }
            else {
                toastr.error('请选择需要删除的科室配置', '删除提示', {
                    positionClass: 'toast-top-center'
                });
            }
            return false;
        }

        $('#modal_deleteHWLs_confirm').on('hidden.bs.modal', function () {
            $('#modal_deleteHWLs_confirm #ids_container').empty();
        });

        function onSubmitHWLsDelete() {
             var l = Ladda.create(document.getElementById('btnSubmitHWLsDelete'));
            if (!l.isLoading()) {
                l.start();
                $('#deleteHWLsForm').submit();
            }
            return false;
        }
    </script>
}