@model  ManageSystem.Admin.Models.Survey.SurveyRecordModel
<style>
    .navbar,.page-sidebar {
        display: none;
    }
    .page-content {
        margin-left:0;
    }
    .k-content .adminContent .adminTitle {
        text-align:left;
        font-weight:bold;
    }
    .adminContent div{
        float: left;
    }
    .adminContent div {
        width:50%;
        margin:10px 0;
    }
    .k-content .adminContent .adminTitle, .k-content .adminContent .adminData {
        clear: both;
        width: 100%;
    }
    .cl {
        clear:both;
    }
</style>
<div class="page-body">
    <div class="row add-page">
        <div class="col-lg-12 col-sm-12 col-xs-12">
            <div class="widget ">
                <div class="widget-body " id="BaseDiv" runat="server">
                    <div class="add-content ">
                        <div class="k-content k-state-active" id="customer-edit-1" role="tabpanel" aria-expanded="true" style="display: block;">
                            @Html.Partial("_CreateOrRecordUpdate", Model)
                            <div class="cl"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
