@model  ManageSystem.Admin.Models.Survey.SurveySurveyModel

@{
    ViewBag.Title = "问卷调查";
    bool IsEdit = UserinfoExtensions.CheckFunction(Url.Action("SurveyEdit"));
    bool IsView = UserinfoExtensions.CheckFunction(Url.Action("SurveyDataView"));
}

@section HeadSection {
    <style>
        ul.dataTables_filter,
        ul.dataTables_filter li {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        ul.dataTables_filter {
            display: -webkit-box;
            display: -webkit-flex;
            display: -moz-box;
            display: -ms-flexbox;
            display: flex;
            -webkit-box-align: center;
            -webkit-align-items: center;
            -moz-box-align: center;
            -ms-flex-align: center;
            align-items: center;
            -webkit-flex-wrap: wrap;
            -ms-flex-wrap: wrap;
            flex-wrap: wrap;
        }

            ul.dataTables_filter li {
                margin-right: 15px;
                margin-bottom: 10px;
            }

                ul.dataTables_filter li:last-child {
                    margin-right: 0;
                }

        .flex {
            display: -webkit-box;
            display: -moz-box;
            display: -ms-flexbox;
            display: flex;
        }

        .flex-center {
            -webkit-box-align: center;
            -moz-box-align: center;
            -ms-flex-align: center;
            align-items: center;
            -webkit-box-pack: center;
            -moz-box-pack: center;
            -ms-flex-pack: center;
            justify-content: center;
        }

        .flex-1 {
            -webkit-box-flex: 1;
            -moz-box-flex: 1;
            -ms-flex: 1;
            flex: 1;
        }

        .qrcode64 {
            width: 64px;
            height: 64px;
            margin: 0 auto;
        }

            .qrcode64 > img {
                max-width: 100%;
                max-height: 100%;
                vertical-align: middle;
            }
    </style>
}

@section Breadcrumb{
    @{Html.RenderAction("Breadcrumb", "Shared", new Breadcrumb { MenuName = "问卷调查管理", SecondName = "问卷调查", LocationName = this.ViewBag.Title }); }
}

@Html.AntiForgeryToken()

<div class="page-body">

    <div class="row manage-page">
        <div class="col-xs-12 col-md-12">
            <div class="widget">
                <div class="widget-header bordered-bottom bordered-yellow manage-title-box">
                    <span class="widget-caption manage-title"><i class="glyphicon glyphicon-th "></i>@ViewBag.Title </span>
                    <div class="widget-buttons">
                        <a href="#" data-toggle="maximize"><i class="fa fa-expand"></i></a>
                        <a href="#" data-toggle="collapse"><i class="fa fa-minus"></i></a>
                    </div>
                </div>

                <div class="widget-body">
                    <div role="grid" id="searchable_wrapper" class="dataTables_wrapper form-inline">

                        <div id="searchable_filter" class="dataTables_filter manage-but-box">
                            <div style="width: 100%;">

                                <button class="btn btn-primary" type="button" id="btnDownload1">添加</button>
                                @Html.ButtonHtml(HtmlButtonType.Delete, "SurveyDelete", "SurveySurvey")
                            </div>
                            <div style="width: 100%;">
                                <div class="dataTables_filter manage-but-box">
                                    <label class="lb-left">调查标题</label>
                                    <label class="lb-right"><input type="text" id="Name" class="form-control input-sm  search" style="width:100%;" /></label>


                                    <label> <input type="button" id="btn-search" class="btn btn-blue" value="查 询" /> </label>
                                </div>
                            </div>
                        </div>
                        <div class="table table-striped table-bordered dataTable no-footer table-select" id="ManageTableDiv" aria-describedby="editabledatatable_info">
                            <div id="data-grid"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@*删除数据的表单*@
@using (Html.BeginForm("SurveyDelete", "SurveySurvey", FormMethod.Post, new { id = "delete-selected-form" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" id="selectedIds" name="selectedIds" value="" />

}

@*下载数据*@
@using (Html.BeginForm("SurveyDownloadExcel", "SurveySurvey", FormMethod.Post, new { id = "form-download-ids" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" hidden="hidden" id="input-download-type" name="downloadEvent" />
}

<script>
    $(document).ready(function () {

        $("#data-grid").kendoGrid({
            dataSource: {
                type: "json",
                transport: {
                    read: {
                        url: "@Html.Raw(Url.Action("SurveyDataList"))",
                        type: "POST",
                        dataType: "json",
                        data: additionalData
                    }
                },

                schema: {
                    data: "Data",
                    total: "Total",
                    errors: "Errors"
                },
                error: function (e) {
                    display_kendoui_grid_error(e);
                    // Cancel the changes
                    this.cancelChanges();
                },
                pageSize: 10,
                serverPaging: true,
                serverFiltering: true,
                serverSorting: true

            },
            pageable: {
                refresh: true,
                pageSizes: [10, 30, 50]
            },
            scrollable: true,
            groupable: true,
            dataBound: onDataBound,
            columns: [
                {
                    field: "Id",
                    headerTemplate: "  <div class='' style='text-align: center;'>    <label><input type='checkbox' id='mastercheckbox' /><span class='text'></span> </label>   </div>",
                    headerAttributes: { style: "text-align:center" },
                    attributes: { style: "text-align:center" },
                    template: " <div class='' style='text-align: center;'>    <label><input type='checkbox' class='checkboxGroups'  value='#=Id#' /><span class='text'></span> </label>   </div> ",
                    width: 50
                },
                {
                    field: "InsertTime",
                    title: "添加时间",
                    width: 130
                },
                {
                    field: "Name",
                    title: "调查标题",
                    width: 350
                },
                {
                    field: "QR",
                    title: "问卷二维码",
                    width: 120,
                    template:'<div class="flex flex-center qrcode64"><img class="flex-1" src="#=QR#" alt="" draggable="false" title="https://m.chinets.com/survey?id=#=Id#" /></div>'
                },
                {
                    field: "State",
                    title: "状态",
                    width: 70
                },
                {
                    field: "OpenTime",
                    title: "活动时间",
                    width: 300
                },
                {
                    field: "Rood",
                    title: "权限",
                    width: 80
                },
            {
                field: "Id",
                title: "操作",
                width: 150,
                template: "@Html.KendoUIEditAndView(IsView, "SurveyDataView", IsEdit, "SurveyEdit")"
            }]
        });
    });

    //设置查询参数
    function additionalData() {
        var data = {
            Name: $("#Name").val()
        };

        addAntiForgeryToken(data);
        return data;
    }

    $('#btnDownload1').click(function (e) {
        location.href = "/SurveySurvey/SurveyCreate";
    });

    $('#btnDownload2').click(function (e) {
        if ($('#data-grid').find('input[type="checkbox"][value]:checked').length <= 0) {
            alert("请勾选需要下载的数据！")
            return;
        }

        if (confirm("确定要发送您所勾选的邮件吗？")) {
            e.preventDefault();
            var ids = "";
            $('#data-grid').find('input[type="checkbox"][value]:checked').each(function (i, item) {
                if (item.value) {
                    ids += item.value + ",";

                }
            });
            console.log(ids.substring(0, ids.length - 1));
            ids = ids.substring(0, ids.length - 1);
             $.ajax({
                type: "POST",
                url: "@Url.Action("SurveyDataDownload2", "SurveySurvey")",
                data: {
                    ids: ids,
                },
                dataType: "json",
                success: function (data) {
                    if (data == "" || data == null) return;

                    if (data.status == "true") {
                        alert(data.message);
                        location.reload;
                        //parent.ReloadPage();
                        //parent.layer.close(index);
                    } else {
                        alert(data.message);
                    }
                }
            });
        }
    });


     //选择文章以后的回调函数
    function SetEmail(obj) {

        var Id = obj;
        if (Id == "" || Id == "0")
        {
            alert("请刷新重试");
            return;
        }

        $.ajax({
            type: "POST",
            url: "@Url.Action("SurveySetEmail", "SurveySurvey")",
            data: {
                Id:Id,
            },
            dataType: "json",
            success: function (data) {
                if (data == "" || data == null) return;

                if (data.status == "true") {
                    alert(data.message);
                    location.reload;
                    //parent.ReloadPage();
                    //parent.layer.close(index);
                } else {
                    alert(data.message);
                }
            }
        });
    }
</script>


<script src="~/Content/Scripts/admin.listpage.js"></script>
