<?xml version="1.0" encoding="utf-8"?>

<!-- 有关使用 web.config 转换的详细信息，请访问 http://go.microsoft.com/fwlink/?LinkId=125889 -->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!--
    在下例中，“SetAttributes”转换将更改 
    “connectionString”的值，以仅在“Match”定位器 
    找到值为“MyDB”的特性“name”时使用“ReleaseSQLServer”。
    
    <connectionStrings>
      <add name="MyDB" 
        connectionString="Data Source=ReleaseSQLServer;Initial Catalog=MyReleaseDB;Integrated Security=True" 
        xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
    </connectionStrings>
  -->
  <connectionStrings xdt:Transform="Replace">
    <add name="ManageSystemContext" connectionString="Data Source=iZbs6met9s709oZ;Initial Catalog=HuiruiMedicalDB;User ID=sa;Password=admin!@#8888****" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings xdt:Transform="Replace">
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <add key="RouteDebugger:Enabled" value="false" />
    <!--百度开放平台的key，必须-->
    <add key="BaiduAppKey" value="CA6ec345eb03c609a8738322aa89905c" />
    <!--百度开放平台的key，必须-->
    <!--
    <add key="BaiduWeatherKey" value="CA6ec345eb03c609a8738322aa89905c" />
    
    -->
    <!--百度天气接口的请求地址，必须-->
    <!--
    <add key="BiaduWeatherUrl" value="http://api.map.baidu.com/telematics/v3/weather?ak={0}&amp;output=json&amp;location={1}" />-->
    <!--百度开放平台的key，必须-->
    <add key="BaiduIpAddressKey" value="CA6ec345eb03c609a8738322aa89905c" />
    <!--百度ip地址接口的请求地址，必须-->
    <add key="BiaduIpAddressUrl" value="http://api.map.baidu.com/location/ip?ak={0}&amp;ip={1}&amp;coor=bd09ll" />


    <!--  ======================= 自己邮件服务器信息 相关参数  开始 ======================================  -->
    <!--发送邮件的帐号-->
    <add key="message.email.email" value="chinet@ityouzi.com" />
    <!--发送邮件的帐号对应的密码-->
    <add key="message.email.password" value="Chinet!@#****" />
    <!--显示的发件人名称-->
    <add key="message.email.displayname" value="CHINET数据云" />
    <!--服务器的端口-->
    <add key="message.email.port" value="80" />
    <!--SMTP服务器地址-->
    <add key="message.email.smtp" value="smtp.mxhichina.com" />
    <!--  ======================= 自己邮件服务器信息 相关参数   结束 ======================================  -->



    <!--下载文件域名本地地址 <add key="FileWebUrl" value="http://chinet.ran-wei.cn/"http://localhost:59986/ />-->
    <add key="FileWebUrl" value="http://chinets.com/" />


    <!--医学数据上传的 上半年时间段-->
    <add key="date.range.first.halfyear" value="1900-01-21#1900-07-20" />
    <!--医学数据上传的 下半年时间段-->
    <add key="date.range.second.halfyear" value="1900-07-21#1900-01-20" />
  </appSettings>
  <ManageSystemConfig xdt:Transform="Replace">
    <!-- Web farm support
    Enable "MultipleInstancesEnabled" if you run multiple instances.
    Enable "RunOnAzureWebsites" if you run on Windows Azure Web sites (not cloud services). -->
    <WebFarms MultipleInstancesEnabled="False" RunOnAzureWebsites="False" />
    <!-- Redis support (used by web farms, Azure, etc). Find more about it at https://azure.microsoft.com/en-us/documentation/articles/cache-dotnet-how-to-use-azure-redis-cache/ -->
    <RedisCaching Enabled="true" KeyPrefix="huiruimedical." ConnectionString="127.0.0.1:6379,127.0.0.1:6379,allowAdmin=true,password=888888" />
    <!-- You can get the latest version of user agent strings at http://user-agent-string.info/ -->
    <UserAgentStrings databasePath="~/App_Data/uas_20140809-02.ini" />
    <!--设置以下设置为“False”如果你没有升级之前的版本之一。它可以稍微提高性能 -->
    <SupportPreviousNopcommerceVersions Enabled="True" />
    <!-- 没有编辑这个元素。仅供高级用户 -->
    <Installation DisableSampleDataDuringInstallation="False" UseFastInstallationService="False" PluginsIgnoredDuringInstallation="" />
  </ManageSystemConfig>
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <!--
      
      在下例中，“Replace”转换将替换 
      web.config 文件的整个 <customErrors> 节。
      请注意，由于 
      在 <system.web> 节点下仅有一个 customErrors 节，因此不需要使用“xdt:Locator”特性。
      
      <customErrors defaultRedirect="GenericError.htm"
        mode="RemoteOnly" xdt:Transform="Replace">
        <error statusCode="500" redirect="InternalError.htm"/>
      </customErrors>
    -->
  </system.web>
  <ManageSystemConfig>
    <RedisCaching Enabled="true" KeyPrefix="huiruimedical." ConnectionString="47.100.30.86:6379,allowAdmin=true,password=Yiketing!@#****8888" xdt:Transform="Replace" />
  </ManageSystemConfig>
</configuration>