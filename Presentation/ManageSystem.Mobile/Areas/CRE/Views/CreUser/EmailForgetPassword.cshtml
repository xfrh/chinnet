
@{
    ViewBag.Title = "忘记密码";
     Layout =  "~/Areas/CRE/Views/Shared/_Layout.cshtml";
}

<div id="app" v-cloak class="indexpage">
    <img class="Lo-topimg" src="/Content/Images/icon_03.jpg" alt="" />
    <div class="Lo-mid">
        <div :class="{'flex f-center margin-b-20 border-b-1': true, 'has-error': errors.has('email')}">
            <input class=" flex1 Lo-Input" placeholder="请输入邮箱地址" type="email" name="email" v-model="email" v-validate="'required|email'" />
        </div>
        <div :class="{'flex f-center margin-b-20 border-b-1': true, 'has-error': errors.has('smscode')}">
            <input class=" flex1 Lo-Code Lo-Input" placeholder="请输入验证码" type="text" name="smscode" v-model="smscode" v-validate="'required|min:6'" />
            <a ref="btnSendCode" class="FP-code bg-blue ladda-button" data-style="zoom-in" href="javascript:void(0);" @@click="onSendCode" v-text="smsText">发送验证码</a>
        </div>
        <div :class="{'flex f-center margin-b-20 border-b-1': true, 'has-error': errors.has('password')}">
            <input minlength="5" class=" flex1 Lo-Input" placeholder="请输入密码，长度大于或等于6位" type="password" name="password" v-model="password" v-validate="'required|min:6'" ref="password" autocomplete="new-password" />
        </div>
        <div :class="{'flex f-center margin-b-20 border-b-1': true, 'has-error': errors.has('password2')}">
            <input minlength="5" class=" flex1 Lo-Input" placeholder="确认密码，和密码一样" type="password" name="password2" v-model="password2" v-validate="'required|confirmed:password'" data-vv-as="password" autocomplete="new-password" />
        </div>

        <a v-show="showSubmit" ref="btnSubmit" class="btn margin-t-40 ladda-button" data-style="zoom-in" @@click="onSubmit" href="javascript:void(0);">确认</a>
        <div class="flex f-center margin-b-20 fon-26" style="margin-top: 10px;">
            <a class="blue" href="@Url.Action("ForgetPassword","CreUser").ToLowerInvariant()">使用手机号验证</a>
        </div>
    </div>
    <div class="fon-26 Lo-footer t-center">
        <div class="margin-b-20">已有账号？<a class="blue" href="@Url.Action("Login", "CreUser").ToLowerInvariant()">去登录</a></div>
        @*<div>欢迎使用CHINET数据云</div>*@
    </div>

    <div id="successToast" ref="successToast" style="display: none;">
        <div class="weui-mask_transparent"></div>
        <div class="weui-toast">
            <i class="weui-icon-success-no-circle weui-icon_toast"></i>
            <p class="weui-toast__content fon-32" v-text="resSuccessMessage"></p>
        </div>
    </div>
    <div id="failToast" ref="failToast" style="display: none;">
        <div class="weui-mask_transparent"></div>
        <div class="weui-toast">
            <i class="weui-icon-warn weui-icon_toast" style="font-size: 1.65rem;"></i>
            <p class="weui-toast__content fon-32" v-text="resFailMessage" style="margin-top: 0.25rem;"></p>
        </div>
    </div>
    <div id="submitToast" ref="submitToast" style="display:none;">
        <div class="weui-mask_transparent"></div>
        <div class="weui-toast">
            <i class="weui-loading weui-icon_toast"></i>
            <p class="weui-toast__content fon-32">数据提交中</p>
        </div>
    </div>
</div>

@section Styles{
    <link href="~/Content/Css/ladda/ladda-themeless.min.css" rel="stylesheet" />
    <link href="~/Content/Css/weui.min.css" rel="stylesheet" />
    <link href="~/Content/Css/User/ForgetPassword.css?v=1.0.0" rel="stylesheet" />
}

@section Scripts{
    <script src="~/Content/Scripts/ladda/spin.min.js"></script>
    <script src="~/Content/Scripts/ladda/ladda.min.js"></script>
    <script src="~/Content/Scripts/vee-validate/vee-validate.min.js"></script>
    <script src="~/Content/Scripts/weui.min.js"></script>
    <script src="~/Content/Scripts/template-web.js"></script>
    <script src="~/Content/Scripts/fx.js"></script>
    <script src="~/Content/Scripts/fx_methods.js"></script>
    <script src="~/Areas/CRE/Content/Scripts/CreUser/EmailForgetPassword.js?v=@DateTime.Now.Ticks"></script>
}