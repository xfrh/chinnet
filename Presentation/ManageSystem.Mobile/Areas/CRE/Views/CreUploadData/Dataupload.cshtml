
@{
    ViewBag.Title = "数据上传";
    //Layout = "~/Areas/CRE/Views/Shared/_SurveyLayout.cshtml";
    Layout = "~/Areas/CRE/Views/Shared/_MainLayout.cshtml";
}
<div id="app" v-cloak class="indexpage">
    <div id="header" class="flex padding-tb-20 fon-30 bold f-around top-nav">
        <div @@click="toPage('@Url.Action("HeatMap", "CreData").ToLowerInvariant()')">热图</div>
        <div @@click="toPage('@Url.Action("GermWithBar", "CreData").ToLowerInvariant()')">柱状图</div>
        <div class="border-b-2" @@click="toPage('@Url.Action("Dataupload", "CreUploadData").ToLowerInvariant()')">数据上传</div>
    </div>
    <div class="middle">
        <div class="padding-lr-40">
            <div class="flex f-center f-between padding-tb-40 border-b-1">
                <div class="fon-28 padding-lr-10">医院名称</div>
                <input placeholder="医院名称" type="tel" name="hospital" id="hospital" data-vv-as="医院名称" class="flex1 fon-28 t-right PI-Input" aria-required="true" aria-invalid="false" readonly="readonly">
            </div>
            <div class="flex f-center f-between padding-tb-40 border-b-1">
                <div class="fon-28 padding-lr-10">所在省份</div>
                <select name="province" id="province" class="flex1 fon-28 PI-Input" aria-required="true" aria-invalid="false" onchange="ProvinceClick()">
                    <option value="0">--请选择--</option>
                </select>
            </div>
            <div class="flex f-center f-between padding-tb-40 border-b-1">
                <div class="fon-28 padding-lr-10">所在城市</div>
                <select name="City" id="City" data-vv-as="城市" class="flex1 fon-28 PI-Input" aria-required="true" aria-invalid="false" onchange="CityClick()">
                    <option value="0">--请选择--</option>
                </select>
            </div>
            <div class="flex f-center f-between padding-tb-40 border-b-1">
                <div class="fon-28 padding-lr-10">所在地区</div>
                <select name="Area" id="Area" data-vv-as="区县" class="flex1 fon-28 PI-Input" aria-required="true" aria-invalid="false">
                    <option value="0">--请选择--</option>
                </select>
            </div>
            <div class="flex f-center f-between padding-tb-40 border-b-1">
                <div class="fon-28 padding-lr-10">详细地址</div>
                <input placeholder="详细地址" type="text" id="address" name="realname" data-vv-as="真实姓名" class="flex1 fon-28 t-right PI-Input">
            </div>
            <div class="flex f-center f-between padding-tb-40 border-b-1">
                <div class="fon-28 padding-lr-10">负责人</div>
                <input placeholder="负责人" id="Person" type="text" name="realname" data-vv-as="真实姓名" class="flex1 fon-28 t-right PI-Input">
            </div>
            <div class="flex f-center f-between padding-tb-40 border-b-1">
                <div class="fon-28 padding-lr-10">邮箱</div>
                <input placeholder="邮箱" id="Email" type="email" name="email" data-vv-as="邮箱" class="flex1 fon-28 t-right PI-Input">
            </div>
            <div class="flex f-center f-between padding-tb-40 border-b-1">
                <div class="fon-28 padding-lr-10">手机号</div>
                <input placeholder="手机号" id="phone" type="tel" name="mobile" data-vv-as="手机号" class="flex1 fon-28 t-right PI-Input">
            </div>
            <div class="flex f-center f-between padding-tb-40 border-b-1">
                <div class="fon-28 padding-lr-10">上报年份</div>
                <select name="year" id="year" data-vv-as="年份" class="flex1 fon-28 PI-Input" aria-required="true" aria-invalid="false">
                    <option value="2019">2019</option>
                    <option value="2020">2020</option>
                    <option value="2021">2021</option>
                </select>
            </div>
            <div class="flex f-center f-between padding-tb-40 border-b-1">
                <div class="fon-28 padding-lr-10">上报季度</div>
                <select name="Ession" id="Ession" data-vv-as="城市" class="flex1 fon-28 PI-Input" aria-required="true" aria-invalid="false">
                    <option value="4">第四季度（10月-12月）</option>
                </select>
            </div>
            <div style="padding-top:20px; padding-bottom:20px;">
                @foreach (var item in ViewBag.Essential)
                {
                    if (Request.QueryString["creid"] == null)
                    {
                        if (item.Germ_id == ViewBag.Germ_id)
                        {
                            <a data-style="zoom-in" href="javascript:void(0);" onclick="clicks(@item.Germ_id)" class="btn margin-t-20 margin-b-20 ladda-button">@item.Germ_name</a>
                        }
                        else
                        {
                            <a data-style="zoom-in" href="javascript:void(0);" onclick="clicks(@item.Germ_id)" style="background-color:gainsboro;color:black;cursor: pointer;" class="btn margin-t-20 margin-b-20 ladda-button">@item.Germ_name</a>
                        }
                    }
                    else
                    {
                        if (long.Parse(Request.QueryString["creid"]) == item.Germ_id)
                        {
                            <a data-style="zoom-in" href="javascript:void(0);" onclick="clicks(@item.Germ_id)" class="btn margin-t-20 margin-b-20 ladda-button">@item.Germ_name</a>
                        }
                        else
                        {
                            <a data-style="zoom-in" href="javascript:void(0);" onclick="clicks(@item.Germ_id)" style="background-color:gainsboro;color:black;cursor: pointer;" class="btn margin-t-20 margin-b-20 ladda-button">@item.Germ_name</a>
                        }
                    }
                }
            </div>
            @{
                var Grem_name = "";
                var Cr_name = "";
                var Ger_code = "";
