@section Scripts{
    <script src="~/Content/Scripts/ladda/spin.min.js"></script>
    <script src="~/Content/Scripts/ladda/ladda.min.js"></script>
    <script src="~/Content/Scripts/vee-validate/vee-validate.min.js"></script>
    <script src="~/Content/Scripts/weui.min.js"></script>
    <script src="~/Areas/CRE/Content/Scripts/CreUploadView.js"></script>
    <script src="~/Content/Scripts/fx.js"></script>
    <script src="~/Content/Scripts/fx_methods.js"></script>
    <script src="~/Areas/CRE/Content/Scripts/layer-v2.4/layer.js"></script>
    <script src="~/Areas/CRE/Content/Scripts/layer-v2.4/helper.js"></script>
    <script>
        new hSdrop({
            els: '.sele-bp'
        });
        $(function () {
            showInit();
            var content = "";
            var date = new Date();
            var month = date.getMonth() + 1;           
            if (month >= 1 && month <= 3) {
                content += "<option value=" + 1 + ">第一季度（1月-3月）</option>";
                $("#Ession").html(content);
            }
            else if (month >= 4 && month <= 6) {
                content += "<option value=" + 1 + ">第一季度（1月-3月）</option>";
                content += "<option value=" + 2 + ">第二季度（4月-6月）</option>";
                $("#Ession").html(content);

            }
            else if (month >= 7 && month <= 9) {
                content += "<option value=" + 1 + ">第一季度（1月-3月）</option>";
                content += "<option value=" + 2 + ">第二季度（4月-6月）</option>";
                content += "<option value=" + 3 + ">第三季度（7月-9月）</option>";
                $("#Ession").html(content);
            }
            else if (month >= 10 && month <= 12) {
                content += "<option value=" + 1 + ">第一季度（1月-3月）</option>";
                content += "<option value=" + 2 + ">第二季度（4月-6月）</option>";
                content += "<option value=" + 3 + ">第三季度（7月-9月）</option>";
                content += "<option value=" + 4 + ">第四季度（10月-12月）</option>";
                $("#Ession").html(content);
            }

            $("#3_biaoben_1_rate").hide();
            $("#3_biaoben_2_rate").hide();
            $("#3_biaoben_3_rate").hide();
            $("#3_biaoben_4_rate").hide();
            $("#3_biaoben_5_rate").hide();
            $("#3_biaoben_6_rate").hide();
            $("#3_biaoben_7_rate").hide();
            $("#3_biaoben_8_rate").hide();
            $("#3_biaoben_9_rate").hide();
            $("#4_biaoben_1_rate").hide();
            $("#4_biaoben_2_rate").hide();
            $("#4_biaoben_3_rate").hide();
            $("#4_biaoben_4_rate").hide();
            $("#4_biaoben_5_rate").hide();
            $("#4_biaoben_6_rate").hide();
            $("#11_biaoben_1_rate").hide();
            $("#11_biaoben_2_rate").hide();
            $("#11_biaoben_3_rate").hide();
            $("#11_biaoben_4_rate").hide();
            $("#11_biaoben_5_rate").hide();
            $("#11_biaoben_6_rate").hide();
            $("#12_biaoben_1_rate").hide();
            $("#12_biaoben_2_rate").hide();
            $("#12_biaoben_3_rate").hide();
            $("#12_biaoben_4_rate").hide();
            $("#12_biaoben_5_rate").hide();
            $("#12_biaoben_6_rate").hide();
            $("#redio").hide();
            $.get("/CreUploadData/Basicinformation", { token: localStorage.getItem('token') }, function (data) {
                data = JSON.parse(data);
                if (data.length <= 0) {
                    GetDistrictList(0, 1);
                }
