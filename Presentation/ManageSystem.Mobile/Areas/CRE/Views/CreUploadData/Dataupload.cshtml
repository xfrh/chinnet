        function validationNumber(e, num) {
            var regu = /^[0-9]+\.?[0-9]*$/;
            if (e.value != "") {
                if (!regu.test(e.value)) {
                    MessageWindow("请输入正确数字");                   
                    e.value = "";
                    e.focus();
