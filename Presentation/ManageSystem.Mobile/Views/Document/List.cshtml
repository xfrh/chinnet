
@{
    ViewBag.Title = "资料下载";
    Layout = "/Views/Shared/_MainLayout.cshtml";
}

@section Styles{
    <link href="~/Content/Css/ladda/ladda-themeless.min.css" rel="stylesheet" />
    <link href="~/Content/Css/font-awesome.min.css" rel="stylesheet" />
    <link href="~/Content/Css/weui.min.css" rel="stylesheet" />
    <link href="~/Content/Css/swiper/swiper.min.css" rel="stylesheet" />
    <link href="~/Content/Css/Document/List.css" rel="stylesheet" />
}

@section Scripts{
    <script src="~/Content/Scripts/ladda/spin.min.js"></script>
    <script src="~/Content/Scripts/ladda/ladda.min.js"></script>
    <script src="~/Content/Scripts/swiper/swiper.min.js"></script>
    <script src="~/Content/Scripts/weui.min.js"></script>
    <script src="~/Content/Scripts/fx.js"></script>
    <script src="~/Content/Scripts/fx_methods.js"></script>
    <script src="~/Content/Scripts/Document/List.js"></script>
}

<div id="app" v-cloak class="indexpage">
    <div ref="middle" class="middle padding-20">
        <div ref="swiper_container" class="swiper-container scroll">
            <div class="swiper-wrapper">
                <div class="swiper-slide slidescroll">

                    <div v-for="item in items" @@click="download(item)" class="flex padding-t-20 padding-b-20 border-b-1 f-center f-between">
                        <div class="flex-1 m-r8">
                            <div class="fon-30 margin-b-10">{{item.Name}}</div>
                            <div class="flex f-center">
                                <div class="margin-r-20 f-center flex c96 fon-22">
                                    <i class="fa fa-clock-o fa-fw" aria-hidden="true" style="margin-right: 0.1rem;"></i>
                                    {{item.Date}}
                                </div>
                                <div class="c96 f-center flex fon-22">
                                    <i class="fa fa-eye fa-fw" aria-hidden="true" style="margin-right: 0.1rem;"></i>
                                    {{item.Count}}
                                </div>
                            </div>
                        </div>
                        <div class="download-btn-group">
                            <a :id="'btn_download__' + item.Id" class="btn btn-download ladda-button" data-style="zoom-in" href="javascript:void(0);">
                                <span class="sr-only">下载</span>
                            </a>
                        </div>
                    </div>

                    <div v-if="pageNull" ref="listNullDiv" class="list-null"></div>
                    <div v-if="nextPageLoading" class="weui-loadmore" style="margin: 0.23rem auto;">
                        <i class="weui-loading"></i>
                        <span class="weui-loadmore__tips">加载更多</span>
                    </div>
                    <div v-if="noNetxPage" class="weui-loadmore weui-loadmore_line" style="margin: 0.75rem auto 0;">
                        <span class="weui-loadmore__tips">这是人家的底线</span>
                    </div>
                    <div v-if="!nextPageLoading&&!noNetxPage" style="height: 1rem;"></div>

                </div>
            </div>
        </div>
    </div>

    @Html.Partial("_FooterNavBar", "下载")

    <div ref="failToast" id="failToast" style="display: none;">
        <div class="weui-mask_transparent"></div>
        <div class="weui-toast">
            <i class="weui-icon-warn weui-icon_toast" style="font-size: 1.65rem;"></i>
            <p class="weui-toast__content fon-32" v-text="resFailMessage" style="margin-top: 0.25rem;"></p>
        </div>
    </div>

    <div ref="loadingToast" id="loadingToast" style="display:none;">
        <div class="weui-mask_transparent"></div>
        <div class="weui-toast">
            <i class="weui-loading weui-icon_toast"></i>
            <p class="weui-toast__content fon-32" v-html="loadingText"></p>
        </div>
    </div>

    <div ref="iosDialog" id="iosDialog" class="js_dialog" style="display: none;">
        <div class="weui-mask"></div>
        <div class="weui-dialog">
            <div class="weui-dialog__bd" v-html="dialogContent"></div>
            <div class="weui-dialog__ft">
                <a href="javascript:void(0);" @@click="closeDialog" class="weui-dialog__btn weui-dialog__btn_primary" style="color: #005cad;">知道了</a>
            </div>
        </div>
    </div>
</div>