
@{
    ViewBag.Title = "验证码登录";
}

<div id="app" v-cloak class="indexpage">
    <img class="Lo-topimg" src="~/Content/Images/logo.png" alt="" style="    margin: 0px auto;width: 3.5rem;margin-top: 1rem;">
    <img class="Lo-topimg" src="/Content/Images/icon_03.jpg" alt="" style="width:5rem;">
    <div class="Lo-mid">
        <div :class="{'flex f-center margin-b-40 border-b-1': true, 'has-error': errors.has('mobile')}">
            <img class="Lo-left-img" src="/Content/Images/left_phone_07.jpg" alt="">
            <input class=" flex1 Lo-Input" placeholder="请输入手机号码" type="tel" name="mobile" v-model="mobile" v-validate="'required|numeric|digits:11'" />
        </div>
        <div :class="{'flex f-center margin-b-40 border-b-1': true, 'has-error': errors.has('smscode')}" style="margin-bottom: 0.75rem;">
            <img class="Lo-left-img" src="/Content/Images/left_suo_11.jpg" alt="">
            <input class=" flex1 Lo-Code Lo-Input" placeholder="请输入验证码" type="tel" name="smscode" v-model="smscode" v-validate="'required|numeric|digits:6'" />
            <a ref="btnSendCode" class="FP-code bg-blue ladda-button" data-style="zoom-in" href="javascript:void(0);" @@click="sendSms" v-text="smsText">发送验证码</a>
        </div>
        <a ref="btnLogin" class="btn margin-b-20 ladda-button" data-style="zoom-in" href="javascript:void(0);" @@click="onLogin" style="margin-top:1rem;">登录</a>
        <div class="flex fon-28 margin-b-40  f-between f-center" style="display: none;">
            <a class="blue" href="javascript:void(0);" @@click="toPage('@Url.Action("Login", "User").ToLowerInvariant()')">账号密码登录</a>
            <a class="blue" href="javascript:void(0);" @@click="toPage('@Url.Action("SmsLogin", "User").ToLowerInvariant()')">验证码登录</a>
        </div>
    </div>
    <div class="fon-26 Lo-footer t-center">
        <div class="margin-b-20" style="display: none;">还没有账号？<a class="blue" href="javascript:void(0);" @@click="toPage('@Url.Action("Register", "User").ToLowerInvariant()')">去注册</a></div>
        <div>
            CHINET中国细菌耐药监测网
        </div>
        <div>
            China Antimicrobial Surveillance Network
        </div>

        <div class="js_dialog" ref="iosDialog" style="display: none;">
            <div class="weui-mask"></div>
            <div class="weui-dialog">
                <div class="weui-dialog__bd" v-html="dialogContent"></div>
                <div class="weui-dialog__ft">
                    <a href="javascript:void(0);" @@click="closeDialog" class="weui-dialog__btn weui-dialog__btn_primary" style="color: #005cad;">知道了</a>
                </div>
            </div>
        </div>

        <div id="successToast" ref="successToast" style="display: none;">
            <div class="weui-mask_transparent"></div>
            <div class="weui-toast">
                <i class="weui-icon-success-no-circle weui-icon_toast"></i>
                <p class="weui-toast__content fon-32" v-text="resSuccessMessage"></p>
            </div>
        </div>
        <div id="failToast" ref="failToast" style="display: none;">
            <div class="weui-mask_transparent"></div>
            <div class="weui-toast">
                <i class="weui-icon-warn weui-icon_toast" style="font-size: 1.65rem;"></i>
                <p class="weui-toast__content fon-32" v-text="resFailMessage" style="margin-top: 0.25rem;"></p>
            </div>
        </div>
        <div id="submitToast" ref="submitToast" style="display:none;">
            <div class="weui-mask_transparent"></div>
            <div class="weui-toast">
                <i class="weui-loading weui-icon_toast"></i>
                <p class="weui-toast__content fon-32">数据提交中</p>
            </div>
        </div>
    </div>

@section Styles{
    <link href="~/Content/Css/ladda/ladda-themeless.min.css" rel="stylesheet" />
    <link href="~/Content/Css/weui.min.css" rel="stylesheet" />
    <link href="~/Content/Css/User/SmsLogin.css?v=1.0.0" rel="stylesheet" />
}

@section Scripts{
    <script src="~/Content/Scripts/ladda/spin.min.js"></script>
    <script src="~/Content/Scripts/ladda/ladda.min.js"></script>
    <script src="~/Content/Scripts/vee-validate/vee-validate.min.js"></script>
    <script src="~/Content/Scripts/weui.min.js"></script>
    <script src="~/Content/Scripts/fx.js"></script>
    <script src="~/Content/Scripts/fx_methods.js"></script>
    <script src="~/Content/Scripts/User/SmsLogin.js?v=1.0.0"></script>
}