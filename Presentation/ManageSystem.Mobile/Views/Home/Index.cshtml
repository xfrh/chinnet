    <script>
        $(function () {
            $.ajax({
                async: false,
                type: "POST",
                url: "/Home/GetTeamlist",
                data: {},
                dataType: "json",
                success: function (json) {
                    var html = ""
                    for (var i = 0; i < json.length; i++) {
                        html += "<dl class='padding-tb-20'>" +
                            "<dt>" + json[i].Title + "</dt>" +
                            "<dd>" + json[i].People + "</dd>" +
                            "</dl>";
                    }
                    $("#sec").html(html);
                }
            });

        })
    </script>
