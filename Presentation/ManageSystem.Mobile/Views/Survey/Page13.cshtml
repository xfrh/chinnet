
@{
    ViewBag.Title = "问卷";
    Layout = "~/Views/Shared/_SurveyLayout.cshtml";
    string _version = DateTime.Now.Ticks.ToString();
}

@section Styles{
    <link href="~/Content/Css/Survey/Page13.css?v=@_version" rel="stylesheet" />
}
@section Scripts{
    <script src="~/Content/Scripts/Survey/Page13.js?v=@_version"></script>
}

<div id="app" v-locak>
    <input id="hidden_id" name="hidden_id" ref="hidden_id" type="hidden" hidden="hidden" value="@ViewContext.RouteData.Values["id"]" />
    <div id="page" class="swiper-container">
        <div class="swiper-wrapper">
            <div class="swiper-slide slidescroll">
                <div class="survey-body">
                    <article class="cro-page">
                        <div class="cro-qbox">
                            <div class="cro-qbox-title" v-text="Q25.title"></div>
                            <div class="cro-qbox-awbox">
                                <table>
                                    <tbody>
                                        <tr v-for="(item, index) in Q25.options" :class="{'has-error': errors.has(item.name)}">
                                            <td>
                                                <div class="checkbox-control">
                                                    <input :id="item.id" v-model="Q25.answer" class="checkbox-control-input" type="checkbox" :name="item.name" :value="item.value" v-validate="{required: true, length: [1, 9]}" v-if="index === 0" />
                                                    <input :id="item.id" v-model="Q25.answer" class="checkbox-control-input" type="checkbox" :name="item.name" :value="item.value" v-if="index > 0" />
                                                    <label :for="item.id" class="checkbox-control-label"></label>
                                                </div>
                                            </td>
                                            <td>
                                                <label :for="item.id" v-text="item.text"></label>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="cro-qbox">
                            <div class="cro-qbox-title" v-text="Q26.title"></div>
                            <div class="cro-qbox-awbox">
                                <table>
                                    <tr v-for="(item,index) in Q26.options" :class="{'has-error': errors.has(item.name)}">
                                        <td style="width: 1.55rem;">
                                            <div class="checkbox-control">
                                                <input :id="item.id" v-model="Q26.answer" class="checkbox-control-input" :name="item.name" type="radio" :value="item.value" v-validate="{required: true, length: 1}" />
                                                <label :for="item.id" class="checkbox-control-label"></label>
                                            </div>
                                        </td>
                                        <td>
                                            <label :for="item.id" v-text="item.text" style="display: block;"></label>
                                        </td>
                                    </tr>
                                    <tr v-if="Q26.answer === '是'">
                                        <td colspan="2">
                                            <div class="flex align-items__baseline">
                                                <div class="">采用何方法？</div>
                                                <div :class="{'cro-qbox-awbox flex-1': true, 'has-error': errors.has('Q26_other')}">
                                                    <input class="flex-1 cro-qbox__input font-14px" name="Q26_other" v-model="Q26.other" v-validate="{required: true, min: 1}" type="text" />
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </article>
                </div>
                <footer class="cre-footer">
                    <a class="btn btn-primary cre-submit a-btn" href="javascript: void(0);" @@click="onOver" v-if="Q26.answer !== '是'">下一页</a>
                    <a class="btn btn-primary cre-submit a-btn" href="javascript: void(0);" @@click="onSubmit" v-if="Q26.answer === '是'">下一页</a>
                    <div style="height: 38px;"></div>
                </footer>
            </div>
        </div>
    </div>
</div>