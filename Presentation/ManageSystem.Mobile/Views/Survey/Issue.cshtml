    <div id="app" v-locak>
        <input id="hidden_id" name="hidden_id" ref="hidden_id" type="hidden" value="@ViewContext.RouteData.Values["id"]" />
        <div v-if="!isSubmit" class="swiper-container" ref="mySwiper" style="height: 100%; margin-bottom: 0.75rem; background: #f9f9f9; padding: 0.75rem;">
            <div class="swiper-wrapper">
                <div class="swiper-slide" v-if="!isSubmit">
                    <header class="header-title" v-text="survey.title"></header>
                    <section class="header-content" v-html="survey.content"></section>

