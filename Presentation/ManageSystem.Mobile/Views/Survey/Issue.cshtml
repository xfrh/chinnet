                                            <tr v-for="(item,index) in Q3.options" :class="{'has-error': errors.has(item.name)}">
                                                <td>
                                                    <div class="checkbox-control">
                                                        <input :id="item.id" v-model="Q3.answer" class="checkbox-control-input" type="checkbox" :name="item.name" :value="item.value" v-validate="{required: true, length: 3}" v-if="index === 0" />
                                                        <input :id="item.id" v-model="Q3.answer" class="checkbox-control-input" type="checkbox" :name="item.name" :value="item.value" v-if="index > 0" />
                                                        <label :for="item.id" class="checkbox-control-label"></label>
                                                    </div>
                                                </td>
                                                <td>
                                                    <label :for="item.id" v-text="item.text" v-if="item.value !== '其他'"></label>
                                                    <div v-if="item.value === '其他'" :class="{'flex cro-qbox-awbox__other': true, 'has-error': errors.has('Q3_other')}">
                                                        <label :for="item.id" style="width: 2.75rem;" v-text="item.text"></label>
                                                        <input class="flex-1 cro-qbox__input" name="Q3_other" v-model="Q3.other" v-validate="{required: Q3.answer.includes('其他'), min: 1}" type="text" />
                                                    </div>
                                                </td>
                                            </tr>
                                            <tr v-if="Q3.answer.length>0">
                                                <td colspan="2">
                                                    <div class="flex align-items__baseline" style="margin-top: 0.75rem;">
                                                        <div class="">百分比：</div>
                                                        <div :class="{'cro-qbox-awbox flex-1': true, 'has-error': errors.has('Q3_Rate')}">
                                                            <input class="cro-qbox__input" name="Q3_Rate" v-model="Q3.rate" v-validate="{required: true}" type="text" placeholder="请选择百分比" style="background-color: transparent;" readonly="readonly" @@click="onQ3Picker($event)" />
                                                        </div>
                                                    </div>
