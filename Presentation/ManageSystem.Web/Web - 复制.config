<!--
  有关如何配置 ASP.NET 应用程序的详细信息，请访问
  http://go.microsoft.com/fwlink/?LinkId=301880
  -->
<configuration>

  <configSections>
    <section name="ManageSystemConfig" type="ManageSystem.Core.Configuration.ManageSystemConfig, ManageSystem.Core" requirePermission="false" />
  </configSections>

  <connectionStrings>
    <!--  <add name="ManageSystemContext" connectionString="data source=ZOUXUEDIAN;initial catalog=EFTest;integrated security=True;MultipleActiveResultSets=True;App=EntityFramework" providerName="System.Data.SqlClient" />-->
    <add name="ManageSystemContext" connectionString="Data Source=106.14.206.80;Initial Catalog=HuiruiMedicalDB;User ID=HuiruiMedicalDB;Password=HuiruiMedicalDB!@#;" providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <add key="RouteDebugger:Enabled" value="false" />


    <!--百度开放平台的key，必须-->
    <add key="BaiduAppKey" value="CA6ec345eb03c609a8738322aa89905c" />

    <!--百度开放平台的key，必须-->
    <!--
    <add key="BaiduWeatherKey" value="CA6ec345eb03c609a8738322aa89905c" />
    
    -->
    <!--百度天气接口的请求地址，必须-->
    <!--
    <add key="BiaduWeatherUrl" value="http://api.map.baidu.com/telematics/v3/weather?ak={0}&amp;output=json&amp;location={1}" />-->

    <!--百度开放平台的key，必须-->
    <add key="BaiduIpAddressKey" value="CA6ec345eb03c609a8738322aa89905c" />

    <!--百度ip地址接口的请求地址，必须-->
    <add key="BiaduIpAddressUrl" value="http://api.map.baidu.com/location/ip?ak={0}&amp;ip={1}&amp;coor=bd09ll" />

    <!--图片地址的url地址，因为前后台分离的原因-->
    <add key="ImageUrl" value="http://admin.x.com" />

    <!--微信服务器的网站的域名地址-->
    <add key="WeixinWebUrl" value="http://w.x.com" />
    <!-- 与微信公众账号后台的Token设置保持一致，区分大小写。 -->
    <add key="WeixinToken" value="weixin" />
    <!-- 与微信公众账号后台的AppId设置保持一致，区分大小写。-->
    <add key="WeixinAppId" value="wxd877bb4d74e74ce6" />
    <!-- 与微信公众账号后台的AppSecret设置保持一致，区分大小写。-->
    <add key="WeixinAppSecret" value="1a778741fd646b8dbacb7400c411d816" />

    <!-- innerapi 的接口地址-->
    <add key="InnerApiUrl" value="http://dev.innerapi.chinets.com" />


    <!--  ======================= 自己邮件服务器信息 相关参数  开始 ======================================  -->
    <!--发送邮件的帐号-->
    <add key="message.email.email" value="chinet@ityouzi.com" />
    <!--发送邮件的帐号对应的密码-->
    <add key="message.email.password" value="Chinet!@#****" />
    <!--显示的发件人名称-->
    <add key="message.email.displayname" value="CHINET数据云" />
    <!--服务器的端口-->
    <add key="message.email.port" value="80" />
    <!--SMTP服务器地址-->
    <add key="message.email.smtp" value="smtp.mxhichina.com" />
    <!--  ======================= 自己邮件服务器信息 相关参数   结束 ======================================  -->

    <!--医学数据上传的 上半年时间段-->
    <add key="date.range.first.halfyear" value="1900-01-21#1900-07-20" />
    <!--医学数据上传的 下半年时间段-->
    <add key="date.range.second.halfyear" value="1900-07-21#1900-01-20" />

    <!--CR 项目上传excel系统支持的细菌名称  -->
    <add key="cr.upload.excel.germ" value="大肠埃希菌,肺炎克雷伯君,产酸克雷伯菌,阴沟肠杆菌,产气肠杆菌,奇异变形杆菌,黏质沙雷菌,弗劳地枸橼酸杆菌,摩根摩根菌,普罗威登菌,铜绿假单胞菌,鲍曼不动杆菌,其他细菌" />

  </appSettings>

  <ManageSystemConfig>
    <!-- 配置文件和缓存的默认前缀，例如：如果key的名称是web.admin.path ，那么在数据库和缓存中的完整名称就应该是：test.web.admin.path  ，防止一个服务器上多个相同网站导致redis的key重复等问题 -->
    <ConfigKeyPrefix Prefix="test." />
    <WebFarms MultipleInstancesEnabled="False" RunOnAzureWebsites="False" />
    <RedisCaching Enabled="true" KeyPrefix="huiruimedical." ConnectionString="127.0.0.1:6379,127.0.0.1:6379,allowAdmin=true,password=8888" />
    <UserAgentStrings databasePath="~/App_Data/uas_20140809-02.ini" />
    <SupportPreviousNopcommerceVersions Enabled="True" />
    <Installation DisableSampleDataDuringInstallation="False" UseFastInstallationService="False" PluginsIgnoredDuringInstallation="" />
  </ManageSystemConfig>

  <system.web>
    <!-- 使用Redis 代替Session服务器，Redis数据库1存储所有Session信息。-->
    <!--<sessionState mode="Custom" customProvider="SpringSessionStateStore">
      <providers>
        <add name="SpringSessionStateStore" type="Microsoft.Web.Redis.RedisSessionStateProvider" host="47.100.30.86" port="6379" databaseId="1" accessKey="Yiketing!@#****8888" ssl="false" />
      </providers>
    </sessionState>-->
    <compilation debug="true" targetFramework="4.5.2" />

    <authentication mode="Forms">
      <forms name="NOPCOMMERCE.AUTH" loginUrl="~/login" protection="All" timeout="43200" path="/" requireSSL="false" slidingExpiration="true" />
    </authentication>
    <pages>
      <namespaces>
        <add namespace="System.Web.Helpers" />
        <add namespace="System.Web.Mvc" />
        <add namespace="System.Web.Mvc.Ajax" />
        <add namespace="System.Web.Mvc.Html" />
        <add namespace="System.Web.Optimization" />
        <add namespace="System.Web.Routing" />
        <add namespace="System.Web.WebPages" />
        <add namespace="ManageSystem.Web.Extensions" />
        <add namespace="ManageSystem.Web.Models" />
      </namespaces>
    </pages>

    <httpRuntime targetFramework="4.5.2" maxRequestLength="2147483647" executionTimeout="6000" />
  </system.web>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-5.2.3.0" newVersion="5.2.3.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Autofac" publicKeyToken="17863af14b0044da" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.5.0.0" newVersion="3.5.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="WebGrease" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-1.5.2.14234" newVersion="1.5.2.14234" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="EntityFramework" publicKeyToken="b77a5c561934e089" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="StructureMap" publicKeyToken="e60ad81abae3c223" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.6.1.0" newVersion="2.6.1.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-9.0.0.0" newVersion="9.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="EPPlus" publicKeyToken="ea159fdaa78159a1" culture="neutral" />
