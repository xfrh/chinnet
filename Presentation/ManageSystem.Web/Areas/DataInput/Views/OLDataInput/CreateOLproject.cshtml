
@{
    ViewBag.Title = ViewBag.title;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Areas/DataInput/Content/css/OLDataInput.css" rel="stylesheet" />
<link href="~/Areas/DataInput/Content/AdminLTE/plugins/datetimepicker/css/bootstrap-datetimepicker.css" rel="stylesheet" />
<div class="W">

    <div class="my_title" id="title">
        当前位置： 首页 / 折点数据上传 / 项目添加
    </div>
    <div class="ol_table">

        @{
            if (ViewBag.Median == true)
            {
                <div class="ol_left">
                    <ul>
                        <li style="background-color:#dceef6"><a href="/DataInput/OLDataInput/OLproject">项目管理</a></li>
                        <li><a href="/DataInput/OLDataInput/OLtemplate">字段模板</a></li>
                        <li><a href="/DataInput/OLDataInput/ProjectStatistics">项目统计</a></li>
                    </ul>
                </div>
            }
        }
        <!-- 添加项目 开始 -->
        <div class="ol_right">
            <div style="margin-bottom: 20px;">项目名称: <input class="add_project_inp" style="margin-left: 10px;" type="text" placeholder="请输入内容" id="project_name"></div>
            <div style="margin-bottom: 20px;">
                开始时间:  <input class="add_project_inp" style="margin-left: 10px;" id="StartTime" name="StartTime" type="text" placeholder="开始时间" value="" ref="EndTime" />
            </div>
            <div style="margin-bottom: 20px;">
                结束时间: <input class="add_project_inp" style="margin-left: 10px;" id="EndTime" name="EndTime" type="text" placeholder="结束时间" value="" ref="EndTime" />
            </div>

            <div style="margin-bottom: 20px;">
                项目状态:
                <div class="add_project_rad">
                    <label style="font-weight:normal; margin-left:10px;">
                        <input id="radio1" name="state" type="radio" value="true" /> <span>立即开启</span>
                    </label>
                    <label style="font-weight:normal;  margin-left:10px;">
                        <input id="radio2" name="state" type="radio" value="false" /> <span>稍后开启</span>
                    </label>
                </div>
                <div style="margin-bottom: 20px;">
                    字段模板:
                    <!-- <input class="add_project_inp" type="text"> -->
                    @if (ViewBag.late)
                    {
                        <select class="add_project_inp" disabled id="temp" style="margin-left: 10px;">
                            <option value="">--请选择--</option>
                        </select>
                    }
                    else
                    {
                        <select class="add_project_inp" id="temp" style="margin-left: 10px;">
                            <option value="">--请选择--</option>
                        </select>
                    }

                </div>
                <div>
                    <input type="button" class="cbtn add_project_btn" onclick="createandupdate()" value="提交">
                </div>
            </div>


        </div>
        <!-- 添加项目 结束 -->
        <input id="Median" type="hidden" value="@ViewBag.Median.ToString()" />
    </div>

</div>
<script src="~/Areas/DataInput/Content/js/jquery.min.js"></script>
<script src="/Areas/DataInput/Content/AdminLTE/plugins/datetimepicker/js/bootstrap-datetimepicker.min.js"></script>
<script src="/Areas/DataInput/Content/AdminLTE/plugins/datetimepicker/js/locales/bootstrap-datetimepicker.zh-CN.js"></script>
<script>
    $(function () { 
        $("#StartTime").datetimepicker(
            {
                language: 'zh-CN', //语言
                minView: "month",  //最精确的时间选择视图。
                format: 'yyyy-mm-dd',  //日期格式
                todayHighlight: true, //高亮当前日期
                autoclose: true, //当选择一个日期之后是否立即关闭此日期时间选择器
                todayBtn: true,//显示今日按钮
                autoclose: 1//选择后自动关闭
            });
        $("#EndTime").datetimepicker(
            {
                language: 'zh-CN', //语言
                minView: "month",  //最精确的时间选择视图。
                format: 'yyyy-mm-dd',  //日期格式
                todayHighlight: true, //高亮当前日期
                autoclose: true, //当选择一个日期之后是否立即关闭此日期时间选择器
                todayBtn: true,//显示今日按钮
                autoclose: 1//选择后自动关闭
            });
        GetDistrictList();
        var Median = $("#Median").val();
        if (Median != "" && Median != null && Median != "True") {
            location.href = "/DataInput/OLDataInput/index";
            return;
        }
        var Id = getQueryString("Id");
        if (Id != null && Id > 0) {
            $("#title").html("当前位置： 首页 / 折点数据上传 / 项目修改")
            Fillingback();
        }
    })
    function GetDistrictList() {
        $.ajax({
            url: "/DataInput/OLDataInput/GettemplateList",
            type: "Post",
            dataType: "json",
            data: {},
            success: function (json) {
                if (json == null || json == "") {
                    return;
                }
                var content = " <option value=\"0\" >-- 请选择 --</option>";
                for (var i = 0; i < json.length; i++) {
                    content += " <option value=\"" + json[i].Id + "\" >" + json[i].template_name + "</option>";
                }
                $("#temp").html(content);

            }
        });
    }
    function getQueryString(name) {
        var reg = new RegExp("(^|&)" + name + "=([^&]*)(&|$)", "i");
        var r = window.location.search.substr(1).match(reg);
        if (r != null) return unescape(r[2]); return null;
    }
    function Fillingback() {
        var Id = getQueryString("Id");
        if (Id == null) {
            return false;
        }
        $.ajax({
            url: "/DataInput/OLDataInput/UPOLProjectsList",
            type: "Post",
            dataType: "json",
            data: { Id: Id },
            success: function (json) {
                for (var i = 0; i < json.length; i++) {
                    $("#project_name").val(json[i].project_name);
                    $("#StartTime").val(json[i].starttime);
                    $("#EndTime").val(json[i].endtime);
                    $("#temp").val(json[i].templateId);
                    if (json[i].state == "True") {
                        $("#radio2").removeAttr("checked");
                        $("#radio1").attr("checked", "true");
                    } else {
                        $("#radio1").removeAttr("checked");
                        $("#radio2").attr("checked", "true");

                    }
                }
            }
        });
    }

    function createandupdate() {
        var state = $("input[name='state']:checked").val();
        var project_name = $("#project_name").val();
        var today = $("#StartTime").val();
        var tomorrow = $("#EndTime").val();
        var temp = $("#temp").val();
        var Id = getQueryString("Id");
        if (Id != null) {

            $.ajax({
                url: "/DataInput/OLDataInput/UpdateOLproject",
                type: "Post",
                dataType: "json",
                data: { Id: Id, project_name: project_name, starttime: today, endtime: tomorrow, state: state, templateId: temp },
                success: function (json) {
                    if (json == null || json == "") {
                        return false;
                    }

                    if (json.status == "true") {
                        SuccessWindow("修改成功！", true);
                        location.href = "/DataInput/OLDataInput/OLproject";
                    }
                    else {
                        ErrorWindow(json.message, true);
                    }
                }
            });

        }
        else {
            $.ajax({
                url: "/DataInput/OLDataInput/AddOLproject",
                type: "Post",
                dataType: "json",
                data: { project_name: project_name, starttime: today, endtime: tomorrow, state: state, templateId: temp },
                success: function (json) {
                    if (json == null || json == "") {
                        return false;
                    }
                    if (json.status == "true") {
                        SuccessWindow("添加成功！", true);
                        location.href = "/DataInput/OLDataInput/OLproject";
                    }
                    else {
                        ErrorWindow(json.message, true);
                    }
                }
            });
        }
    }   
</script>
