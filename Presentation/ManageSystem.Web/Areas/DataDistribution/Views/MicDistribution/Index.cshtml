
<!DOCTYPE html>
<html lang="zh-CN">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>CHINET数据云</title>

    <!-- Bootstrap -->
    <link href="~/Areas/DataDistribution/Content/assets/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/Areas/DataDistribution/Content/assets/css/font-awesome.min.css" rel="stylesheet">
    <link href="~/Areas/DataDistribution/Content/assets/css/common.css" rel="stylesheet">

    <!-- HTML5 shim 和 Respond.js 是为了让 IE8 支持 HTML5 元素和媒体查询（media queries）功能 -->
    <!-- 警告：通过 file:// 协议（就是直接将 html 页面拖拽到浏览器中）访问页面时 Respond.js 不起作用 -->
    <!--[if lt IE 9]>
      <script src="assets/js/html5shiv.min.js"></script>
      <script src="assets/js/respond.min.js"></script>
    <![endif]-->
    <link rel="stylesheet" href="https://unpkg.com/element-ui@2.13.2/lib/theme-chalk/index.css">
    <link href="~/Areas/DataDistribution/Content/assets/css/index.css" rel="stylesheet">  
</head>

<body>
    <div id="app">
        <div class="container-fluid">
            <div class="row father" style="min-height:1100px;position:relative;">
                <!-- 左边的盒子开始 -->
                <!-- <div class="col-xs-left visible-xs navbar-toggle" data-toggle="collapse" data-target="#example-navbar-collapse"><a><span class="fa fa-list fa-lg"></span></a></div> -->
                <div class="col-md-3 col-xs-12" id="left_box" style="min-height:100%;background-color:#095d95;color:#fff;">
                    <div class="row">
                        <div class="col-md-12 col-xs-10">
                            <div class="logo" style="margin:30px 10px 0 0;">
                                <img src="/Areas/DataDistribution/Content/assets/logo-white.png" class="img-responsive"  style="cursor:pointer" onclick="href()">
                            </div>
                        </div>
                        <div class="col-xs-2 visible-xs" style="line-height:60px;" data-toggle="collapse" data-target="#example-navbar-collapse"><a style="color: #fff;"><span class="fa fa-list fa-lg"></span></a></div>

                    </div>

                    <div v-show="isdefault" id="example-navbar-collapse" class="collapse in">
                        <div class="row " style="margin-top:10px;">

                            <!-- <div class="col-md-12 col-xs-12">
                        <span href="#" style="background:none;">MIC数据查询（主动监测）</span>
                    </div> -->

                        </div>

                        <!-- 年度 -->
                        <div class="row " style="margin-top:20px;padding-bottom:5px;">
                            <div class="col-md-6 ">
                                <strong class="un_select">年度：</strong>
                            </div>

                            <div class="col-md-12 ">
                                <ul class="list-unstyled" v-cloak>

                                    <!-- <el-checkbox label="全选 " :indeterminate="isIndeterminate " v-model="checkAll " @@change="handleCheckAllChange "></el-checkbox><br/> -->

                                    <el-radio-group v-model="checkedYears" style="width:100%;">
                                        <el-radio :label="item" class="col-md-6 col-xs-6" style="margin: 0;margin-bottom:5px;padding: 0;" v-for="(item,index) in yearsbefore " :value="item.year_id" :key="index">{{item.year}}</el-radio>
                                    </el-radio-group>
                                </ul>
                            </div>
                        </div>

                        <!-- 抗菌药物 -->
                        <div class="row " style="margin-top:20px;padding-bottom:20px;">
                            <div class="col-md-6 ">
                                <strong class="un_select ">抗菌药物：</strong>
                            </div>

                            <div class="col-md-12">
                                <ul class="list-unstyled" v-cloak>
                                    <el-radio-group v-model="checkedPill" style="width:100%;">
                                        <el-radio :label="item" class="col-md-6 col-xs-6" style="margin:0px;margin-bottom:5px;padding: 0;" v-for="(item,index) in antibiotic_pillbefore " v-if="item.isdefault==true " :value="item.code" :key="index">{{item.value}}</el-radio>
                                    </el-radio-group>
                                </ul>
                            </div>
                            <div class="col-md-2 col-xs-3">
                                <a class="btn btn-primary bg-gray btn-sm p-t-0 p-b-0 " @@click="select(2) ">更多<span class="fa fa-chevron-right "></span></a>
                            </div>
                        </div>

                        <!-- 细菌 -->
                        <div class="row " style="margin-top:20px;padding-bottom:20px;">
                            <div class="col-md-6" style="margin-bottom:10px;">
                                <strong class="un_select">细菌：</strong>
                            </div>

                            <div class="col-md-12 ">
                                <ul class="list-unstyled" v-cloak>
                                    <el-checkbox-group v-model="checkedBacterium" handleCheckedBacteriumChange style="width:100%;">
                                        <el-checkbox :label="item " class="col-md-6 col-xs-6" style="margin:0;margin-bottom:5px;padding:0;float:none;" v-for="(item,index) in bacteriumbefore " v-if="item.isdefault==true " :key="index">{{item.value}}</el-checkbox>
                                    </el-checkbox-group>
                                </ul>
                            </div>

                            <div class="col-md-2 col-xs-3">
                                <a class="btn btn-primary bg-gray btn-sm p-t-0 p-b-0 " @@click="select(3) ">更多<span class="fa fa-chevron-right"></span></a>
                            </div>
                        </div>


                        <div class="row">
                            <div class="col-md-12" style="height:50px;">
                                <div style="display:inline-block;width:100%;height: 100%;" @@click="kickstart_inquire "><a style="width: 100%;height: 100%;display: inline-block;line-height:40px;" class=" btn btn-primary fa fa-search " ref="ser " @@click="kickstart_inquire "> 开始查询</a></div>
                            </div>
                            <br />

                        </div>
                        <!-- 加载中。。。 -->
                        <div class="loading col-xs-12 " v-show="show_loading_left ">
                            <div class="circular">

                            </div>
                        </div>
                    </div>


                    <!-- 选择抗菌药物 -->
                    <div v-show="show_antibiotic_pill " v-cloak>


                        <h3>抗菌药物</h3>
                        <hr />


                        <el-radio-group v-model="checkedPill ">
                            <el-radio :label="item" class="col-md-6 col-xs-6" style="margin:0;margin-bottom:5px;padding: 0;" v-for="(item,index) in antibiotic_pillbefore " :value="item.code " :key="index " style="display: block; ">{{item.value}}</el-radio>
                        </el-radio-group>
                        <br />
                        <br />
                        <a class="btn btn-primary bg-gray btn-sm pull-left p-t-0 p-b-0" @@click="toback(2)"><span class="fa fa-chevron-left "></span>确认并返回</a>
                    </div>

                    <!-- 选择细菌 -->

                    <div v-show="show_bacterium" v-cloak>


                        <h3>细菌</h3>
                        <hr />

                        <el-checkbox label="全选" :indeterminate="isIndeterminateBacterium " v-model="checkAll_bacterium " @@change="handleCheckAllChangeBacterium "></el-checkbox><br />
                        <div style="margin: 15px 0;"></div>
                        <el-checkbox-group v-model="checkedBacterium " handleCheckedBacteriumChange>
                            <el-checkbox :label="item" class="col-md-6 col-xs-6" style="margin:0;margin-bottom:5px;padding: 0;" v-for="(item,index) in bacteriumbefore " :key="index " style="display: block; ">{{item.value}}</el-checkbox>
                        </el-checkbox-group>
                        <br />
                        <br />
                        <a class="btn btn-primary bg-gray btn-sm pull-left p-t-0 p-b-0 " @@click="toback(3)"><span class="fa fa-chevron-left"></span>确认并返回</a>
                    </div>

                </div>
                <!-- 左边的盒子结束 -->
                <!--右边的盒子 开始-->
                <div v-show="search_data.length!=0 " id="right_box" class="col-md-9 col-xs-12" style="min-height:1100px;background-color:#08517f;color:#fff;">
                    <h1 class="showYears">
                        MIC分布（肉汤微量稀释法）
                        <a href="/" class="glyphicon glyphicon-home is_a_style">网站首页</a>
                    </h1>
                    <div class="row " style="margin-top:30px; ">
                        <div v-for="(item1,index1) in search_data" :key="index1 " class="col-md-12 mic_box ">
                            <div class="col-md-12">
                                <div class="row">

                                    <div class="col-md-12 col-xs-12">
                                        <span class="pull-right btn btn-default bg-gray fa fa-download " @@click="download_Excel(index1) "> 下载Excel数据</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12" style="margin-top:10px;">
                                <div class="table-responsive ">
                                    <table class="table table-bordered bg-white text-center " style="background-color:#fff;color:#333;" v-cloak>
                                        <thead>
                                            <tr>
                                                <th :colspan="colspan" style="text-align:left;font-size:24px;font-weight: 400;">{{table_title[0]}}对{{mic[index1]}}的MIC分布(mg/L)</th>
                                            </tr>
                                            <tr>
                                                <th v-show="index!=0" v-for="(item,index) in table_th_head[index1] " :key="index " v-cloak style="width:200px; ">{{item}}</th>
                                            </tr>
                                        </thead>
                                        <tbody>


                                            <tr>
                                                <td v-show="index!=0" v-for="(item,index) in table_tr_td_head[index1] " :key="index " v-cloak style="width:200px; ">{{item}}</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                            </div>

                            <div class="col-md-12 " style="margin-top:30px; " id="heat" v-cloak>
                                <div style="padding-left:7px;font-size:24px;font-weight:400;">{{table_title[0]}}对{{mic[index1]}}的MIC分布(n={{sums[index1]}})</div>
                                <div :id=main[index1] style="width: 100%;height:400px;background:#ffffff;padding:10px;"></div>
                            </div>
                        </div>
                        <!-- 数据描述 -->
                        <div class="col-md-12 " style="margin-top:30px;margin-left:15px;">
                            <div v-cloak>
                                菌株来源
                                <a class="cc btn btn-success btn-sm fa fa-chevron-up" id="desc_btn" @@click="desc_btn" style="transform:scale(0.5);" data-toggle="collapse" data-parent="#accordion" href="#sss"></a>
                            </div>
                            <div id="sss" class="panel-collapse collapse in">
                                <i class="small" v-for="(item,index) in describe" :key="index" v-cloak>
                                    <span style="display:inline-block;width: 250px;height:23px;margin-right:50px;font-style: normal; ">{{item.Title}}</span>
                                </i>
                            </div>
                        </div>

                    </div>



                    <!-- 加载中。。。 -->
                    <div class="loading " v-show="show_loading_right ">
                        <div class="circular ">

                        </div>
                    </div>
                </div>
                <!--右边的盒子 结束-->
                <!--右边新盒子 开始-->
                <div v-if="search_data.length==0 " class="col-md-9 col-xs-12 " style="min-height:1100px;background-color:#08517f;color:#fff;" v-cloak>
                    <a href="/" class="glyphicon glyphicon-home is_a_style" style="margin-top:20px;margin-right:40px;">网站首页</a>
                    <div class="is_tip" v-cloak>
                        <span class="label label-default"><i class="fa fa-angle-double-left " aria-hidden="true"></i></span> <span style="padding:.3em .6em .2em;">请从条件面板中选择{{is_tip}}。</span>
                    </div>
                    <div style="width: 100%;text-align: center;margin-top:300px;">
                        <img src="~/Areas/DataDistribution/Content/assets/bg.png" alt="">
                    </div>

                </div>
                <!--右边新盒子结束-->
            </div>
        </div>
    </div>

    <script src="~/Areas/DataDistribution/Content/assets/js/vue.js "></script>
    <script src="~/Areas/DataDistribution/Content/assets/js/jquery.min.js "></script>
    <script src="~/Areas/DataDistribution/Content/assets/js/bootstrap.min.js "></script>
    <script src="~/Areas/DataDistribution/Content/assets/plugins/echarts/echarts.min.js"></script>
    <script src="~/Areas/DataDistribution/Content/assets/js/index.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/Areas/DataDistribution/Content/assets/js/element.js "></script>
    <script src="~/Areas/DataDistribution/Content/assets/js/axios.min.js "></script>
    <script>
        var _hmt = _hmt || [];
        (function () {
            var hm = document.createElement("script");
            hm.src = "https://hm.baidu.com/hm.js?f46355bacf57cd4b8057e8f332e57807";
            var s = document.getElementsByTagName("script")[0];
            s.parentNode.insertBefore(hm, s);
        })();
        function href()
        {
            location.href = "/";
        }
    </script>
</body>

</html>

