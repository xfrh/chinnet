
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>CHINET数据云</title>
    <link href="~/Areas/DataDistribution/Content/assets/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/Areas/DataDistribution/Content/assets/css/font-awesome.min.css" rel="stylesheet">
    <link href="~/Areas/DataDistribution/Content/assets/css/common.css" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/element-ui@2.13.2/lib/theme-chalk/index.css">
    <link href="~/Areas/DataDistribution/Content/assets/css/index.css" rel="stylesheet">
</head>
<body>
    <div id="app">
        <div class="container-fluid">
            <div class="row father" style="min-height:1100px;position:relative;">
                <!-- 左边的盒子开始 -->
                <!-- <div class="col-xs-left visible-xs navbar-toggle" data-toggle="collapse" data-target="#example-navbar-collapse"><a><span class="fa fa-list fa-lg"></span></a></div> -->
                <div class="col-md-3 col-xs-12" id="left_box" style=" background:url(/Areas/DataDistribution/Content/assets/bg.png) center center;min-height:100%;background-color:#333333;color:#fff; ">
                    <div class="row">
                        <div class="col-md-12 col-xs-10">
                            <div class="logo " style="text-align: center; ">
                                <img src="/Areas/DataDistribution/Content/assets/logo-white.png " style="padding:10px; " height="60">
                            </div>
                        </div>
                        <div class="col-xs-2 visible-xs" style="line-height:60px;" data-toggle="collapse" data-target="#example-navbar-collapse"><a style="color: #fff;"><span class="fa fa-list fa-lg"></span></a></div>

                    </div>

                    <div v-show="isdefault" id="example-navbar-collapse" class="collapse in">
                        <div class="row " style="margin-top:20px;">

                            <div class="col-md-12 col-xs-12">
                                <a href="# " class="btn btn-info btn-block bg-primary " style="background:none; ">MIC数据查询（主动监测）</a>
                            </div>

                        </div>
                        <div class="row " style="margin-top:30px;padding-bottom:20px; ">
                            <div class="col-md-6 ">
                                <strong class="un_select ">年度：</strong>
                            </div>
                            <div class="col-md-6 ">
                                <!-- <a class="btn btn-primary bg-gray btn-sm pull-right p-t-0 p-b-0 " @@click="select(1) ">选择<span class="fa fa-chevron-right "></span></a> -->
                                <br>
                            </div>
                            <div class="col-md-12 ">
                                <ul class="list-unstyled " v-cloak>
                                    <!-- <li v-show="checkedYears[index]!=null " v-for="(item,index) in checkedYears " class="un_select "><a class="label label-danger " title="移除 " @@click="remove_years(index) "><span  class="fa fa-remove " ></span></a> {{checkedYears[index].year}}</li>
                                    <li v-show="checkedYears.length==0 " class="un_select ">无</li> -->
                                    <el-checkbox label="全选 " :indeterminate="isIndeterminate " v-model="checkAll " @@change="handleCheckAllChange "></el-checkbox>
                                    <br />
                                    <div style="margin: 15px 0; "></div>
                                    <el-checkbox-group v-model="checkedYears " @@change="handleCheckedYearsChange ">
                                        <el-checkbox :label="item " v-for="(item,index) in yearsbefore " :key="index ">{{item.year}}</el-checkbox>
                                    </el-checkbox-group>
                                </ul>
                            </div>
                        </div>

                        <div class="row " style="margin-top:20px;padding-bottom:20px; ">
                            <div class="col-md-6 ">
                                <strong class="un_select ">抗菌药物：</strong>
                            </div>

                            <div class="col-md-12 ">
                                <ul class="list-unstyled " v-cloak>
                                    <!-- <li v-show="checkedPill!='' " class="un_select "><a class="label label-danger " title="移除 " @@click="remove_antibiotic_pill() "><span  class="fa fa-remove "></span></a> {{checkedPill.value}}</li>
                                    <li v-show="checkedPill=='' " class="un_select ">无</li> -->
                                    <el-radio-group v-model="checkedPill ">
                                        <el-radio :label="item " v-for="(item,index) in antibiotic_pillbefore " v-if="item.isdefault==true " :value="item.code " :key="index " style="display: block; ">{{item.value}}</el-radio>
                                    </el-radio-group>
                                </ul>
                            </div>
                            <div class="col-md-2 col-xs-3 ">
                                <a class="btn btn-primary bg-gray btn-sm pull-right p-t-0 p-b-0 " @@click="select(2) ">更多<span class="fa fa-chevron-right "></span></a>
                            </div>
                        </div>

                        <div class="row " style="margin-top:20px;padding-bottom:20px; ">
                            <div class="col-md-6 ">
                                <strong class="un_select ">细菌：</strong>
                            </div>

                            <div class="col-md-12 ">
                                <ul class="list-unstyled " v-cloak>

                                    <el-checkbox-group v-model="checkedBacterium " handleCheckedBacteriumChange>

                                        <el-checkbox :label="item " v-for="(item,index) in bacteriumbefore " v-if="item.isdefault==true " :key="index " style="display: block; ">{{item.value}}</el-checkbox>

                                    </el-checkbox-group>
                                </ul>
                            </div>
                            <div class="col-md-2 col-xs-3 ">
                                <a class="btn btn-primary bg-gray btn-sm pull-right p-t-0 p-b-0 " @@click="select(3) ">更多<span class="fa fa-chevron-right "></span></a>
                            </div>
                        </div>

                        <div class="row " style="padding-bottom:20px; ">
                            <div class="col-md-12 text-center ">

                                <div style="display:inline-block; " @@click="kickstart_inquire "><a href="javascript:; " class=" btn btn-info btn-primary fa fa-search " ref="ser " @@click="kickstart_inquire "> 开始查询</a></div>
                            </div>
                        </div>
                        <!-- 加载中。。。 -->
                        <div class="loading col-xs-12 " v-show="show_loading_left ">
                            <div class="circular ">

                            </div>
                        </div>
                    </div>


                    <!-- 选择抗菌药物 -->
                    <div v-show="show_antibiotic_pill " v-cloak>
                        <a class="btn btn-primary bg-gray btn-sm pull-left p-t-0 p-b-0 " @@click="toback(2) "><span class="fa fa-chevron-left "></span>确认并返回</a></br>

                        <h3>抗菌药物</h3>
                        <hr />
                        <br />
                        <!-- <el-checkbox label="全选 " :indeterminate="isIndeterminatePill " v-model="checkAll_pill " @@change="handleCheckAllChangePill "></el-checkbox><br/>
                        <div style="margin: 15px 0; "></div> -->

                        <el-radio-group v-model="checkedPill ">
                            <el-radio :label="item " v-for="(item,index) in antibiotic_pillbefore " :value="item.code " :key="index " style="display: block; ">{{item.value}}</el-radio>
                        </el-radio-group>


                    </div>
                    <!-- 选择细菌 -->

                    <div v-show="show_bacterium " v-cloak>
                        <a class="btn btn-primary bg-gray btn-sm pull-left p-t-0 p-b-0 " @@click="toback(3) "><span class="fa fa-chevron-left "></span>确认并返回</a></br>

                        <h3>细菌</h3>
                        <hr />
                        <br />
                        <el-checkbox label="全选 " :indeterminate="isIndeterminateBacterium " v-model="checkAll_bacterium " @@change="handleCheckAllChangeBacterium "></el-checkbox><br />
                        <div style="margin: 15px 0; "></div>
                        <el-checkbox-group v-model="checkedBacterium " handleCheckedBacteriumChange>

                            <el-checkbox :label="item " v-for="(item,index) in bacteriumbefore " :key="index " style="display: block; ">{{item.value}}</el-checkbox>

                        </el-checkbox-group>
                        <!-- <div class="col-md-12 el_select_style ">
                            <el-select placeholder="请选择细菌 " multiple v-model="checkedBacterium ">
                                <el-option v-for="item in bacteriumbefore " :label="item.value " :value="item " :key="item.code ">{{item.value}}</el-option>
                            </el-select>
                        </div> -->


                    </div>

                </div>
                <!-- 左边的盒子结束 -->
                <!--右边的盒子 开始-->
                <div v-show="search_data.length!=0 " id="right_box" class="col-md-9 col-xs-12" style="background:url(/Areas/DataDistribution/Content/assets/bg.png) center center;min-height:1100px;background-color:#08517f;color:#fff;">
                    <h1 class="showYears ">MIC分布（肉汤微量稀释法）</h1>

                    <div class="row " style="margin-top:30px; ">
                        <div v-for="(item1,index1) in search_data " :key="index1 " class="col-md-12 mic_box ">
                            <div class="col-md-12 ">
                                <span class="pull-right btn btn-default bg-gray fa fa-download " @@click="download_Excel(index1) "> 下载Excel数据</span>
                            </div>
                            <div class="col-md-12 ">
                                <h4>
                                    <div v-show="mic[index1].length!=0 ">{{table_title[0]}}对{{mic[index1]}}的MIC分布</div>
                                    <div v-show="mic[index1].length==0 ">暂无数据</div>
                                </h4>
                                <div class="table-responsive ">
                                    <table class="table table-bordered bg-white text-center " style="background-color:#fff;color:#333; ">
                                        <thead>
                                            <tr>
                                                <th :colspan="colspan" style="text-align:center; ">{{mic[index1]}}MIC分布(mg/L)</th>
                                            </tr>
                                            <tr>
                                                <th v-for="(item,index) in table_th_head[index1] " :key="index " v-cloak style="width:200px; ">{{item}}</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td v-for="(item,index) in table_tr_td_head[index1] " :key="index " v-cloak style="width:200px; ">{{item}}</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                            </div>

                            <div class="col-md-12 " style="margin-top:30px; " id="heat ">
                                <h4>{{table_title[0]}}对{{mic[index1]}}的MIC分布</h4>
                                <div :id=main[index1] style="width: 100%;height:400px;background:#ffffff;padding:10px; "></div>
                            </div>
                        </div>
                        <!-- 数据描述 -->
                        <div class="col-md-12 " style="margin-top:30px;margin-left:15px; ">
                            <div>
                                菌株来源
                                <a class="cc btn btn-success btn-sm fa fa-chevron-up" id="desc_btn" @@click="desc_btn" style="transform:scale(0.5);" data-toggle="collapse" data-parent="#accordion" href="#sss"></a>
                            </div>
                            <div id="sss" class="panel-collapse collapse in">
                                <i class="small" v-for="(item,index) in describe " :key="index " v-cloak>
                                    <span style="display:inline-block;width: 250px;height:23px;margin-right:50px;font-style: normal; ">{{item}}</span>
                                </i>
                            </div>
                        </div>

                    </div>



                    <!-- 加载中。。。 -->
                    <div class="loading " v-show="show_loading_right ">
                        <div class="circular ">

                        </div>
                    </div>
                </div>
                <!--右边的盒子 结束-->
                <!--右边新盒子 开始-->
                <div v-if="search_data.length==0 " class="col-md-9 col-xs-12 " style="background:url(/Areas/DataDistribution/Content/assets/bg.png) center center;min-height:1000px;background-color:#08517f;color:#fff;" v-cloak>
                    <div class="is_tip" v-cloak>
                        请从条件面板中选择{{is_tip}}。
                    </div>
                </div>
                <!--右边新盒子结束-->
            </div>
        </div>
    </div>

    <script src="~/Areas/DataDistribution/Content/assets/js/vue.js "></script>
    <script src="~/Areas/DataDistribution/Content/assets/js/jquery.min.js "></script>
    <script src="~/Areas/DataDistribution/Content/assets/js/bootstrap.min.js "></script>
    <script src="~/Areas/DataDistribution/Content/assets/plugins/echarts/echarts.min.js"></script>
    <script src="~/Areas/DataDistribution/Content/assets/js/index.js "></script>
    <script src="~/Areas/DataDistribution/Content/assets/js/element.js "></script>
    <script src="~/Areas/DataDistribution/Content/assets/js/axios.min.js "></script>
</body>
</html>
