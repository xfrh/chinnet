    <script>
        function Open() {
            $('#myModal').modal('show');
        }
        function resetpwd() {
            $("#loginfrom").addClass('hidden')
            $("#emailpwd").addClass('hidden')
            $("#phonepwd").removeClass('hidden')
        }

        function resetpwd1() {
            $("#phonepwd").addClass('hidden')
            $("#emailpwd").removeClass('hidden')
        }

        function goLogin() {
            $("#regifrom").addClass('hidden')
            $("#phonepwd").addClass('hidden')
            $("#emailpwd").addClass('hidden')
            $("#loginfrom").removeClass('hidden')
        }

        function goRegister() {
            $("#loginfrom").addClass('hidden')
            $("#regifrom").removeClass('hidden')
        }
        $(function () {
            console.log(1)
            $("#menuDown").parent().mouseover(function () {
                $(this).addClass('open')
            }).mouseout(function () {
                $(this).removeClass('open');
            });

        })
    </script>
