            }
        /* 新的样式 */

        .aui-form-header {
            position: relative;
            z-index: 1;
            height: 35px;
            margin-bottom: 30px;
        }

            .aui-form-header .on:after {
                position: absolute;
                z-index: 2;
                top: 21px;
                left: 50%;
                margin-left: -3px;
                content: "";
                width: 0;
                height: 0;
                line-height: 0;
                border: 6px solid transparent;
                border-bottom-color: 2px solid #ed4242;
            }

            .aui-form-header .on:after {
                z-index: 3;
                top: -11px;
                width: 0;
                height: 0;
                line-height: 0;
            }

            .aui-form-header .aui-form-header-item {
                font-size: 16px;
                line-height: 24px;
                position: relative;
                float: left;
                width: 50%;
                height: 33px;
                cursor: pointer;
                text-align: center;
                color: #121212;
                border-bottom: 1px solid rgb(226, 224, 224);
            }

            .aui-form-header .on {
                margin-bottom: -1px;
                color: #ed4242;
                border-bottom: 2px solid #ed4242;
            }
    </style>
    <!-- 登录模态框 -->
    <div class="modal fade bs-example-modal-sm" id="myModal" style="top:20%" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="position: absolute;top: 0px;right: 10px;"><span aria-hidden="true">&times;</span></button>
                    <img src="/Content/Images/icon_03.jpg" alt="" width="60%" style="margin-left:20%">
                </div>
                <!-- 登录 -->
                <from id="loginfrom" class="">
                    <div class="modal-body Lo-mid">
                        <div class="flex f-center formh"><span class="glyphicon glyphicon-user"></span> <input placeholder="请输入手机号码/用户名" id="LoginId" type="text" name="mobile" class=" flex1 " aria-required="true" aria-invalid="false"></div>
                        <div class="flex f-center formh"><span class="glyphicon glyphicon-lock"></span> <input placeholder="请输入密码" type="password" id="Password" name="password" autocomplete="new-password" class=" flex1 " aria-required="true" aria-invalid="false"></div>
                        <div class="flex f-center formh" style=" position: relative;">
                            <span class="glyphicon glyphicon-ok"></span> <input type="text" id="ValidationCode" name="ValidationCode" placeholder="请输入验证码" autocomplete="off" class="flex1 " aria-required="true" aria-invalid="false">
                            <span style="display: inline-block; position: absolute; top: -1px; right: 1px; z-index: 999;">
                                @Html.MvcCaptcha(new MvcCaptchaOptions { ValidationInputBoxId = "Captcha", CaptchaImageContainerId = "captchaImage", ReloadLinkText = "" })
                            </span>

                        </div>
                        <div class="row Lo-mid" style="font-size: 12px; ">
                            <div class="fon-28 red f-end col-lg-5" style="cursor: pointer; float: left;" onclick="resetpwd()">*忘记密码 </div>
                            <div class="fon-28 f-end col-lg-7" style="float: right;"><a href="javascript:void(0);" style="color: blue;float: right;" onclick="goRegister()">去注册</a></div>
                        </div>
                    </div>
                    <div class="modal-footer" style="text-align: center;">
                        @Html.Hidden("HiddenReturnUrl", Request["returnUrl"])
                        <button type="button" class="btn btn-default" data-dismiss="modal">关闭</button>
                        <button type="button" class="btn btn-primary" onclick="AccountLogin()">登录</button>
                    </div>
                </from>

                <!-- 注册 -->
                <from class="hidden" id="regifrom">
                    <div class="modal-body Lo-mid ">
                        <div class="flex f-center formh"> <input placeholder="请输入姓名" type="text" name="mobile" class=" flex1 " aria-required="true" aria-invalid="false"></div>
                        <div class="flex f-center formh"> <input placeholder="请输入登录用户名" type="text" name="mobile" class=" flex1 " aria-required="true" aria-invalid="false"></div>
                        <div class="flex f-center formh"> <input placeholder="请输入手机号码" type="text" name="mobile" class=" flex1 " aria-required="true" aria-invalid="false"></div>
                        <div class="flex f-center formh"><input placeholder="请输入密码" type="password" name="password" autocomplete="new-password" class=" flex1 " aria-required="true" aria-invalid="false"></div>
                        <div class="flex f-center formh"><input placeholder="确认密码，和密码一样" type="password" name="password" autocomplete="new-password" class=" flex1 " aria-required="true" aria-invalid="false"></div>

                    </div>
                    <div class="modal-footer" style="text-align: center;">
                        <button type="button" class="btn btn-danger" style="border-color: #FC4349;background-color: #FC4349; padding:6px 20px">注册</button>
                        <button type="button" class="btn btn-primary" onclick="goLogin()">去登录</button>
                    </div>
                </from>

                <!-- 手机号码找回 -->
                <from class="hidden" id="phonepwd">
                    <div class="modal-body Lo-mid">
                        <div class="aui-form-header">
                            <div class="aui-form-header-item on">通过手机找回</div>
                            <div class="aui-form-header-item" onclick="resetpwd1()">通过邮箱找回</div>
                            <span class="aui-form-header-san"></span>
                        </div>
                        <div class="flex f-center formh"> <input placeholder="请输入手机号码" type="text" name="mobile" class=" flex1 " aria-required="true" aria-invalid="false"></div>
                        <div class="flex f-center formh" style=" position: relative;">
                            <input type="text" id="ValidationCode" name="ValidationCode" placeholder="请输入验证码" autocomplete="off" class="flex1 " aria-required="true" aria-invalid="false">
                            <span style="display: inline-block;color: red; position: absolute; top: -1px; right: 1px; z-index: 999;">获取验证码</span>
                        </div>
                        <div class="flex f-center formh"><input placeholder="请输入密码，长度大于5位" type="password" name="password" autocomplete="new-password" class=" flex1 " aria-required="true" aria-invalid="false"></div>
                        <div class="flex f-center formh"><input placeholder="确认密码，和密码一样" type="password" name="password" autocomplete="new-password" class=" flex1 " aria-required="true" aria-invalid="false"></div>

                    </div>
                    <div class="modal-footer" style="text-align: center;">
                        <button type="button" class="btn btn-danger" style="border-color: #FC4349;background-color: #FC4349; padding:6px 20px;margin-right: 30px;">提交</button>
                        <button type="button" class="btn btn-primary" onclick="goLogin()">去登录</button>
                    </div>
                </from>
                <!-- 邮箱找回 -->
                <from class="hidden" id="emailpwd">
                    <div class="modal-body Lo-mid">
                        <div class="aui-form-header">
                            <div class="aui-form-header-item" onclick="resetpwd()">通过手机找回</div>
                            <div class="aui-form-header-item on">通过邮箱找回</div>
                            <span class="aui-form-header-san"></span>
                        </div>
                        <div class="flex f-center formh"> <input placeholder="请输入邮箱" type="text" name="mobile" class=" flex1 " aria-required="true" aria-invalid="false"></div>
                        <div class="flex f-center formh" style=" position: relative;">
                            <input type="text" id="ValidationCode" name="ValidationCode" placeholder="请输入验证码" autocomplete="off" class="flex1 " aria-required="true" aria-invalid="false">
                            <span style="display: inline-block;color: red; position: absolute; top: -1px; right: 1px; z-index: 999;">获取验证码</span>
                        </div>
                        <div class="flex f-center formh"><input placeholder="请输入密码，长度大于5位" type="password" name="password" autocomplete="new-password" class=" flex1 " aria-required="true" aria-invalid="false"></div>
                        <div class="flex f-center formh"><input placeholder="确认密码，和密码一样" type="password" name="password" autocomplete="new-password" class=" flex1 " aria-required="true" aria-invalid="false"></div>

                    </div>
                    <div class="modal-footer" style="text-align: center;">
                        <button type="button" class="btn btn-danger" style="border-color: #FC4349;background-color: #FC4349; padding:6px 20px;margin-right: 30px;">提交</button>
                        <button type="button" class="btn btn-primary" onclick="goLogin()">去登录</button>
                    </div>
                </from>
            </div>
