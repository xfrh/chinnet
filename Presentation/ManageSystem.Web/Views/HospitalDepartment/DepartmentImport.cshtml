
@{
    ViewBag.Title = "科室导入";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="/Content/Scripts/bootstrap-fileinput-master/css/fileinput.css" rel="stylesheet" />
<link href="~/Content/Css/Medicine/Upload.css?v=1.8" rel="stylesheet" />
<div class="mbx" style="width:100%;">
    <p>当前位置：首页 &gt; 科室导入 </p>
</div>
<div class="container">
    <div class="alert alert-warning " style="margin: 20px 0px; width:100%; display:inline-block; padding-top: 20px; padding-bottom: 20px;">
        <ul class="warning-ul" style="width: 100%;float: left;">
            <li> <b style="font-size:18px;">提示：</b><span>请下载医院科室配置标准模板并填写完善对应医院的科室配置，如果已经存在的科室将被覆盖；请勿编辑标准模板中的表头部分。</span></li>
            <li> <span style="margin-left:50px;">上传提交过程等待时间可能稍长，请勿离开或刷新本页面。</span></li>
            <li> <span style="margin-left:50px;">批量导入将追加科室配置记录，请谨慎操作！</span></li>
        </ul>
    </div>

    <div class="title-2">
        <p><span style="color:#b94a48;">【所有显示项均为必填项】</span></p>
    </div>


    <div id="post_form">
        <form action="" id="form0" method="post" enctype="multipart/form-data">
            <ul class="post_main_ul">
                <input id="HospitalId" type="hidden" value="@ViewBag.HospitalId" />
                <input id="HospitalName" type="hidden" value="@ViewBag.HospitalName" />
                <input id="Department" type="hidden" value="@ViewBag.Department" />
                <li class="post_main_li">
                    <div class="post_main_l_tit"><span>医院名称：</span></div>
                    <div class="red_outK">
                        <div class="post_main_r" style="position:relative;" id="ss">
                            <input value="@ViewBag.HospitalName" id="hospital" readonly="readonly" placeholder="请输入医院名称" type="text" class="post_title post_title_Party" style="border:none;padding-top: 2px;" />
                        </div>
                    </div>
                </li>
                <li class="post_main_li">
                    <div class="post_main_l_tit"><span>选择数据文件：</span></div>
                    <div class="red_outK">
                        <div class="post_main_r" id="UploadFileBox" style="position:relative;padding-top:0px;">
                            <div class="file-input">
                                <div class="file-preview">
                                    <div class="close flieinput-remove"></div>
                                </div>
                                <div class="file-input file-input-ajax-new">
                                    <div class="input-group">
                                        <div tabindex="500" class="form-control kv-fileinput-caption">
                                            <div class="file-caption-name"></div>
                                        </div>
                                        <div class="input-group-btn">
                                            <div tabindex="500" class="btn btn-primary btn-file">
                                                <i class="glyphicon glyphicon-folder-open"></i>
                                                <span class="hidden-xs">选择文件</span>
                                                <input id="excelFile" name="excelFile" type="file" onchange="show()" multiple />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="post_main_note file-upload-message" style="width:100%;padding-top:10px; height:auto;font-size: 14px;" id="div1"></div>
                        </div>
                        <div style="float: left;margin-top: 10px;">
                            <a href="/Content/File/医院科室配置标准模板.xlsx" target="_blank" style="color: #428bca; margin-right:30px;font-size: 14px;">点击下载《医院科室配置标准模板》</a>
                        </div>
                    </div>
                </li>
                <li class="fb_Btn" style="margin-top:30px;">
                    <div class="btn-loading bg-danger" style="padding: 10px;display:none; ">
                        <div style="width:30px; height:30px; margin:0px auto; ">
                            <div style="width:30px; float:left; margin-right:10px;"><img src="~/Content/Images/loading.gif" style="width:30px; height:30px;" /></div>
                        </div>
                        <div class="bg-danger" style="line-height: 30px;padding: 10px;font-size: 14px;">
                            <p>数据上传成功，系统将自动按逐条规则开始审核并处理数据，结果将同时发送至填写的邮箱</p>
                            <p>现在您可以关闭浏览器，系统后台将对数据进行自动处理</p>
                        </div>
                    </div>
                    <input type="button" class="btn_Post btn-save" id="btnSubmit" onclick="onSubmit()" value="开始上传" style="cursor:pointer;  " />
                </li>
            </ul>
        </form>
    </div>
</div>
<script src="~/Content/Scripts/jquery.form.js"></script>
<script>
        $(function () {
        var HospitalName = $("#HospitalName").val();
        var Department = $("#Department").val();
        if (Department != 1)
        {
            SuccessWindows("<div style='text-align:center;'>您暂时没有对【" + HospitalName + "】进行科室配置的权限，请联系医院负责人或向我们进行<a style='color:red' href='/Center/Feedback'>反馈</a>，谢谢！", false, "/Medicine/Upload");
            return;
        }
    })
    function show() {
        var name = $("#excelFile").val();
        var res = name.split("\\")
        $("#div1").html(res[res.length - 1]);
    }
    function onSubmit() {
         formData = new FormData();
        var hospitalid = $("#HospitalId").val();
        var files = $('#excelFile')[0].files;
        var filess = $('#excelFile').val();
        console.log(filess);
        formData.append('id', hospitalid);
          formData.append('file', files[0]);
        if (!files || files.length <= 0) {
             ErrorWindow('请选择医院科室配置文件');
            return false;
        }
        $("#form0").ajaxSubmit({
            url: "/HospitalDepartment/OnSubmit_HospitalWardLocation",
            type: "post",
            dataType: "json",
            data: {id:hospitalid},           
            success: function (result) {
                if (result === null || result === "") {
                    ErrorWindow(result.message);
                    return;
                }
                if (result.status == true) {
                    SuccessWindow(result.message);
                }
                else {
                    ErrorWindow(result.message);
                }
            }
        })
        return false;
    };
</script>