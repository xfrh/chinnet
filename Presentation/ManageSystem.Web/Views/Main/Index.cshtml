    <script type="text/javascript">

        //打开报表效果
        function OpenMedicalStatistics(title,url)
        {
            layer.open({
                type: 2,
                title:title,
                area: ['85%', '85%'],
                fixed: true,
                maxmin: true,
                content: url
            });
        }

    </script>

