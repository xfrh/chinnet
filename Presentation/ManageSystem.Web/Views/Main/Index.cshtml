@{ 

    this.Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <!-- META SECTION -->
    <title>CHINET 在线</title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" href="favicon.ico" type="image/x-icon" />
    <!-- END META SECTION -->
    <!-- CSS INCLUDE -->
    <link rel="stylesheet" type="text/css" id="theme" href="~/Content/Scripts/Chinet/css/theme-default.css" />
    <link href="/Content/Scripts/layer-v2.4/skin/layer.css" rel="stylesheet" />
    <link href="/Content/Css/Custom.css?v=2" rel="stylesheet" />
