    <div class="title-2">
        <p>临床试验数据上传 <span style="color:#b94a48;">【所有显示项均为必填项】</span></p>
    </div>

    <div id="post_form">
        <ul class="post_main_ul">

            <li class="post_main_li">
                <div class="post_main_l_tit"><b class="red">*</b><span>所属医院：</span></div>
                <div class="red_outK">
                    <div class="post_main_r" style="position:relative;">
                        @Html.DropDownListFor(m => m.HospitalId, Model.HospitalList)
                    </div>
                </div>
            </li>
            <li class="post_main_li">
                <div class="post_main_l_tit"><b class="red">*</b><span>菌株编号：</span></div>
                <div class="red_outK">
                    <div class="post_main_r" style="position:relative;">
                        @Html.TextBoxFor(m => m.StrainNo, new { @class = "text" })
                    </div>
                </div>
            </li>
            <li class="post_main_li">
                <div class="post_main_l_tit"><b class="red">*</b><span>细菌名称：</span></div>
                <div class="red_outK">
                    <div class="post_main_r" style="position:relative;">
                        @Html.TextBoxFor(m => m.BacterialName, new { @class = "text" })
                    </div>
                </div>
            </li>
            <li class="post_main_li">
                <div class="post_main_l_tit"><b class="red">*</b><span>标本类型：</span></div>
                <div class="red_outK">
                    <div class="post_main_r" style="position:relative;">
                        @Html.TextBoxFor(m => m.SpecimenType, new { @class = "text" })
                    </div>
                </div>
            </li>
            <li class="post_main_li">
                <div class="post_main_l_tit"><b class="red">*</b><span>实验时间：</span></div>
                <div class="red_outK">
                    <div class="post_main_r" style="position:relative;">
                        @Html.TextBoxFor(m => m.ExperimentTime, new { @class = "text" })
                    </div>
                </div>
            </li>
            <li class="post_main_li">
                <div class="post_main_l_tit"><b class="red">*</b><span>药物名称：</span></div>
                <div class="red_outK">
                    <div class="post_main_r" style="position:relative;">
                        @Html.TextBoxFor(m => m.DrugName, new { @class = "text" })
                    </div>
                </div>
            </li>
            <li class="post_main_li">
                <div class="post_main_l_tit"><b class="red">*</b><span>Mic值：</span></div>
                <div class="red_outK">
                    <div class="post_main_r" style="position:relative;">
                        @Html.TextBoxFor(m => m.MicValue, new { @class = "text" })
                    </div>
                </div>
            </li>
            <li class="post_main_li">
                <div class="post_main_l_tit"><b class="red">*</b><span>阅读者：</span></div>
                <div class="red_outK">
                    <div class="post_main_r" style="position:relative;">
                        @Html.TextBoxFor(m => m.Reader, new { @class = "text" })
                    </div>
                </div>
            </li>
            <li class="post_main_li">
                <div class="post_main_l_tit"><b class="red">*</b><span>复核Mic值：</span></div>
                <div class="red_outK">
                    <div class="post_main_r" style="position:relative;">
                        @Html.TextBoxFor(m => m.ReviewMicValue, new { @class = "text" })
                    </div>
                </div>
            </li>
            <li class="post_main_li">
                <div class="post_main_l_tit"><b class="red">*</b><span>复核者：</span></div>
                <div class="red_outK">
                    <div class="post_main_r" style="position:relative;">
                        @Html.TextBoxFor(m => m.Reviewer, new { @class = "text" })
                    </div>
                </div>
            </li>
            @*<li class="post_main_li">
                <div class="post_main_l_tit"><b class="red">*</b><span>数据所属项目：</span></div>
                <div class="red_outK">
                    <div class="post_main_r" style="position:relative;">
                        @Html.DropDownListFor(m => m.ProjectType, Model.ProjectTypeList)
                    </div>
                </div>
            </li>*@
            <li class="post_main_li">
                <div class="post_main_l_tit"><b class="red">*</b><span>选择数据文件：</span></div>
                <div class="red_outK">
                    <div class="post_main_r" id="UploadFileBox" style="position:relative;padding-top:0px;">
                        <input id="FilePath" name="FilePath" type="file" multiple class="file-loading" accept=".dbf,.xlsx">
                        <input type="hidden" id="UploadFilePath" name="UploadFilePath" />
                        <input type="hidden" id="OldeFileName" name="OldeFileName" />
                        <input type="hidden" id="OldeFileSize" name="OldeFileSize" />
                        <div class="post_main_note file-upload-message" style="width:100%;padding-top:10px; height:auto;font-size: 14px;"></div>
                    </div>
                    <div style="float: left;margin-top: 10px;">
                        <a href="/Content/File/medicine-template.xlsx" target="_blank" style="color: #428bca; margin-right:30px;font-size: 14px;">点击下载《标准模版文件》</a>
                    </div>
                </div>
            </li>
            <li class="fb_Btn" style="margin-top:30px;">
                <div class="btn-loading bg-danger" style="padding: 10px;display:none; ">
                    <div style="width:30px; height:30px; margin:0px auto; ">
                        <div style="width:30px; float:left; margin-right:10px;"><img src="~/Content/Images/loading.gif" style="width:30px; height:30px;" /></div>
                    </div>
                    <div class="bg-danger" style="line-height: 30px;padding: 10px;font-size: 14px;">
                        <p>数据上传成功，系统将自动按逐条规则开始审核并处理数据，结果将同时发送至填写的邮箱</p>
                        <p>现在您可以关闭浏览器，系统后台将对数据进行自动处理</p>
                    </div>
                </div>
                <button id="btnBEPost" type="button" onclick="Save(); return false;" class="btn_Post btn-save ladda-button" data-style="zoom-in" style="border: none;">开始上传</button>
            </li>
        </ul>


    </div>

    <input type="hidden" id="UploadMedicineId" data-remark="上传成功以后的数据Id" />

    <script src="/Content/Scripts/bootstrap-fileinput-master/js/fileinput.min.js"></script>
    <script src="/Content/Scripts/bootstrap-fileinput-master/js/fileinput_locale_zh.js"></script>
    <script src="~/Content/Scripts/ladda/spin.min.js"></script>
    <script src="~/Content/Scripts/ladda/ladda.min.js"></script>
    <script src="/Content/Scripts/Medicine/Upload.js?v=@DateTime.Now.Ticks"></script>

    <script src="https://cdn.bootcss.com/jqueryui/1.12.1/jquery-ui.js"></script>
    <link href="https://cdn.bootcss.com/jqueryui/1.12.1/jquery-ui.css" rel="stylesheet">
    <script src="~/Content/Scripts/Autocomplete/jquery.autocomplete.min.js"></script>

</div>

