@{
    Layout = null;
    ViewBag.Title = "首页";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="format-detection" content="email=no" />
    <link rel="shortcut icon" href="/favicon.ico?v=12" />

    <script src="~/Content/Scripts/jquery-1.9.1.min.js"></script>

    <title>首页</title>

    <style>
        @@font-face {
            font-family: '时尚中黑简体';
            src: url('/Content/Fonts/时尚中黑简体.ttf') format('truetype');
        }


        * {
            padding: 0;
            margin: 0;
            border: 0;
            -webkit-box-sizing: border-box;
            -moz-box-sizing: border-box;
            box-sizing: border-box;
        }

        /* 请浮动 */
        .clearfix:after {
            content: "";
            display: block;
            clear: both;
        }

        html,
        body {
            height: 100%;
            width: 100%;
            background-color: #fff;
            min-width: 850px;
            min-height: 650px;
        }

        .outer {
            height: 100%;
            position: relative;
            background: url(/Content/Images/new_bg.jpg) no-repeat;
            background-size: 100% 100%;
        }

        .h-header {
            height: 120px;
            display: -webkit-box;
            display: -ms-flexbox;
            display: -moz-box;
            display: flex;
            -webkit-box-align: center;
            -ms-flex-align: center;
            -moz-box-align: center;
            align-items: center;
            text-align: center;
            -webkit-box-pack: center;
            -ms-flex-pack: center;
            -moz-box-pack: center;
            justify-content: center;
            background-image: url('/Content/Images/new_header_01.png');
            background-repeat: no-repeat;
            background-size: cover;
        }

            .h-header img {
                width: auto;
                max-height: 100%;
            }

            .h-header span {
                color: #f6f9fc;
                letter-spacing: 0.5rem;
                font-weight: 500;
                font-size: 28px;
                /*font-family: '时尚中黑简体';*/
            }

            .h-header .flex {
                display: -webkit-box;
                display: -ms-flexbox;
                display: -moz-box;
                display: flex;
                -webkit-box-align: center;
                -ms-flex-align: center;
                -moz-box-align: center;
                align-items: center;
            }

        img.qrcode_com_chinets_m {
            max-height: 70%;
            margin-left: 8rem;
        }


        .home-page {
            height: 100%;
            display: -webkit-box;
            display: -moz-box;
            display: -ms-flexbox;
            display: flex;
            -webkit-box-orient: vertical;
            -webkit-box-direction: normal;
            -moz-box-orient: vertical;
            -moz-box-direction: normal;
            -ms-flex-direction: column;
            flex-direction: column;
        }

            .home-page .h-header {
            }

            .home-page .page-body {
                -webkit-box-flex: 1;
                -moz-box-flex: 1;
                -ms-flex: 1;
                flex: 1;
            }

            .home-page .page-footer {
                height: 100px;
                line-height: 60px;
            }

            .home-page .copyright {
                font-size: 14px;
                color: #969696;
                width: 100%;
                text-align: center;
                display: block;
            }

        .nav-container {
            display: -webkit-box;
            display: -moz-box;
            display: -ms-flexbox;
            display: flex;
            -webkit-box-align: center;
            -moz-box-align: center;
            -ms-flex-align: center;
            align-items: center;
            -webkit-box-pack: center;
            -moz-box-pack: center;
            -ms-flex-pack: center;
            justify-content: center;
            height: 100%;
        }

        .nav-list {
            width: 650px;
            display: -webkit-box;
            display: -moz-box;
            display: -ms-flexbox;
            display: flex;
            list-style: none;
            -webkit-box-orient: horizontal;
            -webkit-box-direction: normal;
            -moz-box-orient: horizontal;
            -moz-box-direction: normal;
            -ms-flex-flow: row wrap;
            flex-flow: row wrap;
            -webkit-box-sizing: border-box;
            -moz-box-sizing: border-box;
            box-sizing: border-box;
            background-image: url('/Content/Images/new_main_08.png');
            background-repeat: no-repeat;
            background-size: contain;
            background-position: 32px 0;
        }

            .nav-list .nav-item {
                width: 325px;
                height: 200px;
                -webkit-box-sizing: border-box;
                -moz-box-sizing: border-box;
                box-sizing: border-box;
                position: relative;
                top: 18px;
                left: 2px;
            }

            .nav-list .nav-link {
                display: block;
                width: 100%;
                height: 100%;
            }
    </style>
</head>

<body>

    <div class="outer clearfix">

        <div class="o-left" style="display: none;">
            <img class="l-on" src="../../Content/Images/new_left_01.jpg" alt="">
            <img class="l-title" src="../../Content/Images/new_de_04.png" alt="">
            <div class="l-m">@*细菌耐药监测数据共享平台*@</div>
        </div>

        <div class="home-page">
            <header class="h-header">
                <span class="clearfix flex"><img src="/Content/Images/new_de_04.png" alt="" />&emsp;&ensp;新监测&emsp;&ensp;新平台</span>
                <img class="qrcode_com_chinets_m" src="~/Content/Images/m.chinets.com.qrcode.png" />
            </header>

            <div class="page-body">
                <div class="nav-container">
                    <ul class="nav-list">
                        <li class="nav-item">
                            <a class="nav-link" href="/Data/AntibioticDrugFast"></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Shanghai"></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/DataDistribution" target="_blank"></a>
                            <a class="nav-link" href="/CR" target="_blank"></a>
                            <a class="nav-link" href="/Special"></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/CreProject" target="_blank"></a>
                        </li>
                    </ul>
                </div>
            </div>

            <footer class="page-footer text-center" style="line-height: normal;">
                <span class="copyright" style="line-height:170%;">版权申明：本监测网数据由成员单位共享，禁止他人未经授权使用本网数据用于文章发表，违者必究。<br>版权所有：复旦大学附属华山医院抗生素研究所 | CHINET 中国细菌耐药监测网</span>
                <a style="font-size: 0.8rem; color: #969696; text-decoration: none !important; display: block; text-align: center; margin-top: 0.35rem;" href="http://www.beian.miit.gov.cn/" target="_blank">沪ICP备11042064号</a>
                <span class="copyright"><img src="/Content/Images/gongan.png" style="height:12px;"><a target="_blank" style="font-size: 0.8rem; color: #969696;text-decoration: none !important;text-align: center;" href="http://www.beian.gov.cn/portal/registerSystemInfo?recordcode=31010602003688">沪公网安备 31010602003688号</a></span>
            </footer>
        </div>
    </div>
    <input type="hidden" id="returnUrl" value="@this.Request.QueryString["returnUrl"]" />
    <input type="hidden" id="isHaveLogin" value="@this.Request.QueryString["type"]" />
    <script src="~/Content/Scripts/layer-v2.4/layer_login.js"></script>
    <script src="~/Content/Scripts/mobile.js"></script>
    <script src="~/Content/Scripts/Home/Index.js"></script>
</body>

</html>