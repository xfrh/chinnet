                                    </li>
                                    <li>
                                        <a href="@Url.Action("BacteriaInSpecimen","MedicalStatistics")">细菌在标本中占比</a>
                                    </li>
                                    <li>
                                        <a href="@Url.Action("EscherichiaColiSensitivityDrug","MedicalStatistics")">E.coli耐药率</a>
                                    </li>
                                    <li>
                                        <a href="@Url.Action("MRSASensitivityDrug","MedicalStatistics")">MRSA耐药率</a>
                                    </li>
                                    <li>
                                        <a href="@Url.Action("MRCNSSensitivityDrug","MedicalStatistics")">MRCNS耐药率</a>
                                    </li>
                                    <li>
                                        <a href="@Url.Action("MSSASensitivityDrug","MedicalStatistics")">MSSA耐药率</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
