                <div class="dropdown-content">
                    <div class="row-fluid" style="width:400px;left:-130px;">
                        <div id="block-block-1" class="block block-block no-title">
                            <div class="block-inner clearfix" style="    padding: 10px;">
                                <ul id="country_list_dropdown  menu-usercenter" class="country_list_dropdown">
                                    <li>
                                        <a href="@Url.Action("Index","Center")">个人中心</a>
                                    </li>
                                    <li>
                                        <a href="@Url.Action("Invite","Center")">邀请会员</a>
                                    </li>
                                    <li>
                                        <a href="@Url.Action("MeetingCollection","Center")">我的收藏</a>
                                    </li>
                                    <li>
                                        <a href="@Url.Action("MeetingApply","Center")">我的报名</a>
                                    </li>
                                    <li>
                                        <a href="@Url.Action("MeetingList","Center")">我发布的活动</a>
                                    </li>
                                    <li>
                                        <a href="@Url.Action("Feedback","Center")"> 建议反馈 </a>
                                    </li>
                                    <li>
                                        <a href="@Url.Action("Upload","Medicine")">上传医学数据</a>
                                    </li>
                                    <li>
                                        <a href="@Url.Action("MedicineManage","Center")">医学数据管理</a>
                                    </li>
