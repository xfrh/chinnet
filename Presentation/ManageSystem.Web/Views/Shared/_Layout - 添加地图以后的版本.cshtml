                    <div class="row-fluid" style="width:100%;">
                        <div id="block-block-1" class="block block-block no-title">
                            <div class="block-inner clearfix" style="    padding: 10px;">
                                <ul id="country_list_dropdown  " class="country_list_dropdown menu-more">
                                    <li>
                                        <a href="/News">咨询中心</a>
                                    </li>
                                    <li>
                                        <a href="/Mall">积分兑换</a>
                                    </li>
                                    <li>
                                        <a href="Research">科研合作</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </li>
