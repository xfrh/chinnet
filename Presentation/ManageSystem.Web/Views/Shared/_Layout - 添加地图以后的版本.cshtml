    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="format-detection" content="email=no" />
    <title>@adminPageTitle</title>
    <link href="/Content/bootstrap-3.3.0/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/Content/Css/style.css?v=1.22" rel="stylesheet" />
    <link href="/Content/Css/keyan.css" rel="stylesheet" />
    <link href="/Content/Css/common.css" rel="stylesheet" />

    <link href="/Content/Css/swiper-3.3.1.min.css" rel="stylesheet" />
    <link href="/Content/Scripts/layer-v2.4/skin/layer.css" rel="stylesheet" />
    <link href="/Content/Scripts/layer-v2.4/laydate/skins/dahong/laydate.css" rel="stylesheet" />
    <link href="/Content/Css/pageer.css" rel="stylesheet" />

    <script src="/Content/Scripts/jquery-1.9.1.min.js"></script>
    <script src="/Content/Scripts/jquery.validate.min.js"></script>
    <script src="/Content/Scripts/jquery.validate.unobtrusive.min.js"></script>
    <script src="/Content/Scripts/layer-v2.4/layer.js"></script>
    <script src="/Content/Scripts/layer-v2.4/laydate/laydate.js"></script>
    <script src="/Content/Scripts/common-validate.js"></script>

    <link href="/Content/Css/Layout/base.css?V=1212222" rel="stylesheet" />
    <link href="/Content/Css/Layout/global.css?V=2222212" rel="stylesheet" />

    @RenderSection("HeadSection", required: false)

</head>
<body style="background-color:white;">

    <div class="header wid-1200">
        <div class="logo">
            <li class="l"><img src="/Content/Images/logo.jpg" /></li>
            <li class="r">
                @{ Html.RenderAction("_MenuMember", "PartialView");}
