                                <ul id="country_list_dropdown  menu-medicine" class="country_list_dropdown">
                                    <li>
                                        <a href="@Url.Action("Area","MedicalStatistics")">按省份统计</a>
                                    </li>
                                    <li>
                                        <a href="@Url.Action("Year","MedicalStatistics")">按年份统计</a>
                                    </li>
                                    <li>
