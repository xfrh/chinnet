@using ManageSystem.Services.Configuration
@{

    string adminPageTitle = "";
    if (!String.IsNullOrWhiteSpace(this.ViewBag.Title))
    {
         adminPageTitle = WebSettingService.WebSEO_Title + "/";
    }
        adminPageTitle += this.ViewBag.Title;
 }

   
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="format-detection" content="email=no" />
    <link rel="shortcut icon" href="/favicon.ico?v=12" />
    <meta name="keywords" content="@WebSettingService.WebSEO_Key">
    <meta name="description" content="@WebSettingService.WebSEO_Describe">
    <title>@adminPageTitle</title>
    <link href="~/Content/Css/assets/css/bootstrap-responsive.min.css" rel="stylesheet" />
    <link href="~/Content/Css/assets/introjs.css" rel="stylesheet" />
    <script src="~/Content/Css/assets/intro.js"></script>
    <link href="/Content/bootstrap-3.3.0/css/bootstrap.min.css?v=1.3" rel="stylesheet" />
    <link href="/Content/Css/style.css??v=1.3" rel="stylesheet" />
    <link href="/Content/Css/keyan.css?v=1.32" rel="stylesheet" />
    <link href="/Content/Css/common.css?v=1.3" rel="stylesheet" />

    <link href="/Content/Css/swiper-3.3.1.min.css?v=1.3" rel="stylesheet" />
    <link href="/Content/Scripts/layer-v2.4/skin/layer.css?v=1.3" rel="stylesheet" />
    <link href="/Content/Scripts/layer-v2.4/laydate/skins/dahong/laydate.css?v=1.3" rel="stylesheet" />
    <link href="/Content/Css/pageer.css?v=1.3" rel="stylesheet" />
    <script src="~/Content/Scripts/mobile.js"></script>
    <script src="/Content/Scripts/jquery-1.9.1.min.js"></script>
    <script src="/Content/Scripts/jquery.validate.min.js"></script>
    <script src="/Content/Scripts/jquery.validate.unobtrusive.min.js"></script>
    <script src="/Content/Scripts/layer-v2.4/layer.js"></script>
    <script src="/Content/Scripts/layer-v2.4/laydate/laydate.js"></script>
    <script src="/Content/Scripts/common-validate.js"></script>

    <link href="/Content/Css/Layout/base.css?v=1.3" rel="stylesheet" />
    <link href="/Content/Css/Layout/global.css?v=1.235" rel="stylesheet" />

    @RenderSection("HeadSection", required: false)
    <style>
        .clearfix:after {
            content: "";
            display: block;
            clear: both;
        }
    </style>
</head>
<body style="background-color:white;">

    <div class="header wid-1200" style="height:100px;">
        <div class="logo" style="margin-bottom: 10px;">
            <li class="l" onclick="location.href='/'">
                <img src="~/Content/Images/logo_2.png" style="width:70%;margin-left: 6px;    margin-left: -4px;  margin-top: 10px;" />
            </li>
            <li class="r">
                @{ Html.RenderAction("_MenuMember", "PartialView");}
            </li>
        </div>
        @{ Html.RenderAction("_LayoutMenu", "PartialView");}
    </div>
    <div class="content wid-1200" id="pageContent">
        <div>@Html.Partial("Notifications")  </div>
        <div style="min-height:400px;">@RenderBody()</div>
    </div>
    @RenderSection("FooteMenu", required: false)
    <div style="width:100%;display:inline-block;">
        <div class="wid-1200">
            <h2 class="index-bt sj" style="font-size:14px;"><i></i>数据来源<span style="margin-left:10px; color:#ccc;font-size:12px;">成员单位名称排名不分先后（按拼音排序）</span>  </h2>
        </div>
    </div>
    <div class="page-fooer-partner" style="height: 160px;">
        <ul data-step="6" data-intro="<p style='font-weight:bold;'>数据来源：</p>图表中显示数据来源的单位。" data-position='top' class="wid-1200 clearfix">

            @{
                var data = new List<string> {
                    "安徽医科大学附属第一医院",
                    "复旦大学附属华山医院",
                    "广州医学院附属第三医院",
                    "甘肃省人民医院",
                    "哈尔滨医科大学附属第一医院",
                    "河南省人民医院",
                    "华中科技大学附属同济医院",
                    "江西省人民医院",
                    "江西省儿童医院",
                    "吉林大学中日联谊医院",
                    "昆明医科大学附属第一医院",
                    "宁夏医科大学总医院",
                    "山东省立医院检验科",
                    "山西儿童医院检验科",
                    "四川大学华西医院",
                    "同济大学附属东方医院（南院）",
                    "卫生部北京医院",
                    "厦门大学附属第一医院",
                    "中南大学湘雅医院检验科",
                    "浙江大学医学院附属第一医院",
                    "浙江大学医学院附属邵逸夫医院"
                };
                data = data.OrderBy(r => r).ToList();
                foreach (var item in data)
                {
                    <li>@item</li>
                }
            }
        </ul>
    </div>
    <div class="footer" style="padding: 10px;">
        <ul class="wid-1200">
            <p class="center" style="font-size:12px;">电话：021-52888186 |  www.chinets.com  |   地址：上海市静安区乌鲁木齐中路12号</p>
            <p class="center" style="font-size:12px;">版权所有：复旦大学附属华山医院抗生素研究所  |   技术支持：上海冉威信息科技有限公司</p>
        </ul>
    </div>

    <script src="~/Content/Scripts/swiper-3.3.1.min.js"></script>
    <script src="~/Content/Scripts/common.js"></script>
    <script src="~/Content/Scripts/layer-v2.4/helper.js"></script>
    <script src="~/Content/bootstrap-3.3.0/js/bootstrap.min.js"></script>
    <script src="~/Content/Scripts/_Layout.js"></script>

    @RenderSection("FooterSection", required: false)

</body>
</html>
