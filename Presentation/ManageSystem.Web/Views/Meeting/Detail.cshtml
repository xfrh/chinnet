                        <span class="zanWk" ontouchstart="">
                            <img id="img_dt_like" src="/Content/Images/dt_xin_heart.png" alt="">
                            <img id="icon_zan_ok2" class="zanIcon" src="/Content/Images/dt_like6_red_200.png" alt="" style="display:none;">
                        </span>
                    </a>
                </div>
            </div>*@

            <!--报名列表 -->
            @*<a name="a_join_list"></a>
                <div class="dt_join_menu_bg" id="dt_join_menu_bg">
                    <div ontouchstart="" class="dt_join_top">
                        <p id="dt_join_count" class="dt_join_topL">
                            <span id="join_total">@Model.MeetingEntity.ApplyCount</span>人已完成报名
                        </p>
                    </div>

                    <ul style="" class="dt_list_main" id="apply_list_main"></ul>

                   <div class="dt_join_more" id="join_loading" style="display: block;">
                            <a class="moreBtn font03"><span>展开更多报名</span></a>
                        </div>
                </div>*@

            <!--评论-->
            @*<div class="dt_review" id="dt_review">
                <a name="dt_review_up" id="dt_review_up"></a>
                <div class="dt_review_top">
                    <p id="dt_review_count" class="dt_review_topL">快来发表你的评论</p>
                </div>
                <div class="dt_review_edit">
                    <div name="discuss_icon_0" class="dt_review_edit_l">
                        <p class="dt_review_edit_pic">
                            <a class="dt_review_edit_pic_A" onclick="_user._toLogin()" href="#">
                                @{
                                    if (Model.MemberEntity == null || Model.MemberEntity.Id <= 0)
                                    {
                                        <img class="dt_review_edit_pic_img" src="" alt="">
                                    }
                                    else
                                    {
                                        <img class="dt_review_edit_pic_img" src="@MemberExtensions.GetHeadImage(Model.MemberEntity.HeadImage)" alt="">
                                    }
                                }

                            </a>
                        </p>
                    </div>

                    <div class="dt_review_edit_c" style=" width: 500px;">
                        <p><textarea name="" cols="" rows="" id="dt_review_form_content" class="dt_review_form_content" placeholder="讨论：" style="width:410px"></textarea></p>
                    </div>

                    <div class="dt_review_edit_r submit-btn">
                        <input Comment="0" type='button' class='dt_review_post_A' onclick="AddComment()" value='发表讨论' />
                    </div>

                </div>
                <ul style="" class="dt_review_main" id="dt_review_main"></ul>
                <div class="dt_review_more" id="review_loading" style="display: block;  ">
                    <div class="loading-content">
                        <div style="width:auto; float:left;"><img src="~/Content/Images/loading2.gif" /></div>
                        <div style="width:80px; float:left;">正在加载...</div>
                    </div>
                </div>

                <div class="center_keyan_txt_pl">

                    <ul class="comment-ul" style="margin:20px 10px;"></ul>
                </div>
            </div>*@
        </div>

        @*@Html.Action("_RightSidebar", "Meeting")*@

    </div>
</div>

<input type="hidden" id="MeetingIndex" value="@Model.MeetingEntity.Id.ToString()" />



<!-- 报名弹窗 -->
<div class="tc_c2 apply-window" id="join_box" style="display: none; ">
    <div class="join_box_Xq_out">
        <div class="tc_c_close">
            <p>请填写报名信息</p>
        </div>
        <div class="tc_c_info">
            <div class="tc_c_info_con"><p class="join_detail">确认报名信息</p></div>
        </div>
        <div class="join_box_Xq">
            <ul id="ul_join_property" class="pop_massage">
                <li type="danH">
                    <div class="optionsName">姓名</div>
                    <div class="inpoutK">
                        <input value="@(Model.MemberEntity != null ? Model.MemberEntity.Name:"")" type="text" maxlength="40" class="font0 apply_name" id="input_pro_id_1">
                    </div>
                </li>
                <li type="danH">
                    <div class="optionsName">手机</div>
                    <div class="inpoutK">
                        <input value="@(Model.MemberEntity != null ? Model.MemberEntity.Phone:"")" type="text" maxlength="40" class="font0  apply_phone" id="input_pro_id_2">
                    </div>
                </li>

                <li type="danH">
                    <div class="optionsName">邮箱：</div>
                    <div class="inpoutK">
                        <input value="@(Model.MemberEntity != null ? Model.MemberEntity.Email:"")" type="text" maxlength="40" class="font0  apply_email" id="input_pro_id_47760">
                    </div>
                </li>
            </ul>
        </div>

        <div class="tc_c_btn2" id="xdBtn">
            <div class="join_Btn"><a id="a_submit" class="blueBtn font02" href="javascript:void(0);" onclick="SaveApplyMeeting()">立即报名</a></div>
        </div>

    </div>
</div>


<script src="~/Content/Scripts/Meeting/Detail.js?v=@DateTime.Now.Ticks"></script>