@using ManageSystem.Web.Models.Meetings
@using ManageSystem.Core.Domain.Members
@using ManageSystem.Core.Utility;
@using ManageSystem.Services.Members;
@using ManageSystem.Services.Meetings

@model MeetingDetailModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    this.ViewBag.Title = Model.MeetingEntity.Name;
}

<link href="~/Content/Css/Meeting.css?v=1.4" rel="stylesheet" />

<div class="mbx">
    <p>当前位置：首页 &gt; 信息动态 </p>
</div>
<div id="post_form" style="margin-top: 30px;">

    <div class="container">
        <div class="wrap-left" style="width: 100%;">
            <div class="left-top-content">
                @*<div class="left-image">
                        <img class="left-im" src="@(MeetingServiceExtensions.GetCoverImage(Model.MeetingEntity.CoverImage))" />
                    </div>*@
                <div class="left-content">
                    <div class="detail_time_attr_join">
                        <div class="detail_time_attr_join_gray">
                            <div class="detail_title">
                                <h2 class="detail_title_h1" id="dt_title">@Model.MeetingEntity.Name</h2>
                                <div class="yhName">
                                    @Model.MeetingEntity.Author&nbsp;&nbsp;&nbsp;@Model.MeetingEntity.InsertTime.ToString("yyyy-MM-dd HH:mm")
                                </div>
                            </div>
                            <div class="detail_Time" style="margin-top: 20px; display:none;">
                                <div class="detail_Time_t">
                                    <p>
                                        @Model.MeetingEntity.StartTime.ToString("MM-dd HH:mm") 至
                                        @Model.MeetingEntity.EndTime.ToString("MM-dd HH:mm")&nbsp;
                                    </p>
                                </div>
                                <div class="detail_Time_b" style="display:none;">
                                    <p></p>
                                </div>
                            </div>

                            <div class="detail_Attr" style=" display:none;">
                                <a href="#" class="dt_address_item" ontouchstart="">
                                    <div class="detail_Attr_K">
                                        <p class="addressP">@(Model.MeetingEntity.AreaFullName + " " + Model.MeetingEntity.Address)</p>
                                    </div>
                                </a>
                            </div>

                            <div class="detail_Joinnum" id="detail_Joinnum" style=" display:none;">
                                <div class="detail_Joinnum_t">
                                    <p>已有<span>@Model.MeetingEntity.ApplyCount</span>人报名</p>
                                </div>
                                <div class="detail_Joinnum_b" style=" display:none;">
                                    @{ if (Model.MeetingEntity.PersonMaxCount > 0)
                                        {
                                            <p>限<span>@Model.MeetingEntity.PersonMaxCount</span>人报名</p>
                                        }}
                                </div>
                            </div>

                            <div class="detail_party_xian" style=" display:none;"></div>
                            <div class="detail_join_ticket" style=" display:none;">
                                <div class="detail_join_ticket_con">
                                    <ul class="join clearfix">
                                        <li class="show">
                                            <div name="detail_t_join" class="detail_t_join">
                                                @{
                                                    if (Model.MeetingEntity.PersonMaxCount > 0 && Model.MeetingEntity.ApplyCount >= Model.MeetingEntity.PersonMaxCount)
                                                    {
                                                        <a href="javascript:#" ontouchstart="">名额已满</a>
                                                    }
                                                    else
                                                    {
                                                        if (Model.IsApply)
                                                        {
                                                            <a href="javascript:void(0)">已经报名</a>
                                                        }
                                                        else
                                                        {
                                                            <a href="javascript:OpenApplyWindow()">我要报名</a>
                                                        }
                                                    }
                                                }

                                            </div>
                                        </li>
                                    </ul>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>


            <!--时间、地址、报名数 end-->
            <!--活动详情-->
            <div class="dt_content_top" style="display:none;"></div>

            <div id="dt_content" class="dt_content">
                @Html.Raw(Model.MeetingEntity.Content)
            </div>

            <!--赞-->
            @*<div class="detail_zan">
                <div class="dt_zan">
                    <a class="gray" href="@Url.Action("Feedback","Center")" target="_blank">举报</a>
                </div>
                <div class="dt_like" id="dt_like" ontouchstart="">
                    <a id="a_mettingcollect_btn" href="javascript:@(Model.IsCollect?"CancelMettingCollect()":"SetMettingCollect()")">
