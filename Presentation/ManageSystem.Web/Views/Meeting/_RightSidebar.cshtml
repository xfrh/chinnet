@using ManageSystem.Web.Models.Meetings
@model List<MeetingModel>
@{ 
    this.Layout = null;

}
<div class="wrap-right" style="padding-top: 10px;float: right;width: 250px; margin:0px;">
    <div class="wrap-right-top" style="padding-top: 25px; border-style:none;">
        没有合适我的会议<br>
        <input type="button" value="免费发布" onclick="window.location.href='@Url.Action("Create","Meeting")'">
    </div>
    <div class="wrap-right-news">
        <div class="hot_week_top"><img src="/Content/Images/blueKuai.png">热门活动</div>

        <ul class="hot_week_ul">
            @{
                if (Model != null && Model.Any())
                {
                    for (int i = 0; i < Model.Count; i++)
                    {
                        <li>
                            <span><img src="/Content/Images/hot@(i+1).png"></span>
                            <a href="@Url.Action("Detail","Meeting",new {  id =Model[i].Id })" target="_blank">@Model[i].Name</a>
                            <div><b>@Model[i].ApplyCount</b> 报名</div>
                        </li>
                    }
                }
            }
        </ul>
    </div>
</div>