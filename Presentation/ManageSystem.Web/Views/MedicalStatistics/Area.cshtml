@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    this.ViewBag.Title = "医学数据统计 - 按省份统计";
}


@{
    var breadcrumb = this.Request.QueryString["breadcrumb"];
    if (string.IsNullOrWhiteSpace(breadcrumb) || !breadcrumb.Equals("hidden"))
    {
        <div class="mbx">
            <p>当前位置：首页 &gt; 医学数据统计 &gt; 按省份统计 </p>
        </div>
    }
    else
    {
        <div class="mbx" style="height:15px;">  </div>
    }
}

<div class="doct_center">

    <div id="main" style="width: 900px;height:700px; margin:0px auto; max-height:900px; max-width:900px;">

    </div>
</div>
<script src="~/Content/Scripts/Echarts/echarts.min.js"></script>
<script src="~/Content/Scripts/Echarts/bmap.js"></script>
<script src="~/Content/Scripts/Echarts/china.js"></script>
<script type="text/javascript">

    $(document).ready(function () {
        // 基于准备好的dom，初始化echarts实例
        var myChart = echarts.init(document.getElementById('main'));

        option = {
            title: {
                text: '省份菌株数量统计',
                subtext: '',
                left: 'center'
            },
            tooltip: {
                trigger: 'item'
            },
            legend: {
                orient: 'vertical',
                left: 'left',
                data: ['菌株数量']
            },
            visualMap: {
                min: 0,
                max: @this.ViewBag.PageMaxValue,
                left: 'left',
                top: 'bottom',
                text: ['高', '低'],           // 文本，默认为数值文本
                calculable: true
            },
            toolbox: {
                show: true,
                orient: 'vertical',
                left: 'right',
                top: 'center',
                feature: {
                    dataView: { readOnly: false },
                    restore: {},
                    saveAsImage: {}
                }
            },
            series: [
                {
                    name: '菌株数量',
                    type: 'map',
                    mapType: 'china',
                    roam: false,
                    label: {
                        normal: {
                            show: true
                        },
                        emphasis: {
                            show: true
                        }
                    },
                    data: [
                    @Html.Raw( this.ViewBag.PageValue)
                    ]
                }

            ]
        };


        // 使用刚指定的配置项和数据显示图表。
        myChart.setOption(option);
    });

</script>
