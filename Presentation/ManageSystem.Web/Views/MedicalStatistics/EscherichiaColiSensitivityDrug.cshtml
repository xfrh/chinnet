@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    this.ViewBag.Title = "医学数据统计 - 大肠埃希菌对抗耐药率";
}

@{
    var breadcrumb = this.Request.QueryString["breadcrumb"];
    if (string.IsNullOrWhiteSpace(breadcrumb) || !breadcrumb.Equals("hidden"))
    {
        <div class="mbx">
            <p>当前位置：首页 &gt; 医学数据统计 &gt; 大肠埃希菌对抗菌药物的耐药率 </p>
        </div>
    }
    else
    {
        <div class="mbx" style="height:15px;">  </div>
    }
}

        <div class="doct_center">
            <div style="width:100%;float:left;margin-top: -30px;">
                <div id="main" style="width: 90%;height:650px;  margin:0px auto;"></div>
            </div>
        </div>


<script src="~/Content/Scripts/Echarts/echarts.min.js"></script>
<script src="~/Content/Scripts/Echarts/bmap.js"></script>
<script src="~/Content/Scripts/Echarts/china.js"></script>


<script type="text/javascript">



    $(document).ready(function () {

            // 基于准备好的dom，初始化echarts实例
        var myChart = echarts.init(document.getElementById('main'));
            option = {
                color: ['#3398DB'],
                tooltip: {
                    trigger: 'item',
                    formatter: "{a} <br/>{b} : {c} ({d}%)"
                },
                grid: {
                    left: '3%',
                    right: '4%',
                    bottom: '15%',
                    containLabel: true
                },
                xAxis: [
                    {
                        type: 'category',
                        axisLabel: {
                            interval: 0,
                            rotate: 45,
                            margin: 10,
                            textStyle: {
                                fontSize: "14px"
                            }
                        },
                        data: ['替加环素', '亚胺培南', '厄他培南', '美洛培南', '阿米卡星', '哌拉西林/他唑巴坦', '呋喃妥因', '磷霉素', '头孢哌酮/舒巴坦', '头孢西丁', '头孢他啶', '头孢吡肟', '庆大霉素', '氨苄西林/舒巴坦', '环丙沙星', '复方磺胺甲恶唑', '头孢噻肟', '头孢呋辛', '哌拉西林', '氨苄西林'],
                        axisTick: {
                            alignWithLabel: true
                        }
                    }
                ],
                yAxis: [
                    {
                        type: 'value',
                        axisLabel: {
                            show: true,
                            interval: 'auto',
                            formatter: '{value} %'
                        },
                        show: true
                    }
                ],
                series: [
                    {
                        name: '数量',
                        type: 'bar',
                        barWidth: '60%',
                        data: [0.4, 1.3, 1.5, 1.8, 3, 4, 4, 5.2, 5.7, 12.7, 26.2, 27.2, 42.6, 42.9, 56, 56.4, 59.6, 60.1, 71.8, 85.3],
                        //以下为是否显示，显示位置和显示格式的设置了
                        itemStyle: {
                            normal: {
                                color: function(params) {
                                    var colorList = [
                                        '#C1232B', '#B5C334', '#FCCE10', '#E87C25', '#27727B',
                                        '#FE8463', '#9BCA63', '#FAD860', '#F3A43B', '#60C0DD',
                                        '#D7504B', '#C6E579', '#F4E001', '#F0805A', '#26C0C0',
                                         '#D75242', '#C6E579', '#F2E301', '#F1805A', '#24C1C1'
                                    ];
                                    return colorList[params.dataIndex];
                                },
                                //以下为是否显示，显示位置和显示格式的设置了
                                label: {
                                    show: true,
                                    position: 'top',
                                    // formatter: '{c}'
                                    formatter: '{c} %'
                                }
                            }
                        },
                    }
                ],
                textStyle:
                {
                    fontSize: 10
                }
            };
            // 使用刚指定的配置项和数据显示图表。
            myChart.setOption(option);
    });

</script>