@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    this.ViewBag.Title = "医学数据统计 - 按年份和季度统计";
}

@{
    var breadcrumb = this.Request.QueryString["breadcrumb"];
    if (string.IsNullOrWhiteSpace(breadcrumb) || !breadcrumb.Equals("hidden"))
    {
        <div class="mbx">
            <p>当前位置：首页 &gt; 医学数据统计 &gt; 按年份和季度统计</p>
        </div>
    }
    else
    {
        <div class="mbx" style="height:15px;">  </div>
    }
}

<div class="doct_center">

    <div style="padding: 10px 30px; z-index:9999; width:100%;float:left;   ">
        <select class="form-control" id="Year" style="width: 100px;float: left;    margin-right: 10px;">
            @{
                int year = DateTime.Now.Year;
                if (this.Request.QueryString["year"] != null && this.Request.QueryString["year"] != "" && this.Request.QueryString["year"].IsInt())
                {
                    year = int.Parse(this.Request.QueryString["year"]);
                }

                for (int i = DateTime.Now.Year; i >= DateTime.Now.Year - 3; i--)
                {
                    if (i == year)
                    {
                        <option value="@(i)" selected="selected"> @(i) 年</option>
                    }
                    else
                    {
                        <option value="@(i)"> @(i) 年</option>
                    }
                }
            }

        </select>
        <input type="button" onclick="Search()" value="搜索" class="btn btn-info" />
    </div>
    <div class="clearfix"></div>
    <div style="width:100%;float:left; z-index:0;overflow:hidden;">
        <div style="width:100%;float:left;margin-top: -100px; z-index:0;overflow:hidden;">
            <div id="main" style="width: 90%;height:650px;  margin:0px auto;"></div>
        </div>

    </div>

</div>
<script src="~/Content/Scripts/Echarts/echarts.min.js"></script>
<script type="text/javascript">

    $(document).ready(function () {

        // 基于准备好的dom，初始化echarts实例
        var myChart = echarts.init(document.getElementById('main'));
        option = {
            title: {
                text: '医学数据统计',
                subtext: '',
                x: 'center',
                show:false
            },
            tooltip: {
                trigger: 'item',
                formatter: "{a} <br/>{b} : {c} ({d}%)"
            },
            legend: {
                orient: 'vertical',
                left: 'left',
                right: 0,
                top: 180,
                data: @Html.Raw(this.ViewBag.PageText)
                },
            series: [
                {
                    name: '上传医学数据',
                    type: 'pie',
                    radius: '55%',
                    center: ['50%', '50%'],
                    data: [
                        @Html.Raw(this.ViewBag.PageValue)
                    ],
                    itemStyle: {
                        emphasis: {
                            shadowBlur: 10,
                            shadowOffsetX: 0,
                            shadowColor: 'rgba(0, 0, 0, 0.5)'
                        }
                    }
                }
            ]
        };

        // 使用刚指定的配置项和数据显示图表。
        myChart.setOption(option);
    });


    function Search()
    {
        location.href = "/MedicalStatistics/YearAndQuarter?year=" + $("#Year").val();
    }

</script>
