@using ManageSystem.Web.Models.Medicine
@model IndexModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    this.ViewBag.Title = "医学中心";
}

<link href="~/Content/Css/Medicine.css" rel="stylesheet" />

<div class="mbx">
    <p>当前位置：首页 &gt; 医学中心 </p>
</div>
<div class="doct_center">
    <div class="doct_center_r" style="border-left-style: none;">
        <div class="cy-wrap" style="border-bottom-style:none !important;">

            <div class="sl-v-list" style="height:auto;">
                <div class="sl-key" style="width:100px">地区：</div>
                <ul class="js-search-li" data-type="city" id="search-city-ul" style="height: 38px;">
                    <li>加载中....</li>
                </ul>
                <div class="sl-ext" style="width: auto;float: right;  margin-top: 6px;">
                    <a class="sl-e-more J_extMore sl-e-area" href="javascript:MoreArea();" style="visibility: visible;color: #025193 !important;">更多<i></i></a>
                    <input type="hidden" id="MoreAreaState" value="0" />
                </div>
            </div>

            <div class="sl-v-list" style="height:auto;">
                <div class="sl-key" style="width:100px">医院：</div>
                <ul class="js-search-li" data-type="hospital" id="search-hospital-ul" style="height: 38px;">
                    <li>加载中....</li>
                </ul>

                <div class="sl-ext" style="width: auto;float: right;  margin-top: 6px;">
                    <a class="sl-e-more J_extMore sl-e-hospital" href="javascript:MoreHospital();" style="visibility: visible;color: #025193 !important;">更多<i></i></a>
                    <input type="hidden" id="MoreHospitalState" value="0" />
                </div>
            </div>

            <div class="sl-v-list" style="height:auto;">
                <div class="sl-key" style="width:100px;">药敏实验方法：</div>
                <ul class="js-search-li" data-type="bacteria" id="search-bacteria-ul">
                    <li >加载中....</li>
                </ul>


            </div>

