<input type="hidden" id="SearchArea" value="@Model.SearchModel.Area" />
<input type="hidden" id="SearchHospital" value="@Model.SearchModel.Hospital" />
<input type="hidden" id="SearchSpecimen" value="@Model.SearchModel.Specimen" />
<input type="hidden" id="SearchBacteria" value="@Model.SearchModel.Bacteria" />
