        </div>
        <div class="tab">
            <table width="100%" border="0" cellspacing="1" cellpadding="0" class="table item-table  table-bordered ">
                <thead>
                    <tr class="info">
                        <td style="width:6%;">编号</td>
                        <td style="width:10%;">上传日期</td>
                        <td style="width:20%;">所属医院</td>
                        <td style="width:6%;">菌株数量</td>
                        <td style="width:10%;">地区</td>
                    </tr>
                </thead>
                <tbody id="validateDataTbody"></tbody>
            </table>
        </div>

        <div id="divIncomeIntegral" class="page-btn-main " style="text-align:center;"></div>
