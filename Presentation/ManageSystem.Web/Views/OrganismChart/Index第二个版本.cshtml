@model  ManageSystem.Web.Models.Organism.BacteriaModel
@{
    ViewBag.Title = "抗生素耐药性统计分析图";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/Css/OrganismChart/Index.css" rel="stylesheet" />
<link href="~/Content/Css/theme-default.css" rel="stylesheet" />

<link href="~/Content/Scripts/layui-v2.2.2/layui/css/layui.css" rel="stylesheet" />

<style type="text/css">
    .layui-table-cell {
    padding: 0px;
    }
</style>
<div class="page-container ">
    <div class="chart-head">
        <div class="chart-logo"><img src="/Content/Scripts/Chinet/img/logo.png" class="chart-nav-logo" /></div>
        <div class="chart-nav">
            <ul class="chart-nav-content">
                <li class="xn-icon-button pull-right last">
                    <a href="/Home/Login" style="display:block"> <img src="~/Content/Images/login-out-chart.png" /> </a>
                </li>
                <li class="light-blue pull-right">
                    <a data-toggle="dropdown" href="javascript:;" class="dropdown-toggle" style="padding: 5px;">
                        <img class="nav-user-photo" src="@this.ViewBag.Img" style="">
                        <span class="user-info" style="color: white;    font-size: 14px">欢迎光临, @this.ViewBag.Name</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
    <h2 style="padding-top: 20px;color: #0c91e3; padding-left: 30px; margin-bottom: 20px;">抗生素耐药性统计分析图 - @Model.OrganismName</h2>
    <div class="layui-row pageTable" style="padding-left: 20px !important;padding-right: 20px !important;">
        <div class="layui-col-xs12 layui-col-sm12 layui-col-md12 layui-col-lg12">
            <table class="layui-hide layui-table" id="test" lay-data="{id: 'Test'}"></table>
        </div>
    </div>
        <div class="page-content-wrap pageChart">
            <div class="row">
                <div class="tongji">
                    <li>
                        <span class="bt1" onclick="SwithTable()">Table</span>
                        <span class="bt2">Chart</span>
                    </li>
                    <li><div id="main" style="width: 80%;height:500px;"></div></li>
                </div>
                <div class="Title">
                    <span class="mic">Mic</span>
                    <ul class="" style="">
                        <li style="margin-left:0;    margin-right: 20px;">Epidemiological cut-off(ECOFF):<span id="spanEcoff" style="color:red; font-style:oblique;  padding: 0px 3px;"></span>mg/L</li>
                        <li style="margin-right: 20px;">WiIdtype(WT) organisms:&#8804;<span id="spanOrganisms" style="color:red; font-style:oblique; padding: 0px 3px;  "></span>mg/L</li>
                        <li style="margin-right:0;"><span id="spanObservations" style="color:red; font-style:oblique; padding: 0px 3px;"></span> observations(<span id="spanObservationsCount">0</span> data Sources)</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="page-content-wrap">

            <div class="row">
                <ul class="list" style="display:none;">
                    <div>
                        <span style="width:4px;height:10px;display:inline-block; background-color:#129be1"></span>
                        <h2 style="width:calc(100% - 7px);    width: calc(100% - 15px);display: inline-block; margin-left: 5px;">
                            抗生素药物<a>
                                <img src="~/Content/Images/icon201.jpg" />
                            </a>
                        </h2>
                    </div>
                    <li>抗菌药物</li>
                    <li>头孢芙辛</li>
                    <li>抗菌药物</li>
                    <li>头孢芙辛</li>
                    <li>抗菌药物</li>
                    <li>头孢芙辛</li>
                    <li>抗菌药物</li>
                    <li>头孢芙辛</li>
                    <li>抗菌药物</li>
                    <li>头孢芙辛</li>
                    <li>抗菌药物</li>
                    <li>头孢芙辛</li>
                    <li>抗菌药物</li>
                    <li>头孢芙辛</li>
                    <li>抗菌药物</li>
                    <li>头孢芙辛</li>
                    <li>抗菌药物</li>
                    <li>头孢芙辛</li>
                </ul>
                <ul class="list list-li" style="margin-top:30px;">
                    <div style="margin-bottom: 20px;">
                        <span style="width:4px;height:10px;display:inline-block; background-color:#129be1"></span>
                        <h2 style="width:calc(100% - 7px);    width: calc(100% - 15px);display: inline-block; margin-left: 5px;">
                            细菌分类<a>
                                <img src="~/Content/Images/icon201.jpg" />
                            </a>
                        </h2>
                    </div>
                    @foreach (var item in Model.MedicalOrganism)
                    {
                        <li style="margin-left: 10px;"><a href="@Url.Action("Index","OrganismChart",new { id = item.Value })">@item.Text</a></li>
                    }

                </ul>
            </div>
            <div class="row" style="background-color:#F0EFEF;">
                <ul class="laiyuan list-li" style="margin-bottom: 50px;">
                    <div style="margin-bottom: 20px;"> 
                        <span style="width:4px;height:10px;display:inline-block; background-color:#129be1"></span>
                        <h2 style="width:calc(100% - 7px);    width: calc(100% - 15px);display: inline-block; margin-left: 5px;">数据来源</h2>
                    </div>
                    <li style="margin-left: 10px;">CHINET中国细菌耐药性监测网</li>
                    <li>华山医院抗生素研究所</li>
                    <li>30家成员单位共同提供数据</li>
                </ul>
            </div>
        </div>

    </div>
<div class="row" style="background-color:#F0EFEF;">
    <ul class="foot" style="width: 100%;">
        版权所有&copy;chinets.com
    </ul>
