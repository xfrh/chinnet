@using ManageSystem.Web.Models.Researches;
@using Webdiyer.WebControls.Mvc;

@model ResearchModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    this.ViewBag.Title = "科研合作基本信息 ";
}

@section HeadSection{
    <link href="~/Content/Css/Center.css" rel="stylesheet" />
}

<style type="text/css">
    .user_center .center-table {
        width: 100%;
        border-style: none;
    }

        .user_center .center-table td {
            border-style: none;
            height: 30px;
            line-height: 30px;
            font-size: 14px;
            text-align: left;
            padding: 2px;
            box-sizing: border-box;
        }
</style>
<div class="mbx"><p>当前位置：首页 &gt; 我发布的活动  @(Model == null ? "" : " > " + Model.Name + "") </p></div>
<div class="user_center">
    @*<div>
     @Html.Action("_Menu", "Center")
    </div>*@
    <div class="user_center_r">

        <div class="user_center_r_a center-title">
            <h2>
                <span class="span-item span-item-action " onclick="location.href='/Center/ResearchDetail/@Model.Id.ToString()'">基本信息</span>
                <span class="span-item" onclick="location.href='/Center/ResearchDetailApplyList/@Model.Id.ToString()'">管理报名</span>
                <span class="span-item    " onclick="location.href='/Center/ResearchDetailCommentList/@Model.Id.ToString()'">管理评论</span>
            </h2>
        </div>

        <div class="user_center_r_b">
            @{
                if (Model == null || Model.Id <= 0)
                {
                    <p>活动不存在</p>
                }
                else
                {

                    <table class="center-table">
                        <tr>
                            <td style="width:15%;">科研海报：</td>
                            <td style="width:85%;">@Html.Raw(string.IsNullOrWhiteSpace(Model.CoverImage) ? "无" : "<a  target='_blank' href='" + Model.CoverImage + "'>查看图片</a>")</td>
                        </tr>
                        <tr>
                            <td>发布时间：</td>
                            <td>@Model.InsertTime.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                        <tr>
                            <td>科研主题：</td>
                            <td>@Model.Name</td>
                        </tr>
                        <tr>
                            <td>科研时间：</td>
                            <td>@Model.StartTime.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                        <tr>
                            <td>科研区域：</td>
                            <td>@Model.AreaFullName</td>
                        </tr>
                     
                        <tr>
                            <td>研究编码：</td>
                            <td>@Model.Code</td>
                        </tr>
                        <tr>
                            <td>参与要求：</td>
                            <td>@Model.Require</td>
                        </tr>
                        <tr>
                            <td>科研发起人：</td>
                            <td>@Model.Author</td>
                        </tr>
                        <tr>
                            <td>研究简介：</td>
                            <td>@Model.Remark</td>
                        </tr>
                        <tr>
                            <td>科研类型：</td>
                            <td>@Model.ResearchTypeName</td>
                        </tr>
                        <tr>
                            <td>被查看次数：</td>
                            <td>@(Model.ViewCount)</td>
                        </tr>
                        <tr>
                            <td>报名次数：</td>
                            <td>@(Model.ApplyCount)</td>
                        </tr>
                        <tr>
                            <td>收藏次数：</td>
                            <td>@(Model.CollectCount)</td>
                        </tr>
                        
                        <tr>
                            <td>会议详情：</td>
                            <td><a href="/Research/Detail/@Model.Id.ToString()" target="_blank">点击查看</a></td>
                        </tr>
                    </table>
                }
            }
        </div>
    </div>
</div>

