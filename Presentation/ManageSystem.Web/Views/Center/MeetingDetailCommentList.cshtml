@using ManageSystem.Web.Models.Meetings;
@using Webdiyer.WebControls.Mvc;

@model MeetingDetailCommentModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    this.ViewBag.Title = "信息动态评论信息 ";
}

@section HeadSection{
    <link href="~/Content/Css/Center.css" rel="stylesheet" />
}

<style type="text/css">
    .user_center .center-table {
        width: 100%;
        border-style: none;
    }

        .user_center .center-table td {
            border-style: none;
            height: 30px;
            line-height: 30px;
            font-size: 14px;
            text-align: left;
            padding: 2px;
            box-sizing: border-box;
        }

    #dt_review .comment-item .time span {
        float: right;
        line-height: 25px;
        width: auto;
    }

    #dt_review {
        border-style: none;
    }

        #dt_review .comment-item {
            margin-bottom: 10px;
        }
</style>
<div class="mbx"><p>当前位置：首页 &gt; 我发布的活动  @(Model.Meeting == null ? "" : " > " + Model.Meeting.Name + "") </p></div>
<div class="user_center">
    @*<div>
      @Html.Action("_Menu", "Center")
    </div>*@
    <div class="user_center_r">

        <div class="user_center_r_a center-title">
            <h2>
                <span class="span-item  " onclick="location.href='/Center/MeetingDetail/@Model.Meeting.Id.ToString()'">基本信息</span>
                <span class="span-item" onclick="location.href='/Center/MeetingDetailApplyList/@Model.Meeting.Id.ToString()'">管理报名</span>
                <span class="span-item  span-item-action  " onclick="location.href='/Center/MeetingDetailCommentList/@Model.Meeting.Id.ToString()'">管理评论</span>
            
            </h2>
        </div>

        <div class="user_center_r_b">
            <div class="dt_review" id="dt_review">
                <a name="dt_review_up" id="dt_review_up"></a>
                <div class="dt_review_top" style="display:none;">

                </div>
                <div class="dt_review_edit" style="display:none;">
                    <div name="discuss_icon_0" class="dt_review_edit_l">
                        <p class="dt_review_edit_pic">
                            <a class="dt_review_edit_pic_A" onclick="_user._toLogin()" href="#">
                                <img class="dt_review_edit_pic_img" src="/Content/Upload/Member/14530350512G50-5551b.jpg" alt="">
                            </a>
                        </p>
                    </div>

                    <div class="dt_review_edit_c">
                        <p><textarea name="" cols="" rows="" id="dt_review_form_content" class="dt_review_form_content" placeholder="讨论："></textarea></p>
                    </div>

                    <div class="dt_review_edit_r submit-btn" style="display: block;">
                        <input comment="0" type="button" class="dt_review_post_A" onclick="AddComment()" value="发表讨论">
                    </div>

                </div>
                <ul style="display:none;" class="dt_review_main" id="dt_review_main"></ul>
                <div class="dt_review_more" id="review_loading" style="display: block;">
                    <div class="loading-content">
                        <div style="width:auto; float:left;"><img src="/Content/Images/loading2.gif"></div>
                        <div style="width:80px; float:left;">正在加载...</div>
                    </div>
                </div>

                <div class="center_keyan_txt_pl">
                    <ul class="comment-ul" style="margin:20px 10px;  border-style:none; margin-top:0px;"></ul>
                </div>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="MeetingIndex" value="@Model.Meeting.Id.ToString()" />

<script src="~/Content/Scripts/Center/MeetingDetailCommentList.js"></script>