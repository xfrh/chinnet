@using ManageSystem.Web.Models.Researches;
@using Webdiyer.WebControls.Mvc;

@model ResearchDetailApplyModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    this.ViewBag.Title = "科研合作报名信息 ";
}

@section HeadSection{
    <link href="~/Content/Css/Center.css" rel="stylesheet" />
}

<style type="text/css">
    .user_center .center-table {
        width: 100%;
        border-style: none;
    }

        .user_center .center-table td {
            border-style: none;
            height: 30px;
            line-height: 30px;
            font-size: 14px;
            text-align: left;
            padding: 2px;
            box-sizing: border-box;
        }
</style>
<div class="mbx"><p>当前位置：首页 &gt; 我发布的活动  @(Model.Research == null ? "" : " > " + Model.Research.Name + "") </p></div>
<div class="user_center research-detail-apply-list">
    @*<div>
      @Html.Action("_Menu", "Center")
    </div>*@
    <div class="user_center_r">

        <div class="user_center_r_a center-title">
            <h2>
                <span class="span-item  " onclick="location.href='/Center/ResearchDetail/@Model.Research.Id.ToString()'">基本信息</span>
                <span class="span-item span-item-action " onclick="location.href='/Center/ResearchDetailApplyList/@Model.Research.Id.ToString()'">管理报名</span>
                <span class="span-item  " onclick="location.href='/Center/ResearchDetailCommentList/@Model.Research.Id.ToString()'">管理评论</span>
            </h2>
        </div>

        <div class="user_center_r_b">
            <div class="user_center_r_a">
                @using (Html.BeginForm("ResearchDetailApplyList", "Center", FormMethod.Get))
                {
                    @Html.DropDownListFor(model => model.Status, Model.StatusList, new { @class = "" })
                    @Html.TextBoxFor(m => m.SearchKey, new { @class = "some_class input-txt", placeholder = "姓名/邮箱/手机" })
                    <input type="submit" value="搜索" class="btn">
                }
            </div>
            <table border="0" cellpadding="0" cellspacing="0" width="100%">
                <thead>
                    <tr>
                        <th width="10%">报名人姓名</th>
                        <th width="15%">邮箱地址</th>
                        <th width="10%">手机号码</th>
                        <th width="10%">报名状态</th>
                        <th width="13%">报名时间</th>
                        <th width="10%">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        if (Model.ApplyPageList != null && Model.ApplyPageList.Any())
                        {
                            foreach (var item in Model.ApplyPageList)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td>@item.Email</td>
                                    <td>@item.Phone</td>
                                    <td>@item.StatusName</td>

                                    <td>@item.InsertTime.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>
                                        <a class='td-aclass' href="javascript:Detail('@item.Id.ToString()')" target='_blank'>查看</a>
                                    </td>
                                </tr>
                            }
                        }
                    }
            </table>
            <div id="page-box" class="page">
                @Html.Pager(Model.ApplyPageList, MvcPagerExtensions.GetPagerOptions())
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

    function Detail(id)
    {
        //iframe层-父子操作
        layer.open({
            type: 2,
            area: ['700px', '530px'],
            fix: false, //不固定
            maxmin: true,
            title:'报名申请详细信息',
            content: '/Center/ResearchDetailApplyDetail/' + id + ''
        });
    }

</script>