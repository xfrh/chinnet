@using ManageSystem.Web.Models.Meetings;
@using Webdiyer.WebControls.Mvc;
@using ManageSystem.Services.Articles;

@model PagedList<CenterMeetingApplyModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    this.ViewBag.Title = "信息动态报名 ";
}

@section HeadSection{
    <link href="~/Content/Css/Center.css" rel="stylesheet" />
}


<div class="mbx"><p>当前位置：首页 &gt; 我的报名 </p></div>
<div class="user_center">
    @*<div>
        @Html.Action("_Menu", "Center")
    </div>*@
    <div class="user_center_r" style="width: 100%;padding-right: 10px;padding-left: 10px;">

        <div class="user_center_r_a center-title">
            <h2>
                <span class="span-item  span-item-action" onclick="location.href='@Url.Action("MeetingApply", "Center")'">信息动态</span>
                <span class="span-item" onclick="location.href='@Url.Action("ResearchApply", "Center")'">科研合作</span>
            </h2>
        </div>

        <div class="user_center_r_b">
            <table border="0" cellpadding="0" cellspacing="0" width="100%">
                <thead>
                    <tr>
                        <th width="25%" style="text-align:center;">信息动态名称</th>
                        <th width="10%" style="text-align:center;">报名时间</th>
                        <th width="8%" style="text-align:center;">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.MeetingName</td>
                                    <td>@item.InsertTime.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>
                                        <a class='td-aclass' href='@Url.Action("Detail", "Meeting")/@item.MeetingId' target='_blank'>查看</a>&nbsp;
                                        <a class='td-aclass' href="javascript:Delete('@item.Id.ToString()') " target='_blank'>取消</a>
                                    </td>
                                </tr>
                            }
                        }
                    }
            </table>
            <div id="page-box" class="page">
                @Html.Pager(Model, MvcPagerExtensions.GetPagerOptions())
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

    function Delete(id) {
        $.ajax({
            async: false,
            type: "POST",
            url: "/Center/DelelteMeetingApply",
            data: {
                id: '' + id + '',
            },
            dataType: "json",
            success: function (json) {

                if (json == null || json == "")
                    return;

                if (json.status == "true") {
                    SuccessWindow("取消成功！", true);
                }
                else {
                    ErrorWindow(json.message, true);
                }
            }
        });
    }
</script>
