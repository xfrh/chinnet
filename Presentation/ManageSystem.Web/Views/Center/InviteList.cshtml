@using ManageSystem.Core.Domain.Members
@using Webdiyer.WebControls.Mvc
@using ManageSystem.Web.Models.Members

@model PagedList<CenterInviteListModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    this.ViewBag.Title = "邀请记录 ";
}

@section HeadSection{
    <link href="~/Content/Css/Center.css" rel="stylesheet" />
}


<div class="mbx"><p>当前位置：首页 &gt; 邀请会员 </p></div>
<div class="user_center integral-list-page">
    @*<div>
       @Html.Action("_Menu", "Center")
    </div>*@
    <div class="user_center_r">
        <div class="user_center_r_a center-title">
            <h2>
                <span class="span-item" onclick="location.href='@Url.Action("Invite", "Center")'">邀请好友</span>
                <span class="span-item  span-item-action " onclick="location.href='@Url.Action("InviteList", "Center")'">邀请记录</span>
            </h2>
        </div>


        <div class="user_center_r_b_new" style="margin-top:20px;">
            @{

                if (Model != null && Model.Any())
                {
                    <table class="table table-bordered order-item-title">
                        <tr style="background-color:#ededed; font-weight:bold;">
                            <td style="width:30%;">注册时间</td>
                            <td style="width:30%">会员帐号</td>
                            <td style="width:30%">会员姓名</td>
                        </tr>
                        @{

                            {
                                foreach (var node in Model)
                                {
                                    <tr class="order-item-tr">
                                        <td>@node.InsertTime.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>@node.MemberLoginId</td>
                                        <td >@node.MemberName</td>
                                    </tr>
                                }
                            }
                        }
                    </table>
                    <div id="page-box" class="page">
                        @Html.Pager(Model, MvcPagerExtensions.GetPagerOptions())
                    </div>
                            }
            }
        </div>
    </div>
</div>

<script type="text/javascript">

</script>
